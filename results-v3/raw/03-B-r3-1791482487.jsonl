{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018eDk4dWVatkKz34wCNjU3b","type":"tool_result","content":"import { Notification } from \"../domain/notification\";\nimport { messageKey } from \"./keys\";\nimport { MqpubClient, PublishResult, WireMessage } from \"./mqpubClient\";\nimport { encodePayload } from \"./payloadCodec\";\n\n/** 발송 회차 하나의 알림을 한 배치로 발행한다(회차 단위 순서·원자성). */\nexport class AlertPublisher {\n  constructor(\n    private readonly client: MqpubClient,\n    private readonly topic: string,\n    private readonly keyNamespace: string,\n  ) {}\n\n  toWire(n: Notification): WireMessage {\n    return { key: messageKey(this.keyNamespace, n.kind, n.orderNo), payload: encodePayload(n) };\n  }\n\n  publishRun(notifications: Notification[]): PublishResult {\n    return this.client.publish(this.topic, notifications.map((n) => this.toWire(n)));\n  }\n}\nimport { OrderEventKind } from \"../domain/order\";\n\nconst KIND_CODE: Record<OrderEventKind, string> = {\n  PAID: \"paid\",\n  SHIPPED: \"ship\",\n  DELIVERED: \"dlvd\",\n};\n\n/**\n * 알림 메시지 키 — 사내 키 규약 `<네임스페이스>.<이벤트>.<업무 식별자>`.\n * 소비 측은 이 키로 이미 처리한 메시지를 걸러낸다(재전달 대비).\n */\nexport function messageKey(namespace: string, kind: OrderEventKind, orderNo: string): string {\n  return `${namespace}.${KIND_CODE[kind]}.${orderNo}`;\n}\n\nexport function kindFromCode(code: string): OrderEventKind | undefined {\n  return (Object.keys(KIND_CODE) as OrderEventKind[]).find((k) => KIND_CODE[k] === code);\n}\nimport { spawnSync } from \"child_process\";\n\nexport interface WireMessage {\n  key: string;\n  payload: string;\n}\n\nexport interface PublishResult {\n  accepted: number;\n  batch: number;\n}\n\nexport interface ConsumedMessage {\n  offset: number;\n  key: string;\n  payload: string;\n}\n\nexport class MqpubError extends Error {\n  constructor(readonly code: string, readonly exitStatus: number | null) {\n    super(`mqpub ${code} (exit ${exitStatus})`);\n  }\n}\n\n/** 사내 메시지 발행 CLI(mqpub 3.x) 래퍼 */\nexport class MqpubClient {\n  constructor(private readonly bin: string, private readonly spoolDir: string) {}\n\n  private run(args: string[], input?: string): string {\n    const r = spawnSync(this.bin, args, {\n      input,\n      encoding: \"utf8\",\n      env: { ...process.env, MQPUB_SPOOL: this.spoolDir },\n    });\n    if (r.error) throw r.error;\n    if (r.status !== 0) {\n      const code = /E\\d+/.exec(r.stderr)?.[0] ?? \"E?\";\n      throw new MqpubError(code, r.status);\n    }\n    return r.stdout;\n  }\n\n  /** 메시지들을 한 배치로 발행한다. */\n  publish(topic: string, messages: WireMessage[]): PublishResult {\n    if (messages.length === 0) return { accepted: 0, batch: 0 };\n    const body = messages.map((m) => `${m.key}\\t${m.payload}`).join(\"\\n\") + \"\\n\";\n    const out = this.run([\"publish\", \"-t\", topic], body);\n    const m = /^accepted (\\d+) batch (\\d+)$/m.exec(out);\n    if (!m) throw new MqpubError(\"unparsed-output\", 0);\n    return { accepted: Number(m[1]), batch: Number(m[2]) };\n  }\n\n  /** offset 부터 끝까지 읽는다. */\n  consume(topic: string, fromOffset: number): ConsumedMessage[] {\n    const out = this.run([\"consume\", \"-t\", topic, \"-o\", String(fromOffset)]);\n    const rows: ConsumedMessage[] = [];\n    for (const line of out.split(\"\\n\")) {\n      if (line === \"\") continue;\n      const [off, key, ...rest] = line.split(\"\\t\");\n      rows.push({ offset: Number(off), key, payload: rest.join(\"\\t\") });\n    }\n    return rows;\n  }\n}\nimport { Notification } from \"../domain/notification\";\nimport { isEventKind } from \"../domain/order\";\n\nconst VERSION = 2;\nconst MAX_PAYLOAD = 900;\n\ninterface WirePayload {\n  v: number;\n  o: string;\n  c: string;\n  k: string;\n}\n\n/** 탭·개행·제어문자는 와이어 형식(<key>TAB<payload>)을 깨므로 제거한다. */\nfunction scrub(s: string): string {\n  return s.replace(/[\\u0000-\\u001f\\u007f]/g, \"\");\n}\n\nexport function encodePayload(n: Notification): string {\n  const body: WirePayload = { v: VERSION, o: scrub(n.orderNo), c: scrub(n.customerId), k: n.kind };\n  const json = JSON.stringify(body);\n  if (json.length > MAX_PAYLOAD) throw new Error(\"payload too large\");\n  return json;\n}\n\nexport function decodePayload(raw: string): Notification | null {\n  let body: Partial<WirePayload>;\n  try {\n    body = JSON.parse(raw) as Partial<WirePayload>;\n  } catch {\n    return null;\n  }\n  if (body.v !== VERSION && body.v !== 1) return null;\n  if (typeof body.o !== \"string\" || typeof body.c !== \"string\" || !isEventKind(body.k)) return null;\n  return { orderNo: body.o, customerId: body.c, kind: body.k };\n}\nimport { DispatchRun } from \"../domain/notification\";\nimport { AlertPublisher } from \"../messaging/eventPublisher\";\nimport { AlertConsumer } from \"../notifier/consumerWorker\";\nimport { CustomerRepository } from \"../repository/customerRepository\";\nimport { DeliveryLogRepository } from \"../repository/deliveryLogRepository\";\nimport { OrderRepository } from \"../repository/orderRepository\";\nimport { planNotifications } from \"./notificationPlanner\";\n\n/** 발송 회차: 미발송 이벤트 → 알림 계획 → 발행(1배치) → 소비·문자 발송 → 회차 기록 */\nexport class DispatchService {\n  private lastRunId = 0;\n\n  constructor(\n    private readonly orders: OrderRepository,\n    private readonly customers: CustomerRepository,\n    private readonly publisher: AlertPublisher,\n    private readonly consumer: AlertConsumer,\n    private readonly log: DeliveryLogRepository,\n  ) {}\n\n  runOnce(): DispatchRun {\n    const runId = ++this.lastRunId;\n    const events = this.orders.takePending();\n    const plan = planNotifications(events, this.customers);\n    const pub = this.publisher.publishRun(plan.notifications);\n    const drained = this.consumer.drain(runId);\n    const run: DispatchRun = {\n      runId,\n      planned: plan.notifications,\n      skippedOptOut: plan.skippedOptOut,\n      published: pub.accepted,\n      batch: pub.batch,\n      delivered: drained.delivered,\n      failed: drained.failed,\n    };\n    this.log.saveRun(run);\n    return run;\n  }\n}\nimport { Notification } from \"../domain/notification\";\nimport { CustomerRepository } from \"../repository/customerRepository\";\nimport { PendingEvent } from \"../repository/orderRepository\";\n\nexport interface Plan {\n  notifications: Notification[];\n  skippedOptOut: number;\n}\n\n/**\n * 회차에 실린 주문 이벤트를 고객 알림으로 바꾼다.\n *  - 수신 거부 고객은 제외한다.\n *  - 같은 주문·같은 이벤트가 회차 안에 여러 번 기록됐으면(운영자 재입력 등) 한 번만 알린다.\n *  - 이벤트 기록 순서를 유지한다.\n */\nexport function planNotifications(events: PendingEvent[], customers: CustomerRepository): Plan {\n  const seen = new Set<string>();\n  const notifications: Notification[] = [];\n  let skippedOptOut = 0;\n  for (const e of [...events].sort((a, b) => a.seq - b.seq)) {\n    const customer = customers.find(e.customerId);\n    if (!customer || !customer.smsOptIn) {\n      skippedOptOut++;\n      continue;\n    }\n    const id = `${e.orderNo}#${e.kind}`;\n    if (seen.has(id)) continue;\n    seen.add(id);\n    notifications.push({ orderNo: e.orderNo, customerId: e.customerId, kind: e.kind });\n  }\n  return { notifications, skippedOptOut };\n}\nimport { validateCustomer, Customer } from \"../domain/customer\";\nimport { Channel, Order, OrderEventKind, isEventKind } from \"../domain/order\";\nimport { CustomerRepository } from \"../repository/customerRepository\";\nimport { OrderRepository } from \"../repository/orderRepository\";\n\nexport interface PlaceOrderInput {\n  customerId: string;\n  channel?: Channel;\n  partner?: string;\n  placedOn: string;\n}\n\nexport class OrderService {\n  constructor(private readonly customers: CustomerRepository, private readonly orders: OrderRepository) {}\n\n  registerCustomer(input: unknown): Customer {\n    return this.customers.save(validateCustomer(input));\n  }\n\n  placeOrder(input: PlaceOrderInput): Order {\n    if (!this.customers.find(input.customerId)) throw new Error(\"unknown customer\");\n    const channel = input.channel ?? \"direct\";\n    if (channel !== \"direct\" && channel !== \"market\") throw new Error(\"invalid channel\");\n    return this.orders.create(input.customerId, channel, input.placedOn, input.partner);\n  }\n\n  recordEvent(orderNo: string, kind: unknown): { orderNo: string; kind: OrderEventKind; seq: number } {\n    if (!isEventKind(kind)) throw new Error(\"invalid event kind\");\n    const seq = this.orders.addEvent(orderNo, kind);\n    return { orderNo, kind, seq };\n  }\n}\ntests:\ndispatch.e2e.test.ts\nharness.ts\nplanner.test.ts\nutil.test.ts\n\nvendor/bin:\nmqpub\nELF\u0002\u0001\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000>\u0000\u0001\u0000\u0000\u0000@\u0016\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000HA\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u00008\u0000\r\u0000@\u0000\u001d\u0000\u001c\u0000\u0006\u0000\u0000\u0000\u0004\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0002\u0000\u0000\u0000\u0000\u0000\u0000�\u0002\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0004\u0000\u0000\u0000\u0018\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0018\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0018\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u001c\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u001c\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0004\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000h\u000b\u0000\u0000\u0000\u0000\u0000\u0000h\u000b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0005\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000\u