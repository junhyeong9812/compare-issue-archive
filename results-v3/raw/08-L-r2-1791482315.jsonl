u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u00000\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0000\u0000\u0000\b\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000 @\u0000\u0000\u0000\u0000\u0000\u0000\u00100\u0000\u0000\u0000\u0000\u0000\u0000��\u0006\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000 \u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0001\u0000\u0000\u0001\u0000\u0000\u00000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u00100\u0000\u0000\u0000\u0000\u0000\u0000-\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000=0\u0000\u0000\u0000\u0000\u0000\u0000\n\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000","is_error":false}]},"parent_tool_use_id":null,"session_id":"b9855679-bdab-4f81-a0f5-28ef924ed671","uuid":"cb136b93-94b6-4353-95f4-16cbe02ad542","timestamp":"2026-10-08T17:58:41.383Z","tool_use_result":{"stdout":"\"\"\"What the open market should show for each product, as stock feed lines.\"\"\"\n\n\ndef market_qty(product, settings):\n    \"\"\"Units we offer on the market: free stock minus the CS safety units.\"\"\"\n    return max(product.available - settings.market_safety_stock, 0)\n\n\ndef feed_line(sku, qty):\n    return f\"{sku}\\t{int(qty)}\"\n\n\ndef build_feed(products, settings):\n    \"\"\"Feed lines plus the quantity each line announces, keyed by SKU.\"\"\"\n    lines, sent = [], {}\n    for product in products:\n        qty = market_qty(product, settings)\n        lines.append(feed_line(product.sku, qty))\n        sent[product.sku] = qty\n    return [line for line in lines if line], sent\n\"\"\"Thin wrapper around the open-market stock sync CLI (vendor/bin/stockpush).\"\"\"\nimport os\nimport subprocess\nimport tempfile\n\nfrom hbstock.models import MarketRow, Transfer, VendorError\n\n\nclass StockpushClient:\n    def __init__(self, settings):\n        self.binary = settings.stockpush_bin\n        self.home = settings.stockpush_home or os.environ.get(\"STOCKPUSH_HOME\", \"\")\n        self.timeout = settings.stockpush_timeout\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"STOCKPUSH_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise VendorError(code, args[0])\n        return proc.stdout\n\n    def push(self, lines):\n        fd, path = tempfile.mkstemp(prefix=\"stockpush-\", suffix=\".tsv\")\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                f.write(\"\\n\".join(lines) + \"\\n\")\n            out = self._run(\"push\", \"--in\", path)\n        finally:\n            os.unlink(path)\n        transfer_id, _, count = out.strip().partition(\"\\t\")\n        if not transfer_id.startswith(\"T\") or not count.isdigit() or int(count) != len(lines):\n            raise VendorError(\"E??\", \"push\")\n        return Transfer(transfer_id, int(count))\n\n    def rows(self):\n        rows = []\n        for line in self._run(\"list\").splitlines():\n            parts = line.split(\"\\t\")\n            if len(parts) != 4 or not parts[1].isdigit():\n                continue\n            sku, qty, st, transfer = parts\n            rows.append(MarketRow(sku, int(qty), int(st), transfer))\n        return rows\n\n    def show(self, sku):\n        out = self._run(\"show\", sku)\n        info = dict(line.split(\" \", 1) for line in out.splitlines() if \" \" in line)\n        return MarketRow(info[\"sku\"], int(info[\"qty\"]), int(info[\"st\"]), info[\"transfer\"])\n\"\"\"Market sync: pushes the market quantity of every changed product to the vendor.\"\"\"\nfrom hbstock.market.feed import build_feed\n\n\nclass SyncService:\n    def __init__(self, repo, client, settings, on_synced=None):\n        self.repo = repo\n        self.client = client\n        self.settings = settings\n        self.on_synced = on_synced\n        self.last_sent = {}\n\n    def run(self, full=False):\n        skus = [p.sku for p in self.repo.products()] if full else self.repo.take_dirty()\n        if full:\n            self.repo.take_dirty()\n        products = [self.repo.product(sku) for sku in skus]\n        lines, sent = build_feed(products, self.settings)\n        # nothing to tell the market about a product whose announced quantity did not move\n        changed = [line for line, sku in zip(lines, sent) if full or self.last_sent.get(sku) != sent[sku]]\n        if not changed:\n            return {\"transfer\": None, \"lines\": 0, \"skus\": []}\n        transfer = self.client.push(changed)\n        pushed = [line.split(\"\\t\", 1)[0] for line in changed]\n        for sku in pushed:\n            self.last_sent[sku] = sent[sku]\n        if self.on_synced:\n            self.on_synced()\n        return {\"transfer\": transfer.transfer_id, \"lines\": transfer.lines, \"skus\": push