tform)) throw new Error(`unknown platform ${platform}`);\n  if (!/^[A-Za-z0-9_-]{8,48}$/.test(body)) throw new Error(\"device token body malformed\");\n  return `${platform}:${body}`;\n}\n\nexport function maskDevice(device: string): string {\n  const [p, body] = device.split(\":\");\n  return `${p}:${body.slice(0, 4)}…${body.slice(-2)}`;\n}\nimport { LocalDate, LocalDateTime } from \"../time/localTime\";\n\nexport type ReminderKind = \"BILL_DUE\" | \"RETRY\";\n\nexport const KIND_LABEL: Record<ReminderKind, string> = {\n  BILL_DUE: \"출금 예정\",\n  RETRY: \"재출금 안내\",\n};\n\nconst KIND_CODE: Record<ReminderKind, string> = {\n  BILL_DUE: \"due\",\n  RETRY: \"retry\",\n};\n\nexport interface Reminder {\n  /** 푸시 태그로도 쓰는 업무 키 — 같은 알림은 늘 같은 키 */\n  key: string;\n  kind: ReminderKind;\n  memberId: string;\n  autopayId: string;\n  device: string;\n  /** 이 알림이 안내하는 출금(또는 재출금) 시각 */\n  dueAt: LocalDateTime;\n  /** 실제 발송 예약 시각 */\n  sendAt: LocalDateTime;\n  /** 리포트 묶음 기준일(= 출금일) */\n  planDate: LocalDate;\n  message: string;\n  ticket?: string;\n}\n\nexport function reminderKey(kind: ReminderKind, autopayId: string, dueAt: LocalDateTime): string {\n  return `rmd.${autopayId}.${KIND_CODE[kind]}.${dueAt.slice(0, 10).replace(/-/g, \"\")}`;\n}\nimport { join } from \"path\";\n\nexport interface AppConfig {\n  /** pushq 상태 디렉토리(PUSHQ_HOME) */\n  pushqHome: string;\n  /** pushq 바이너리 경로 */\n  pushqBin: string;\n  /** 출금 실패 후 재출금까지 걸리는 시간(분) */\n  retryDelayMinutes: number;\n  /** 재출금 안내를 재출금 몇 분 전에 보낼지 */\n  retryNoticeLeadMinutes: number;\n  /** 야간 방해 금지 구간 [시작, 끝) — \"HH:MM\" */\n  quietStart: string;\n  quietEnd: string;\n  /** 방해 금지 구간에 걸린 알림을 옮길 전날 저녁 시각 */\n  quietFallback: string;\n  /** 고객이 고를 수 있는 출금 예정 알림 시점(분) */\n  allowedLeads: number[];\n}\n\nexport function loadConfig(overrides: Partial<AppConfig> = {}): AppConfig {\n  return {\n    pushqHome: process.env.PUSHQ_HOME ?? join(process.cwd(), \".pushq\"),\n    pushqBin: join(process.cwd(), \"vendor\", \"bin\", \"pushq\"),\n    retryDelayMinutes: 120,\n    retryNoticeLeadMinutes: 30,\n    quietStart: \"22:00\",\n    quietEnd: \"07:00\",\n    quietFallback: \"21:00\",\n    allowedLeads: [10, 30, 60, 1440],\n    ...overrides,\n  };\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CPZroGRUuKNxjz23WKu6VQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
