{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0153baVTfNZYwhEHQmaAQnhg","type":"tool_result","content":"\"\"\"Thin wrapper around the identity-verification vendor CLI (vendor/bin/idchk).\"\"\"\nimport os\nimport subprocess\nimport tempfile\n\nfrom hbonboard.models import JobTicket, VendorError\n\n# the vendor answers this for a reference it has no verdict for (yet)\nNO_RESULT = \"E31\"\n\n\nclass IdchkClient:\n    def __init__(self, settings):\n        self.binary = settings.idchk_bin\n        self.home = settings.idchk_home or os.environ.get(\"IDCHK_HOME\", \"\")\n        self.timeout = settings.idchk_timeout\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"IDCHK_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise VendorError(code, args[0])\n        return proc.stdout\n\n    def submit(self, requests):\n        \"\"\"Send one batch file; returns the vendor job ticket.\"\"\"\n        lines = [f\"{r.ref}\\t{r.name}\\t{r.birth}\\t{r.phone}\" for r in requests]\n        fd, path = tempfile.mkstemp(prefix=\"idchk-\", suffix=\".tsv\")\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                f.write(\"\\n\".join(lines) + \"\\n\")\n            out = self._run(\"batch\", \"--in\", path)\n        finally:\n            os.unlink(path)\n        job_id, _, count = out.strip().partition(\"\\t\")\n        if not job_id.startswith(\"J\") or not count.isdigit():\n            raise VendorError(\"E??\", \"batch\")\n        if int(count) != len(lines):\n            # the vendor read a different number of lines than we wrote\n            raise VendorError(\"E??\", \"batch\")\n        return JobTicket(job_id, int(count))\n\n    def result(self, ref):\n        \"\"\"Verdict code for a reference, or None while the vendor has none.\"\"\"\n        try:\n            out = self._run(\"result\", ref)\n        except VendorError as exc:\n            if exc.code == NO_RESULT:\n                return None\n            raise\n        fields = dict(line.split(\" \", 1) for line in out.splitlines() if \" \" in line)\n        return int(fields[\"v\"])\n\n    def job(self, job_id):\n        out = self._run(\"job\", job_id)\n        return dict(line.split(\" \", 1) for line in out.splitlines() if \" \" in line)\n\"\"\"Turns members waiting for an identity check into vendor request lines.\"\"\"\nfrom hbonboard.models import KycRequest\nfrom hbonboard.util.dates import compact\nfrom hbonboard.util.text import vendor_name\n\n\ndef to_request(member):\n    return KycRequest(\n        ref=member.member_id,\n        name=vendor_name(member.name),\n        birth=compact(member.birth),\n        phone=member.phone,\n    )\n\n\ndef build_batch(members):\n    \"\"\"One line per member, in phone-number order (the vendor's matching key).\"\"\"\n    seen, requests = set(), []\n    for member in members:\n        if member.member_id in seen:\n            continue\n        seen.add(member.member_id)\n        requests.append(to_request(member))\n    return sorted(requests, key=lambda r: r.phone)\n\"\"\"Vendor verdict codes -> member status.\"\"\"\nfrom hbonboard.models import ACTIVE, KYC_DONE, REJECTED, REVIEW\n\n# 1 = identity matched, 2 = identity did not match; anything else goes to a person\nVERDICT_STATUS = {1: ACTIVE, 2: REJECTED}\n\n\ndef status_for(code):\n    return VERDICT_STATUS.get(code, REVIEW)\n\n\ndef apply_verdict(member, code):\n    member.verdict = code\n    member.status = status_for(code)\n    member.kyc_state = KYC_DONE\n    member.history.append(member.status)\n    return member\n\"\"\"Identity-check run: sends new members to the vendor and applies verdicts.\"\"\"\nfrom hbonboard.kyc.requests import build_batch\nfrom hbonboard.kyc.verdicts import apply_verdict\nfrom hbonboard.models import KYC_NEW, KYC_SENT\n\n\nclass VerificationService:\n    def __init__(self, repo, client, settings, notifier=None, on_resolved=None):\n        self.repo = repo\n        self.client = client\n        self.settings = settings\n        self.notifier = notifier\n        self.on_resolved = on_resolved\n\n    def _send_new(self):\n        fresh = sorted(self.repo.by_kyc_state(KYC_NEW), key=lambda m: m.member_id)\n        if not fresh:\n            return [], 0\n        ticket = self.client.submit(build_batch(fresh))\n        for member in fresh:\n            member.kyc_state = KYC_SENT\n            member.kyc_job = ticket.job_id\n            member.history.append(KYC_SENT)\n        return [ticket.job_id], len(fresh)\n\n    def _collect(self):\n        resolved, waiting = [], []\n        for member in sorted(self.repo.by_kyc_state(KYC_SENT), key=lambda m: m.member_id):\n            code = self.client.result(member.member_id)\n            if code is None:\n                # the vendor has not answered for this one yet; ask again next run\n                waiting.append(member.member_id)\n                continue\n            apply_verdict(member, code)\n            if self.notifier:\n                self.notifier.verdict(member)\n            resolved.append({\"id\": member.member_id, \"status\": member.status})\n        return resolved, waiting\n\n    def run(self):\n        jobs, sent = self._send_new()\n        resolved, waiting = self._collect()\n        if resolved and self.on_resolved:\n            self.on_resolved()\n        return {\"jobs\": jobs, \"sent\": sent, \"resolved\": resolved, \"waiting\": len(waiting)}\n\"\"\"Admin console: where every member stands in the onboarding funnel.\"\"\"\nfrom hbonboard.models import ACTIVE, PENDING, REJECTED, REVIEW\nfrom hbonboard.util.phone import mask_phone\n\n\nclass BacklogReport:\n    def __init__(self, repo, settings, cache):\n        self.repo = repo\n        self.settings = settings\n        self.cache = cache\n\n    def invalidate(self):\n        self.cache.invalidate(\"backlog\")\n\n    def summary(self):\n        cached = self.cache.get(\"backlog\")\n        if cached is not None:\n            return cached\n        members = sorted(self.repo.all(), key=lambda m: m.member_id)\n        counts = {s: 0 for s in (PENDING, ACTIVE, REJECTED, REVIEW)}\n        by_channel = {}\n        for member in members:\n            counts[member.status] = counts.get(member.status, 0) + 1\n            if member.status == PENDING:\n                by_channel[member.channel] = by_channel.get(member.channel, 0) + 1\n        pending = [\n            {\n                \"id\": m.member_id,\n                \"phone\": mask_phone(m.phone),\n                \"channel\": m.channel,\n                \"kyc_state\": m.kyc_state,\n                \"job\": m.kyc_job,\n            }\n            for m in members if m.status == PENDING\n        ]\n        report = {\n            \"total\": len(members),\n            \"counts\": counts,\n            \"pending_by_channel\": dict(sorted(by_channel.items())),\n            \"pending\": pending[: self.settings.pending_preview],\n        }\n        self.cache.put(\"backlog\", report)\n        return report\nELF\u0002\u0001\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000>\u0000\u0001\u0000\u0000\u0000\u0000\u0014\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000HA\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u00008\u0000\r\u0000@\u0000\u001d\u0000\u001c\u0000\u0006\u0000\u0000\u0000\u0004\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0002\u0000\u0000\u0000\u0000\u0000\u0000�\u0002\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u00