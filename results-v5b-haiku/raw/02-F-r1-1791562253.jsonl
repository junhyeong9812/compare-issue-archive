{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DCLhrEuxScs1nP5Suq4w2S","type":"tool_result","content":"\"\"\"Claim detail and list show whether the claim's ledger entry is booked.\"\"\"\nimport unittest\n\nfrom tests.support import LedgerHome, app_with_claims, load_claims\n\n\nclass LedgerStatusTest(unittest.TestCase):\n    def setUp(self):\n        self.home = LedgerHome()\n        self.claims = load_claims()\n        self.app, self.ids = app_with_claims(self.home, self.claims)\n        pending = dict(self.claims[2], description=\"복사 용지 추가\")\n        self.pending = self.app.post(\"/claims\", pending).body[\"id\"]\n        run = self.app.post(\"/settlement/run\", query={\"month\": \"2026-09\"})\n        self.assertEqual(run.status, 200, run.body)\n\n    def tearDown(self):\n        self.home.cleanup()\n\n    def test_settled_claims_are_booked(self):\n        for cid in self.ids:\n            resp = self.app.get(f\"/claims/{cid}\")\n            self.assertEqual(resp.status, 200, resp.body)\n            self.assertEqual(resp.body[\"status\"], \"posted\")\n            self.assertEqual(resp.body[\"ledger_status\"], \"booked\", cid)\n\n    def test_unsettled_claim_has_no_ledger_status(self):\n        body = self.app.get(f\"/claims/{self.pending}\").body\n        self.assertEqual(body[\"status\"], \"submitted\")\n        self.assertIsNone(body[\"ledger_status\"])\n\n    def test_list_carries_ledger_status(self):\n        resp = self.app.get(\"/claims\")\n        self.assertEqual(resp.status, 200, resp.body)\n        status = {c[\"id\"]: c[\"ledger_status\"] for c in resp.body[\"items\"]}\n        self.assertEqual(status[self.pending], None)\n        for cid in self.ids:\n            self.assertEqual(status[cid], \"booked\", cid)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n====\n\"\"\"Thin wrapper around the vendor ledger CLI (vendor/bin/ledgerctl).\"\"\"\nimport os\nimport subprocess\n\nfrom hbexpense.models import LedgerError, LedgerRow\n\n\nclass LedgerClient:\n    def __init__(self, settings):\n        self.binary = settings.ledger_bin\n        self.home = settings.ledger_home or os.environ.get(\"LEDGERCTL_HOME\", \"\")\n        self.timeout = settings.ledger_timeout\n        self.show_allowed = settings.ledger_show_allowed\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"LEDGERCTL_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise LedgerError(code, args[0])\n        return proc.stdout\n\n    def post(self, entry):\n        out = self._run(\n            \"post\",\n            \"--acct\", entry.account,\n            \"--amt\", str(entry.amount),\n            \"--date\", entry.date,\n            \"--ref\", entry.ref,\n            \"--memo\", entry.memo,\n        )\n        receipt = out.strip()\n        if not receipt.startswith(\"R\"):\n            raise LedgerError(\"E??\", \"post\")\n        return receipt\n\n    def list_rows(self, date_from, date_to):\n        out = self._run(\"list\", \"--from\", date_from, \"--to\", date_to)\n        rows = []\n        for line in out.splitlines():\n            if not line or line.startswith(\"#\"):\n                continue\n            parts = line.split(\"\\t\", 5)\n            if len(parts) != 6:\n                continue\n            receipt, date, account, amount, ref, memo = parts\n            rows.append(LedgerRow(receipt, date, account, int(amount), ref, memo))\n        return rows\n\n    def show(self, receipt):\n        # TODO: read-only lookup — do we still need to keep this switched off? (EXP-412)\n        if not self.show_allowed:\n            raise RuntimeError(\"ledger show is not enabled in this deployment\")\n        out = self._run(\"show\", receipt)\n        info = {}\n        for line in out.splitlines():\n            key, _, value = line.partition(\" \")\n            info[key] = value\n        return info\n====\n\"\"\"Turns an approved expense claim into a ledger entry.\"\"\"\nfrom hbexpense.models import LedgerEntry\nfrom hbexpense.util.text import clip_chars, clip_utf8, normalize\n\n\ndef compose_memo(claim):\n    \"\"\"Memo shown to the finance team: claim id, claimant, what it was for.\"\"\"\n    parts = [claim.claim_id, claim.claimant, claim.description]\n    return normalize(\" \".join(p for p in parts if p))\n\n\ndef build_entry(claim, settings):\n    account = settings.accounts.get(claim.category)\n    if account is None:\n        raise ValueError(f\"no ledger account for category {claim.category}\")\n    memo = clip_chars(compose_memo(claim), settings.ledger_memo_chars)\n    memo = clip_utf8(memo, settings.ledger_memo_bytes)\n    return LedgerEntry(\n        account=account,\n        amount=claim.amount,\n        date=claim.spent_on,\n        ref=claim.claim_id,\n        memo=memo,\n    )\n====\n\"\"\"Month-end expense report, read back from the ledger.\"\"\"\nfrom hbexpense.util.dates import month_bounds\nfrom hbexpense.util.money import format_krw, total\n\n\nclass ReportService:\n    def __init__(self, repo, ledger, cache):\n        self.repo = repo\n        self.ledger = ledger\n        self.cache = cache\n\n    def invalidate(self, month):\n        self.cache.invalidate(f\"monthly:{month}\")\n\n    def _rows(self, month):\n        date_from, date_to = month_bounds(month)\n        rows = self.ledger.list_rows(date_from, date_to)\n        # a claim re-posted after a correction keeps the newest receipt only\n        latest = {}\n        for row in rows:\n            seen = latest.get(row.ref)\n            if seen is None or row.receipt > seen.receipt:\n                latest[row.ref] = row\n        return sorted(latest.values(), key=lambda r: (r.date, r.receipt))\n\n    def monthly(self, month):\n        key = f\"monthly:{month}\"\n        cached = self.cache.get(key)\n        if cached is not None:\n            return cached\n        rows = self._rows(month)\n        by_account, by_cost_center, lines = {}, {}, []\n        for row in rows:\n            by_account[row.account] = by_account.get(row.account, 0) + row.amount\n            claim = self.repo.by_ref(row.ref)\n            center = claim.cost_center if claim else \"UNKNOWN\"\n            by_cost_center[center] = by_cost_center.get(center, 0) + row.amount\n            lines.append({\n                \"receipt\": row.receipt,\n                \"date\": row.date,\n                \"ref\": row.ref,\n                \"account\": row.account,\n                \"amount\": row.amount,\n                \"memo\": row.memo,\n            })\n        grand = total(r.amount for r in rows)\n        report = {\n            \"month\": month,\n            \"entries\": len(rows),\n            \"total\": grand,\n            \"total_display\": format_krw(grand),\n            \"by_account\": dict(sorted(by_account.items())),\n            \"by_cost_center\": dict(sorted(by_cost_center.items())),\n            \"lines\": lines,\n        }\n        self.cache.put(key, report)\n        return report\n====\n\"\"\"Claim submission and approval workflow.\"\"\"\nimport re\n\nfrom hbexpense.models import APPROVED, REJECTED, SUBMITTED, Claim, Conflict\nfrom hbexpense.util.dates import month_of, parse_date\nfrom hbexpense.util.text import normalize\n\n_COST_CENTER = re.compile(r\"^CC\\d{3}$\")\n\n\nclass ClaimService:\n    def __init__(self, repo, settings):\n        self.repo = repo\n        self.settings = settings\n\n    def validate(self, payload):\n        claimant = normalize(payload.get(\"claimant\"))\n        description = normalize(payload.get(\"description\"))\n        cost_center = str(payload.get(\"cost_center\", \"\")).strip().upper()\n        category = str(payload.get(\"category\", \"\")).strip().upper()\n        if not claimant or len(claimant) > self.settings.claimant_max_chars:\n            raise ValueError(\"claimant is required (max %d characters)\" % self.settings.claimant_max_chars)\n        if not description:\n            raise ValueError(\"description is required\")\n        if len(description) > self.settings.description_max_chars:\n            raise ValueError(\"description is limited to %d characters\" % self.settings.description_max_chars)\n        if not _COST_CENTER.match(cost_center):\n            raise ValueError(\"cost_center must look like CC123\")\n        if category not in self.settings.accounts:\n            raise ValueError(f\"unknown category {category}\")\n        try:\n            amount = int(payload.get(\"amount\"))\n        except (TypeError, ValueError):\n            raise ValueError(\"amount must be an integer\") from None\n        if not 0 < amount <= self.settings.max_amount:\n            raise ValueError(\"amount out of range\")\n        spent_on = parse_date(payload.get(\"spent_on\")).isoformat()\n        return {\n            \"claimant\": claimant,\n            \"description\": description,\n            \"cost_center\": cost_center,\n            \"category\": category,\n            \"amount\": amount,\n            \"spent_on\": spent_on,\n        }\n\n    def submit(self, payload):\n        fields = self.validate(payload)\n        claim_id = self.repo.next_id(month_of(fields[\"spent_on\"]))\n        claim = Claim(claim_id=claim_id, **fields)\n        claim.history.append(SUBMITTED)\n        return self.repo.add(claim)\n\n    def approve(self, claim_id):\n        claim = self.repo.get(claim_id)\n        if claim.status != SUBMITTED:\n            raise Conflict(f\"claim {claim_id} is {claim.status}\")\n        claim.status = APPROVED\n        claim.history.append(APPROVED)\n        return claim\n\n    def reject(self, claim_id):\n        claim = self.repo.get(claim_id)\n        if claim.status != SUBMITTED:\n            raise Conflict(f\"claim {claim_id} is {claim.status}\")\n        claim.status = REJECTED\n        claim.history.append(REJECTED)\n        return claim\n====\n\"\"\"Endpoint handlers. Each takes (app, request, **path_params) and returns a Response.\"\"\"\nfrom hbexpense.api.http import Response, month_param, str_param\nfrom hbexpense.util.money import format_krw\nfrom hbexpense.util.text import pad_display\n\n\ndef submit_claim(app, request):\n    claim = app.services[\"claims\"].submit(request.body or {})\n    return Response(201, claim.to_dict())\n\n\ndef approve_claim(app, request, claim_id):\n    return Response.ok(app.services[\"claims\"].approve(claim_id).to_dict())\n\n\ndef reject_claim(app, request, claim_id):\n    return Response.ok(app.services[\"claims\"].reject(claim_id).to_dict())\n\n\ndef get_claim(app, request, claim_id):\n    return Response.ok(app.repo.get(claim_id).to_dict())\n\n\ndef list_claims(app, request):\n    status = str_param(request.query, \"status\")\n    claims = app.repo.all()\n    if status:\n        claims = [c for c in claims if c.status == status]\n    return Response.ok({\"items\": [c.to_dict() for c in claims]})\n\n\ndef run_settlement(app, request):\n    month = month_param(request.query)\n    return Response.ok(app.services[\"settlement\"].run(month))\n\n\ndef monthly_report(app, request):\n    month = month_param(request.query)\n    return Response.ok(app.services[\"reports\"].monthly(month))\n\n\ndef monthly_report_text(app, request):\n    month = month_param(request.query)\n    report = app.services[\"reports\"].monthly(month)\n    out = [f\"Expense report {month}\", \"-\" * 64]\n    for line in report[\"lines\"]:\n        out.append(\n            f\"{line['receipt']}  {line['date']}  {pad_display(line['memo'], 36)}\"\n            f\"{format_krw(line['amount']):>12}\"\n        )\n    out.append(\"-\" * 64)\n    out.append(f\"{report['entries']} entries{report['total_display']:>{64 - 10}}\")\n    return Response.ok({\"text\": \"\\n\".join(out)})\n====\n\"\"\"Runtime settings. Values can be overridden through build_app(**overrides).\"\"\"\nimport os\nfrom dataclasses import dataclass, field, replace\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef _default_ledger_bin():\n    return os.environ.get(\"HB_LEDGER_BIN\", os.path.join(_ROOT, \"vendor\", \"bin\", \"ledgerctl\"))\n\n\n@dataclass(frozen=True)\nclass Settings:\n    # vendor ledger CLI\n    ledger_bin: str = field(default_factory=_default_ledger_bin)\n    ledger_home: str = \"\"\n    ledger_timeout: float = 10.0\n    # claim form rules (expense portal screen spec v3)\n    description_max_chars: int = 30\n    claimant_max_chars: int = 10\n    max_amount: int = 5_000_000\n    # ledger memo column as agreed with the finance team\n    ledger_memo_chars: int = 40\n    # the ledger only books memos up to 48 UTF-8 bytes; longer ones are parked\n    ledger_memo_bytes: int = 48\n    # per-entry lookups (`show`) stay with the finance reconciliation desk\n    # since EXP-412; the desk's own tooling turns this on\n    ledger_show_allowed: bool = False\n    # category -> ledger account code\n    accounts: dict = field(default_factory=lambda: {\n        \"TRAVEL\": \"5110\",\n        \"MEAL\": \"5120\",\n        \"SUPPLIES\": \"5130\",\n        \"TRAINING\": \"5140\",\n        \"COMMS\": \"5150\",\n    })\n    report_cache_ttl: float = 60.0\n\n    def with_overrides(self, **overrides):\n        unknown = set(overrides) - set(self.__dataclass_fields__)\n        if unknown:\n            raise KeyError(f\"unknown settings: {sorted(unknown)}\")\n        return replace(self, **overrides)\n\n\nDEFAULTS = Settings()\n====\n\"\"\"Tiny TTL cache for computed reports.\"\"\"\nimport time\n\n\nclass TTLCache:\n    def __init__(self, ttl, clock=None):\n        self.ttl = ttl\n        self._clock = clock or time.monotonic\n        self._data = {}\n\n    def get(self, key):\n        item = self._data.get(key)\n        if item is None:\n            return None\n        stored_at, value = item\n        if self._clock() - stored_at > self.ttl:\n            del self._data[key]\n            return None\n        return value\n\n    def put(self, key, value):\n        self._data[key] = (self._clock(), value)\n\n    def invalidate(self, prefix=\"\"):\n        for key in [k for k in self._data if str(k).startswith(prefix)]:\n            del self._data[key]\n\n    def clear(self):\n        self._data.clear()\n====\n# 원장 벤더(ledgerctl) 운영 메모\n\n재무시스템팀 · 마지막 갱신 2025-05\n\n## 연락처\n- 벤더 기술지원: 평일 09–18시, 장애는 핫라인(사내 위키 \"원장 벤더\" 페이지).\n- 사내 담당: 재무시스템팀 원장 파트.\n\n## 저널 위치\n- 운영: `LEDGERCTL_HOME=/data/ledger` (서비스 계정만 쓰기).\n- 개발·테스트: 임시 디렉터리.\n\n## 월 정산서 항목 (계약서 부속 2 기준)\n| 항목 | 단위 |\n|---|---|\n| 기본료 | 월 고정 — post, list 포함 |\n| 단건 열람 | 호출 1회당 25원 |\n| 저널 보관 초과 | 10GB 단위 |\n\n## 정산서 이력\n- 2025-02분: 단건 열람 412,300회.\n- 2025-03분: 단건 열람 768,140회(1,920만 원). 발생 시스템 대부분 경비 포털. 재무 원장 파트 문의 → EXP-412.\n- 2025-04분 이후: 단건 열람 월 1천 회 안팎(대사 데스크).\n\n## 메모 길이\n- 메모 상한 UTF-8 48바이트(넘으면 보류). 2026-10 경비 정산 마감 건 참고.","is_error":false}]},"parent_tool_use_id":null,"session_id":"2e41f7fd-e2f5-468c-8480-7071ce61aedb","uuid":"9dc6b43d-a252-4059-bb2b-2c3f8dd900d6","timestamp":"2026-10-09T16:11:02.788Z","tool_use_result":{"stdout":"\"\"\"Claim detail and list show whether the claim's ledger entry is booked.\"\"\"\nimport unittest\n\nfrom tests.support import LedgerHome, app_with_claims, load_claims\n\n\nclass LedgerStatusTest(unittest.TestCase):\n    def setUp(self):\n        self.home = LedgerHome()\n        self.claims = load_claims()\n        self.app, self.ids = app_with_claims(self.home, self.claims)\n        pending = dict(self.claims[2], description=\"복사 용지 추가\")\n        self.pending = self.app.post(\"/claims\", pending).body[\"id\"]\n        run = self.app.post(\"/settlement/run\", query={\"month\": \"2026-09\"})\n        self.assertEqual(run.status, 200, run.body)\n\n    def tearDown(self):\n        self.home.cleanup()\n\n    def test_settled_claims_are_booked(self):\n        for cid in self.ids:\n            resp = self.app.get(f\"/claims/{cid}\")\n            self.assertEqual(resp.status, 200, resp.body)\n            self.assertEqual(resp.body[\"status\"], \"posted\")\n            self.assertEqual(resp.body[\"ledger_status\"], \"booked\", cid)\n\n    def test_unsettled_claim_has_no_ledger_status(self):\n        body = self.app.get(f\"/claims/{self.pending}\").body\n        self.assertEqual(body[\"status\"], \"submitted\")\n        self.assertIsNone(body[\"ledger_status\"])\n\n    def test_list_carries_ledger_status(self):\n        resp = self.app.get(\"/claims\")\n        self.assertEqual(resp.status, 200, resp.body)\n        status = {c[\"id\"]: c[\"ledger_status\"] for c in resp.body[\"items\"]}\n        self.assertEqual(status[self.pending], None)\n        for cid in self.ids:\n            self.assertEqual(status[cid], \"booked\", cid)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n====\n\"\"\"Thin wrapper around the vendor ledger CLI (vendor/bin/ledgerctl).\"\"\"\nimport os\nimport subprocess\n\nfrom hbexpense.models import LedgerError, LedgerRow\n\n\nclass LedgerClient:\n    def __init__(self, settings):\n        self.binary = settings.ledger_bin\n        self.home = settings.ledger_home or os.environ.get(\"LEDGERCTL_HOME\", \"\")\n        self.timeout = settings.ledger_timeout\n        self.show_allowed = settings.ledger_show_allowed\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"LEDGERCTL_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise LedgerError(code, args[0])\n        return proc.stdout\n\n    def post(self, entry):\n        out = self._run(\n            \"post\",\n            \"--acct\", entry.account,\n            \"--amt\", str(entry.amount),\n            \"--date\", entry.date,\n            \"--ref\", entry.ref,\n            \"--memo\", entry.memo,\n        )\n        receipt = out.strip()\n        if not receipt.startswith(\"R\"):\n            raise LedgerError(\"E??\", \"post\")\n        return receipt\n\n    def list_rows(self, date_from, date_to):\n        out = self._run(\"list\", \"--from\", date_from, \"--to\", date_to)\n        rows = []\n        for line in out.splitlines():\n            if not line or line.startswith(\"#\"):\n                continue\n            parts = line.split(\"\\t\", 5)\n            if len(parts) != 6:\n                continue\n            receipt, date, account, amount, ref, memo = parts\n            rows.append(LedgerRow(receipt, date, account, int(amount), ref, memo))\n        return rows\n\n    def show(self, receipt):\n        # TODO: read-only lookup — do we still need to keep this switched off? (EXP-412)\n        if not self.show_allowed:\n            raise RuntimeError(\"ledger show is not enabled in this deployment\")\n        out = self._run(\"show\", receipt)\n        info = {}\n        for line in out.splitlines():\n            key, _, value = line.partition(\" \")\n            info[key] = value\n        return info\n====\n\"\"\"Turns an approved expense claim into a ledger entry.\"\"\"\nfrom hbexpense.models import LedgerEntry\nfrom hbexpense.util.text import clip_chars, clip_utf8, normalize\n\n\ndef compose_memo(claim):\n    \"\"\"Memo shown to the finance team: claim id, claimant, what it was for.\"\"\"\n    parts = [claim.claim_id, claim.claimant, claim.description]\n    return normalize(\" \".join(p for p in parts if p))\n\n\ndef build_entry(claim, settings):\n    account = settings.accounts.get(claim.category)\n    if account is None:\n        raise ValueError(f\"no ledger account for category {claim.category}\")\n    memo = clip_chars(compose_memo(claim), settings.ledger_memo_chars)\n    memo = clip_utf8(memo, settings.ledger_memo_bytes)\n    return LedgerEntry(\n        account=account,\n        amount=claim.amount,\n        date=claim.spent_on,\n        ref=claim.claim_id,\n        memo=memo,\n    )\n====\n\"\"\"Month-end expense report, read back from the ledger.\"\"\"\nfrom hbexpense.util.dates import month_bounds\nfrom hbexpense.util.money import format_krw, total\n\n\nclass ReportService:\n    def __init__(self, repo, ledger, cache):\n        self.repo = repo\n        self.ledger = ledger\n        self.cache = cache\n\n    def invalidate(self, month):\n        self.cache.invalidate(f\"monthly:{month}\")\n\n    def _rows(self, month):\n        date_from, date_to = month_bounds(month)\n        rows = self.ledger.list_rows(date_from, date_to)\n        # a claim re-posted after a correction keeps the newest receipt only\n        latest = {}\n        for row in rows:\n            seen = latest.get(row.ref)\n            if seen is None or row.receipt > seen.receipt:\n                latest[row.ref] = row\n        return sorted(latest.values(), key=lambda r: (r.date, r.receipt))\n\n    def monthly(self, month):\n        key = f\"monthly:{month}\"\n        cached = self.cache.get(key)\n        if cached is not None:\n            return cached\n        rows = self._rows(month)\n        by_account, by_cost_center, lines = {}, {}, []\n        for row in rows:\n            by_account[row.account] = by_account.get(row.account, 0) + row.amount\n            claim = self.repo.by_ref(row.ref)\n            center = claim.cost_center if claim else \"UNKNOWN\"\n            by_cost_center[center] = by_cost_center.get(center, 0) + row.amount\n            lines.append({\n                \"receipt\": row.receipt,\n                \"date\": row.date,\n                \"ref\": row.ref,\n                \"account\": row.account,\n                \"amount\": row.amount,\n                \"memo\": row.memo,\n            })\n        grand = total(r.amount for r in rows)\n        report = {\n            \"month\": month,\n            \"entries\": len(rows),\n            \"total\": grand,\n            \"total_display\": format_krw(grand),\n            \"by_account\": dict(sorted(by_account.items())),\n            \"by_cost_center\": dict(sorted(by_cost_center.items())),\n            \"lines\": lines,\n        }\n        self.cache.put(key, report)\n        return report\n====\n\"\"\"Claim submission and approval workflow.\"\"\"\nimport re\n\nfrom hbexpense.models import APPROVED, REJECTED, SUBMITTED, Claim, Conflict\nfrom hbexpense.util.dates import month_of, parse_date\nfrom hbexpense.util.text import normalize\n\n_COST_CENTER = re.compile(r\"^CC\\d{3}$\")\n\n\nclass ClaimService:\n    def __init__(self, repo, settings):\n        self.repo = repo\n        self.settings = settings\n\n    def validate(self, payload):\n        claimant = normalize(payload.get(\"claimant\"))\n        description = normalize(payload.get(\"description\"))\n        cost_center = str(payload.get(\"cost_center\", \"\")).strip().upper()\n        category = str(payload.get(\"category\", \"\")).strip().upper()\n        if not claimant or len(claimant) > self.settings.claimant_max_chars:\n            raise ValueError(\"claimant is required (max %d characters)\" % self.settings.claimant_max_chars)\n        if not description:\n            raise ValueError(\"description is required\")\n        if len(description) > self.settings.description_max_chars:\n            raise ValueError(\"description is limited to %d characters\" % self.settings.description_max_chars)\n        if not _COST_CENTER.match(cost_center):\n            raise ValueError(\"cost_center must look like CC123\")\n        if category not in self.settings.accounts:\n            raise ValueError(f\"unknown category {category}\")\n        try:\n            amount = int(payload.get(\"amount\"))\n        except (TypeError, ValueError):\n            raise ValueError(\"amount must be an integer\") from None\n        if not 0 < amount <= self.settings.max_amount:\n            raise ValueError(\"amount out of range\")\n        spent_on = parse_date(payload.get(\"spent_on\")).isoformat()\n        return {\n            \"claimant\": claimant,\n            \"description\": description,\n            \"cost_center\": cost_center,\n            \"category\": category,\n            \"amount\": amount,\n            \"spent_on\": spent_on,\n        }\n\n    def submit(self, payload):\n        fields = self.validate(payload)\n        claim_id = self.repo.next_id(month_of(fields[\"spent_on\"]))\n        claim = Claim(claim_id=claim_id, **fields)\n        claim.history.append(SUBMITTED)\n        return self.repo.add(claim)\n\n    def approve(self, claim_id):\n        claim = self.repo.get(claim_id)\n        if claim.status != SUBMITTED:\n            raise Conflict(f\"claim {claim_id} is {claim.status}\")\n        claim.status = APPROVED\n        claim.history.append(APPROVED)\n        return claim\n\n    def reject(self, claim_id):\n        claim = self.repo.get(claim_id)\n        if claim.status != SUBMITTED:\n            raise Conflict(f\"claim {claim_id} is {claim.status}\")\n        claim.status = REJECTED\n        claim.history.append(REJECTED)\n        return claim\n====\n\"\"\"Endpoint handlers. Each takes (app, request, **path_params) and returns a Response.\"\"\"\nfrom hbexpense.api.http import Response, month_param, str_param\nfrom hbexpense.util.money import format_krw\nfrom hbexpense.util.text import pad_display\n\n\ndef submit_claim(app, request):\n    claim = app.services[\"claims\"].submit(request.body or {})\n    return Response(201, claim.to_dict())\n\n\ndef approve_claim(app, request, claim_id):\n    return Response.ok(app.services[\"claims\"].approve(claim_id).to_dict())\n\n\ndef reject_claim(app, request, claim_id):\n    return Response.ok(app.services[\"claims\"].reject(claim_id).to_dict())\n\n\ndef get_claim(app, request, claim_id):\n    return Response.ok(app.repo.get(claim_id).to_dict())\n\n\ndef list_claims(app, request):\n    status = str_param(request.query, \"status\")\n    claims = app.repo.all()\n    if status:\n        claims = [c for c in claims if c.status == status]\n    return Response.ok({\"items\": [c.to_dict() for c in claims]})\n\n\ndef run_settlement(app, request):\n    month = month_param(request.query)\n    return Response.ok(app.services[\"settlement\"].run(month))\n\n\ndef monthly_report(app, request):\n    month = month_param(request.query)\n    return Response.ok(app.services[\"reports\"].monthly(month))\n\n\ndef monthly_report_text(app, request):\n    month = month_param(request.query)\n    report = app.services[\"reports\"].monthly(month)\n    out = [f\"Expense report {month}\", \"-\" * 64]\n    for line in report[\"lines\"]:\n        out.append(\n            f\"{line['receipt']}  {line['date']}  {pad_display(line['memo'], 36)}\"\n            f\"{format_krw(line['amount']):>12}\"\n        )\n    out.append(\"-\" * 64)\n    out.append(f\"{report['entries']} entries{report['total_display']:>{64 - 10}}\")\n    return Response.ok({\"text\": \"\\n\".join(out)})\n====\n\"\"\"Runtime settings. Values can be overridden through build_app(**overrides).\"\"\"\nimport os\nfrom dataclasses import dataclass, field, replace\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef _default_ledger_bin():\n    return os.environ.get(\"HB_LEDGER_BIN\", os.path.join(_ROOT, \"vendor\", \"bin\", \"ledgerctl\"))\n\n\n@dataclass(frozen=True)\nclass Settings:\n    # vendor ledger CLI\n    ledger_bin: str = field(default_factory=_default_ledger_bin)\n    ledger_home: str = \"\"\n    ledger_timeout: float = 10.0\n    # claim form rules (expense portal screen spec v3)\n    description_max_chars: int = 30\n    claimant_max_chars: int = 10\n    max_amount: int = 5_000_000\n    # ledger memo column as agreed with the finance team\n    ledger_memo_chars: int = 40\n    # the ledger only books memos up to 48 UTF-8 bytes; longer ones are parked\n    ledger_memo_bytes: int = 48\n    # per-entry lookups (`show`) stay with the finance reconciliation desk\n    # since EXP-412; the desk's own tooling turns this on\n    ledger_show_allowed: bool = False\n    # category -> ledger account code\n    accounts: dict = field(default_factory=lambda: {\n        \"TRAVEL\": \"5110\",\n        \"MEAL\": \"5120\",\n        \"SUPPLIES\": \"5130\",\n        \"TRAINING\": \"5140\",\n        \"COMMS\": \"5150\",\n    })\n    report_cache_ttl: float = 60.0\n\n    def with_overrides(self, **overrides):\n        unknown = set(overrides) - set(self.__dataclass_fields__)\n        if unknown:\n            raise KeyError(f\"unknown settings: {sorted(unknown)}\")\n        return replace(self, **overrides)\n\n\nDEFAULTS = Settings()\n====\n\"\"\"Tiny TTL cache for computed reports.\"\"\"\nimport time\n\n\nclass TTLCache:\n    def __init__(self, ttl, clock=None):\n        self.ttl = ttl\n        self._clock = clock or time.monotonic\n        self._data = {}\n\n    def get(self, key):\n        item = self._data.get(key)\n        if item is None:\n            return None\n        stored_at, value = item\n        if self._clock() - stored_at > self.ttl:\n            del self._data[key]\n            return None\n        return value\n\n    def put(self, key, value):\n        self._data[key] = (self._clock(), value)\n\n    def invalidate(self, prefix=\"\"):\n        for key in [k for k in self._data if str(k).startswith(prefix)]:\n            del self._data[key]\n\n    def clear(self):\n        self._data.clear()\n====\n# 원장 벤더(ledgerctl) 운영 메모\n\n재무시스템팀 · 마지막 갱신 2025-05\n\n## 연락처\n- 벤더 기술지원: 평일 09–18시, 장애는 핫라인(사내 위키 \"원장 벤더\" 페이지).\n- 사내 담당: 재무시스템팀 원장 파트.\n\n## 저널 위치\n- 운영: `LEDGERCTL_HOME=/data/ledger` (서비스 계정만 쓰기).\n- 개발·테스트: 임시 디렉터리.\n\n## 월 정산서 항목 (계약서 부속 2 기준)\n| 항목 | 단위 |\n|---|---|\n| 기본료 | 월 고정 — post, list 포함 |\n| 단건 열람 | 호출 1회당 25원 |\n| 저널 보관 초과 | 10GB 단위 |\n\n## 정산서 이력\n- 2025-02분: 단건 열람 412,300회.\n- 2025-03분: 단건 열람 768,140회(1,920만 원). 발생 시스템 대부분 경비 포털. 재무 원장 파트 문의 → EXP-412.\n- 2025-04분 이후: 단건 열람 월 1천 회 안팎(대사 데스크).\n\n## 메모 길이\n- 메모 상한 UTF-8 48바이트(넘으면 보류). 2026-10 경비 정산 마감 건 참고.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DCLhrEuxScs1nP5Suq4w2S","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
