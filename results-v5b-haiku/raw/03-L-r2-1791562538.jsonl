{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PiwEk1Cpj6jQgYGdQLq9ji","type":"tool_result","content":"import { Channel, Order, OrderEventKind, formatOrderNo } from \"../domain/order\";\n\nexport interface PendingEvent {\n  orderNo: string;\n  customerId: string;\n  kind: OrderEventKind;\n  seq: number;\n}\n\nexport class OrderRepository {\n  private readonly orders = new Map<string, Order>();\n  /** 채널·제휴사·주문일별 일련번호 */\n  private readonly counters = new Map<string, number>();\n  private eventSeq = 0;\n\n  create(customerId: string, channel: Channel, placedOn: string, partner?: string): Order {\n    const counterKey = `${channel}|${partner ?? \"\"}|${placedOn}`;\n    const next = (this.counters.get(counterKey) ?? 0) + 1;\n    this.counters.set(counterKey, next);\n    const order: Order = {\n      orderNo: formatOrderNo(channel, placedOn, next, partner),\n      customerId,\n      channel,\n      partner,\n      placedOn,\n      events: [],\n    };\n    this.orders.set(order.orderNo, order);\n    return order;\n  }\n\n  find(orderNo: string): Order | undefined {\n    return this.orders.get(orderNo);\n  }\n\n  addEvent(orderNo: string, kind: OrderEventKind): number {\n    const order = this.orders.get(orderNo);\n    if (!order) throw new Error(\"order not found\");\n    const seq = ++this.eventSeq;\n    order.events.push({ kind, seq, dispatched: false });\n    return seq;\n  }\n\n  /** 회차에 실렸던 이벤트(주문·종류의 마지막 것)를 다음 회차에 다시 싣는다. */\n  requeue(orderNo: string, kind: OrderEventKind): boolean {\n    const order = this.orders.get(orderNo);\n    const e = order?.events.filter((x) => x.kind === kind && x.dispatched).pop();\n    if (!e) return false;\n    e.dispatched = false;\n    return true;\n  }\n\n  /** 아직 발송 회차에 실리지 않은 이벤트를 기록 순으로 꺼내고 실린 것으로 표시한다. */\n  takePending(): PendingEvent[] {\n    const out: PendingEvent[] = [];\n    for (const o of this.orders.values()) {\n      for (const e of o.events) {\n        if (e.dispatched) continue;\n        e.dispatched = true;\n        out.push({ orderNo: o.orderNo, customerId: o.customerId, kind: e.kind, seq: e.seq });\n      }\n    }\n    return out.sort((a, b) => a.seq - b.seq);\n  }\n}\nimport { spawnSync } from \"child_process\";\n\nexport interface WireMessage {\n  key: string;\n  payload: string;\n}\n\nexport interface PublishResult {\n  accepted: number;\n  batch: number;\n}\n\nexport interface ConsumedMessage {\n  offset: number;\n  key: string;\n  payload: string;\n}\n\nexport class MqpubError extends Error {\n  constructor(readonly code: string, readonly exitStatus: number | null) {\n    super(`mqpub ${code} (exit ${exitStatus})`);\n  }\n}\n\n/** 사내 메시지 발행 CLI(mqpub 3.x) 래퍼 */\nexport class MqpubClient {\n  constructor(private readonly bin: string, private readonly spoolDir: string) {}\n\n  private run(args: string[], input?: string): string {\n    const r = spawnSync(this.bin, args, {\n      input,\n      encoding: \"utf8\",\n      env: { ...process.env, MQPUB_SPOOL: this.spoolDir },\n    });\n    if (r.error) throw r.error;\n    if (r.status !== 0) {\n      const code = /E\\d+/.exec(r.stderr)?.[0] ?? \"E?\";\n      throw new MqpubError(code, r.status);\n    }\n    return r.stdout;\n  }\n\n  /** 메시지들을 한 배치로 발행한다. */\n  publish(topic: string, messages: WireMessage[]): PublishResult {\n    if (messages.length === 0) return { accepted: 0, batch: 0 };\n    const body = messages.map((m) => `${m.key}\\t${m.payload}`).join(\"\\n\") + \"\\n\";\n    const out = this.run([\"publish\", \"-t\", topic], body);\n    const m = /^accepted (\\d+) batch (\\d+)$/m.exec(out);\n    if (!m) throw new MqpubError(\"unparsed-output\", 0);\n    return { accepted: Number(m[1]), batch: Number(m[2]) };\n  }\n\n  /** offset 부터 끝까지 읽는다. */\n  consume(topic: string, fromOffset: number): ConsumedMessage[] {\n    const out = this.run([\"consume\", \"-t\", topic, \"-o\", String(fromOffset)]);\n    const rows: ConsumedMessage[] = [];\n    for (const line of out.split(\"\\n\")) {\n      if (line === \"\") continue;\n      const [off, key, ...rest] = line.split(\"\\t\");\n      rows.push({ offset: Number(off), key, payload: rest.join(\"\\t\") });\n    }\n    return rows;\n  }\n}\nimport { createHash } from \"crypto\";\nimport { OrderEventKind } from \"../domain/order\";\n\nconst KIND_CODE: Record<OrderEventKind, string> = {\n  PAID: \"paid\",\n  SHIPPED: \"ship\",\n  DELIVERED: \"dlvd\",\n};\n\n/**\n * 알림 메시지 키 — `<전체 키의 해시 16자>:<네임스페이스>.<이벤트>.<업무 식별자>`.\n * mqpub 는 한 배치 안에서 키의 앞 16바이트가 같은 메시지를 첫 것만 남기고 조용히 버린다.\n * 공통 접두로 시작하는 키는 서로 덮이므로, 메시지마다 다른 결정적 해시를 맨 앞에 둔다.\n * 소비 측은 이 키로 이미 처리한 메시지를 걸러낸다(재전달 대비) — 같은 알림은 늘 같은 키.\n */\nexport function messageKey(namespace: string, kind: OrderEventKind, orderNo: string): string {\n  const logical = `${namespace}.${KIND_CODE[kind]}.${orderNo}`;\n  const head = createHash(\"sha1\").update(logical).digest(\"hex\").slice(0, 16);\n  return `${head}:${logical}`;\n}\n\nexport function kindFromCode(code: string): OrderEventKind | undefined {\n  return (Object.keys(KIND_CODE) as OrderEventKind[]).find((k) => KIND_CODE[k] === code);\n}\nimport { Notification } from \"../domain/notification\";\nimport { isEventKind } from \"../domain/order\";\n\nconst VERSION = 2;\nconst MAX_PAYLOAD = 900;\n\ninterface WirePayload {\n  v: number;\n  o: string;\n  c: string;\n  k: string;\n}\n\n/** 탭·개행·제어문자는 와이어 형식(<key>TAB<payload>)을 깨므로 제거한다. */\nfunction scrub(s: string): string {\n  return s.replace(/[\\u0000-\\u001f\\u007f]/g, \"\");\n}\n\nexport function encodePayload(n: Notification): string {\n  const body: WirePayload = { v: VERSION, o: scrub(n.orderNo), c: scrub(n.customerId), k: n.kind };\n  const json = JSON.stringify(body);\n  if (json.length > MAX_PAYLOAD) throw new Error(\"payload too large\");\n  return json;\n}\n\nexport function decodePayload(raw: string): Notification | null {\n  let body: Partial<WirePayload>;\n  try {\n    body = JSON.parse(raw) as Partial<WirePayload>;\n  } catch {\n    return null;\n  }\n  if (body.v 