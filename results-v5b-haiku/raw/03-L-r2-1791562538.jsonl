{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018AgdNVAYTfGSFawiwt1Zep","type":"tool_result","content":"/**\n * 발송 실패한 알림 가운데 다음 회차에 다시 싣는 것.\n * 여기 든 사유로 실패한 알림은 이벤트를 미발송으로 되돌리고, 소비자도 그 키를 처리한 것으로 치지 않는다.\n * 그 밖의 실패는 회차 리포트의 '실패'로만 남는다.\n */\nconst RESEND_ON: ReadonlySet<string> = new Set<string>([\n  // TODO: 1.9.0부터 비어 있음. 재발송 기능째 걷어낼지, 아직 필요한지 확인 필요\n]);\n\nexport function shouldResend(reason: string): boolean {\n  return RESEND_ON.has(reason);\n}\nimport { DispatchRun } from \"../domain/notification\";\nimport { AlertPublisher } from \"../messaging/eventPublisher\";\nimport { AlertConsumer } from \"../notifier/consumerWorker\";\nimport { CustomerRepository } from \"../repository/customerRepository\";\nimport { DeliveryLogRepository } from \"../repository/deliveryLogRepository\";\nimport { OrderRepository } from \"../repository/orderRepository\";\nimport { planNotifications } from \"./notificationPlanner\";\nimport { shouldResend } from \"./resendPolicy\";\n\n/** 발송 회차: 미발송 이벤트 → 알림 계획 → 발행(1배치) → 소비·문자 발송 → (재발송 대상 되돌림) → 회차 기록 */\nexport class DispatchService {\n  private lastRunId = 0;\n\n  constructor(\n    private readonly orders: OrderRepository,\n    private readonly customers: CustomerRepository,\n    private readonly publisher: AlertPublisher,\n    private readonly consumer: AlertConsumer,\n    private readonly log: DeliveryLogRepository,\n  ) {}\n\n  runOnce(): DispatchRun {\n    const runId = ++this.lastRunId;\n    const events = this.orders.takePending();\n    const plan = planNotifications(events, this.customers);\n    const pub = this.publisher.publishRun(plan.notifications);\n    const drained = this.consumer.drain(runId);\n    for (const f of drained.failed) {\n      if (shouldResend(f.reason)) this.orders.requeue(f.orderNo, f.kind);\n    }\n    const run: DispatchRun = {\n      runId,\n      planned: plan.notifications,\n      skippedOptOut: plan.skippedOptOut,\n      published: pub.accepted,\n      batch: pub.batch,\n      delivered: drained.delivered,\n      failed: drained.failed,\n    };\n    this.log.saveRun(run);\n    return run;\n  }\n}\nimport { Notification } from \"../domain/notification\";\nimport { CustomerRepository } from \"../repository/customerRepository\";\nimport { PendingEvent } from \"../repository/orderRepository\";\n\nexport interface Plan {\n  notifications: Notification[];\n  skippedOptOut: number;\n}\n\n/**\n * 회차에 실린 주문 이벤트를 고객 알림으로 바꾼다.\n *  - 수신 거부 고객은 제외한다.\n *  - 같은 주문·같은 이벤트가 회차 안에 여러 번 기록됐으면(운영자 재입력 등) 한 번만 알린다.\n *  - 이벤트 기록 순서를 유지한다.\n */\nexport function planNotifications(events: PendingEvent[], customers: CustomerRepository): Plan {\n  const seen = new Set<string>();\n  const notifications: Notification[] = [];\n  let skippedOptOut = 0;\n  for (const e of [...events].sort((a, b) => a.seq - b.seq)) {\n    const customer = customers.find(e.customerId);\n    if (!customer || !customer.smsOptIn) {\n      skippedOptOut++;\n      continue;\n    }\n    const id = `${e.orderNo}#${e.kind}`;\n    if (seen.has(id)) continue;\n    seen.add(id);\n    notifications.push({ orderNo: e.orderNo, customerId: e.customerId, kind: e.kind });\n  }\n  return { notifications, skippedOptOut };\n}\n----\nimport { join } from \"path\";\n\nexport interface AppConfig {\n  /** 고객 알림 토픽 */\n  topic: string;\n  /** 사내 메시지 키 네임스페이스 */\n  keyNamespace: string;\n  /** mqpub 실행 파일 경로 */\n  mqpubBin: string;\n  /** mqpub 스풀 디렉토리(MQPUB_SPOOL) */\n  spoolDir: string;\n  /** 문자 발신 번호 */\n  senderId: string;\n  /** 한 번에 읽어 올 최대 메시지 수 */\n  drainLimit: number;\n  /** 모의 문자 게이트웨이 장애 주입(개발·스테이징): 번호별로 차례대로 돌려줄 실패 코드 */\n  smsFaults: Record<string, string[]>;\n}\n\nexport function loadConfig(overrides: Partial<AppConfig> = {}): AppConfig {\n  const env = process.env;\n  const base: AppConfig = {\n    topic: env.ALERTS_TOPIC ?? \"alerts.order\",\n    keyNamespace: env.ALERTS_KEY_NS ?? \"ntf\",\n    mqpubBin: env.MQPUB_BIN ?? join(process.cwd(), \"vendor\", \"bin\", \"mqpub\"),\n    spoolDir: env.MQPUB_SPOOL ?? join(process.cwd(), \"var\", \"spool\"),\n    senderId: \"1588-0000\",\n    drainLimit: 500,\n    smsFaults: {},\n  };\n  return { ...base, ...overrides };\n}\nimport { createHash } from \"crypto\";\nimport { normalizeMobile } from \"../util/format\";\n\nexport interface SmsReceipt {\n  ok: boolean;\n  receiptId?: string;\n  reason?: string;\n}\n\nexport interface SmsGateway {\n  send(from: string, to: string, text: string): SmsReceipt;\n}\n\n/**\n * 문자 대행사 실패 응답 코드\n *   invalid-number  수신 번호 형식 오류(우리 쪽 검증)\n *   empty-body      본문 없음(우리 쪽 검증)\n *   E-THROTTLE      초당 발송 한도 초과\n *   E-CARRIER       통신사 일시 반려\n *   E-SPAM          통신사 스팸 차단(수신자 설정)\n */\nexport type SmsFailure = \"invalid-number\" | \"empty-body\" | \"E-THROTTLE\" | \"E-CARRIER\" | \"E-SPAM\";\n\n/**\n * 문자 대행사 모의 게이트웨이 — 받은 문자를 번호별 수신함에 쌓는다.\n * faults: 번호(숫자 11자리)별로 다음 발송 시도들에 차례대로 돌려줄 실패 코드.\n */\nexport class InMemorySmsGateway implements SmsGateway {\n  private readonly inboxes = new Map<string, string[]>();\n  private readonly tries = new Map<string, number>();\n  private readonly faults = new Map<string, string[]>();\n  private sent = 0;\n\n  constructor(faults: Record<string, string[]> = {}) {\n    for (const [raw, codes] of Object.entries(faults)) {\n      const number = normalizeMobile(raw);\n      if (number) this.faults.set(number, [...codes]);\n    }\n  }\n\n  send(from: string, to: string, text: string): SmsReceipt {\n    const number = normalizeMobile(to);\n    if (!number) return { ok: false, reason: \"invalid-number\" };\n    if (text.length === 0) return { ok: false, reason: \"empty-body\" };\n    this.tries.set(number, (this.tries.get(number) ?? 0) + 1);\n    const fault = this.faults.get(number)?.shift();\n    if (fault) return { ok: false, reason: fault };\n    this.sent++;\n    const list = this.inboxes.get(number) ?? [];\n    list.push(text);\n    this.inboxes.set(number, list);\n    const receiptId = createHash(\"sha1\").update(`${from}|${number}|${this.sent}|${text}`).digest(\"hex\").slice(0, 12);\n    return { ok: true, receiptId };\n  }\n\n  inbox(phone: string): string[] {\n    const number = normalizeMobile(phone);\n    return number ? [...(this.inboxes.get(number) ?? [])] : [];\n  }\n\n  /** 대행사에 넘긴 발송 요청 수(성공·실패 포함) */\n  attempts(phone: string): number {\n    const number = normalizeMobile(phone);\n    return number ? this.tries.get(number) ?? 0 : 0;\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"d4128a96-6501-4260-bf91-9210c9dcad84","uuid":"24a9910c-d223-456c-a04c-066b7bf1eb19","timestamp":"2026-10-09T16:15:44.850Z","tool_use_result":{"stdout":"/**\n * 발송 실패한 알림 가운데 다음 회차에 다시 싣는 것.\n * 여기 든 사유로 실패한 알림은 이벤트를 미발송으로 되돌리고, 소비자도 그 키를 처리한 것으로 치지 않는다.\n * 그 밖의 실패는 회차 리포트의 '실패'로만 남는다.\n */\nconst RESEND_ON: ReadonlySet<string> = new Set<string>([\n  // TODO: 1.9.0부터 비어 있음. 재발송 기능째 걷어낼지, 아직 필요한지 확인 필요\n]);\n\nexport function shouldResend(reason: string): boolean {\n  return RESEND_ON.has(reason);\n}\nimport { DispatchRun } from \"../domain/notification\";\nimport { AlertPublisher } from \"../messaging/eventPublisher\";\nimport { AlertConsumer } from \"../notifier/consumerWorker\";\nimport { CustomerRepository } from \"../repository/customerRepository\";\nimport { DeliveryLogRepository } from \"../repository/deliveryLogRepository\";\nimport { OrderRepository } from \"../repository/orderRepository\";\nimport { planNotifications } from \"./notificationPlanner\";\nimport { shouldResend } from \"./resendPolicy\";\n\n/** 발송 회차: 미발송 이벤트 → 알림 계획 → 발행(1배치) → 소비·문자 발송 → (재발송 대상 되돌림) → 회차 기록 */\nexport class DispatchService {\n  private lastRunId = 0;\n\n  constructor(\n    private readonly orders: OrderRepository,\n    private readonly customers: CustomerRepository,\n    private readonly publisher: AlertPublisher,\n    private readonly consumer: AlertConsumer,\n    private readonly log: DeliveryLogRepository,\n  ) {}\n\n  runOnce(): DispatchRun {\n    const runId = ++this.lastRunId;\n    const events = 