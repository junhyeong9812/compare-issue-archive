ys\";\nimport { MqpubClient, PublishResult, WireMessage } from \"./mqpubClient\";\nimport { encodePayload } from \"./payloadCodec\";\n\n/** 발송 회차 하나의 알림을 한 배치로 발행한다(회차 단위 순서·원자성). */\nexport class AlertPublisher {\n  constructor(\n    private readonly client: MqpubClient,\n    private readonly topic: string,\n    private readonly keyNamespace: string,\n  ) {}\n\n  toWire(n: Notification): WireMessage {\n    return { key: messageKey(this.keyNamespace, n.kind, n.orderNo), payload: encodePayload(n) };\n  }\n\n  publishRun(notifications: Notification[]): PublishResult {\n    return this.client.publish(this.topic, notifications.map((n) => this.toWire(n)));\n  }\n}\nimport { createHash } from \"crypto\";\nimport { OrderEventKind } from \"../domain/order\";\n\nconst KIND_CODE: Record<OrderEventKind, string> = {\n  PAID: \"paid\",\n  SHIPPED: \"ship\",\n  DELIVERED: \"dlvd\",\n};\n\n/**\n * 알림 메시지 키 — `<전체 키의 해시 16자>:<네임스페이스>.<이벤트>.<업무 식별자>`.\n * mqpub 는 한 배치 안에서 키의 앞 16바이트가 같은 메시지를 첫 것만 남기고 조용히 버린다.\n * 공통 접두로 시작하는 키는 서로 덮이므로, 메시지마다 다른 결정적 해시를 맨 앞에 둔다.\n * 소비 측은 이 키로 이미 처리한 메시지를 걸러낸다(재전달 대비) — 같은 알림은 늘 같은 키.\n */\nexport function messageKey(namespace: string, kind: OrderEventKind, orderNo: string): string {\n  const logical = `${namespace}.${KIND_CODE[kind]}.${orderNo}`;\n  const head = createHash(\"sha1\").update(logical).digest(\"hex\").slice(0, 16);\n  return `${head}:${logical}`;\n}\n\nexport function kindFromCode(code: string): OrderEventKind | undefined {\n  return (Object.keys(KIND_CODE) as OrderEventKind[]).find((k) => KIND_CODE[k] === code);\n}\nimport { spawnSync } from \"child_process\";\n\nexport interface WireMessage {\n  key: string;\n  payload: string;\n}\n\nexport interface PublishResult {\n  accepted: number;\n  batch: number;\n}\n\nexport interface ConsumedMessage {\n  offset: number;\n  key: string;\n  payload: string;\n}\n\nexport class MqpubError extends Error {\n  constructor(readonly code: string, readonly exitStatus: number | null) {\n    super(`mqpub ${code} (exit ${exitStatus})`);\n  }\n}\n\n/** 사내 메시지 발행 CLI(mqpub 3.x) 래퍼 */\nexport class MqpubClient {\n  constructor(private readonly bin: string, private readonly spoolDir: string) {}\n\n  private run(args: string[], input?: string): string {\n    const r = spawnSync(this.bin, args, {\n      input,\n      encoding: \"utf8\",\n      env: { ...process.env, MQPUB_SPOOL: this.spoolDir },\n    });\n    if (r.error) throw r.error;\n    if (r.status !== 0) {\n      const code = /E\\d+/.exec(r.stderr)?.[0] ?? \"E?\";\n      throw new MqpubError(code, r.status);\n    }\n    return r.stdout;\n  }\n\n  /** 메시지들을 한 배치로 발행한다. */\n  publish(topic: string, messages: WireMessage[]): PublishResult {\n    if (messages.length === 0) return { accepted: 0, batch: 0 };\n    const body = messages.map((m) => `${m.key}\\t${m.payload}`).join(\"\\n\") + \"\\n\";\n    const out = this.run([\"publish\", \"-t\", topic], body);\n    const m = /^accepted (\\d+) batch (\\d+)$/m.exec(out);\n    if (!m) throw new MqpubError(\"unparsed-output\", 0);\n    return { accepted: Number(m[1]), batch: Number(m[2]) };\n  }\n\n  /** offset 부터 끝까지 읽는다. */\n  consume(topic: string, fromOffset: number): ConsumedMessage[] {\n    const out = this.run([\"consume\", \"-t\", topic, \"-o\", String(fromOffset)]);\n    const rows: ConsumedMessage[] = [];\n    for (const line of out.split(\"\\n\")) {\n      if (line === \"\") continue;\n      const [off, key, ...rest] = line.split(\"\\t\");\n      rows.push({ offset: Number(off), key, payload: rest.join(\"\\t\") });\n    }\n    return rows;\n  }\n}\nimport { Notification } from \"../domain/notification\";\nimport { isEventKind } from \"../domain/order\";\n\nconst VERSION = 2;\nconst MAX_PAYLOAD = 900;\n\ninterface WirePayload {\n  v: number;\n  o: string;\n  c: string;\n  k: string;\n}\n\n/** 탭·개행·제어문자는 와이어 형식(<key>TAB<payload>)을 깨므로 제거한다. */\nfunction scrub(s: string): string {\n  return s.replace(/[\\u0000-\\u001f\\u007f]/g, \"\");\n}\n\nexport function encodePayload(n: Notification): string {\n  const body: WirePayload = { v: VERSION, o: scrub(n.orderNo), c: scrub(n.customerId), k: n.kind };\n  const json = JSON.stringify(body);\n  if (json.length > MAX_PAYLOAD) throw new Error(\"payload too large\");\n  return json;\n}\n\nexport function decodePayload(raw: string): Notification | null {\n  let body: Partial<WirePayload>;\n  try {\n    body = JSON.parse(raw) as Partial<WirePayload>;\n  } catch {\n    return null;\n  }\n  if (body.v !== VERSION && body.v !== 1) return null;\n  if (typeof body.o !== \"string\" || typeof body.c !== \"string\" || !isEventKind(body.k)) return null;\n  return { orderNo: body.o, customerId: body.c, kind: body.k };\n}\nimport { OrderEventKind } from \"./order\";\n\n/** 고객에게 보낼 알림 1건 */\nexport interface Notification {\n  orderNo: string;\n  customerId: string;\n  kind: OrderEventKind;\n}\n\n/** 발송 회차 결과 */\nexport interface DispatchRun {\n  runId: number;\n  planned: Notification[];\n  skippedOptOut: number;\n  published: number;\n  batch: number;\n  delivered: DeliveredAlert[];\n  failed: { orderNo: string; kind: OrderEventKind; reason: string }[];\n}\n\nexport interface DeliveredAlert {\n  runId: number;\n  orderNo: string;\n  customerId: string;\n  kind: OrderEventKind;\n  phone: string;\n  receiptId: string;\n}\n\nexport const KIND_LABEL: Record<OrderEventKind, string> = {\n  PAID: \"결제 완료\",\n  SHIPPED: \"배송 시작\",\n  DELIVERED: \"배송 완료\",\n};","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CCq1XEEaqgiKtVFdXUqCUA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
