{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y2nhqdmKdb6hzFCQVHpXBw","type":"tool_result","content":"\"\"\"Market sync: pushes the market quantity of every changed product to the vendor.\"\"\"\nfrom hbstock.market.feed import build_feed\n\n\nclass SyncService:\n    def __init__(self, repo, client, settings, on_synced=None):\n        self.repo = repo\n        self.client = client\n        self.settings = settings\n        self.on_synced = on_synced\n        self.last_sent = {}\n\n    def run(self, full=False):\n        skus = [p.sku for p in self.repo.products()] if full else self.repo.take_dirty()\n        if full:\n            self.repo.take_dirty()\n        products = [self.repo.product(sku) for sku in skus]\n        lines, sent = build_feed(products, self.settings)\n        # nothing to tell the market about a product whose announced quantity did not move\n        changed = [line for line, sku in zip(lines, sent) if full or self.last_sent.get(sku) != sent[sku]]\n        if not changed:\n            return {\"transfer\": None, \"lines\": 0, \"skus\": []}\n        transfer = self.client.push(changed)\n        pushed = [line.split(\"\\t\", 1)[0] for line in changed]\n        for sku in pushed:\n            self.last_sent[sku] = sent[sku]\n        if self.on_synced:\n            self.on_synced()\n        return {\"transfer\": transfer.transfer_id, \"lines\": transfer.lines, \"skus\": pushed}\n\"\"\"What the open market should show for each product, as stock feed lines.\"\"\"\n\n\ndef market_qty(product, settings):\n    \"\"\"Units we offer on the market: free stock minus the CS safety units.\"\"\"\n    return max(product.available - settings.market_safety_stock, 0)\n\n\ndef feed_line(sku, qty):\n    return f\"{sku}\\t{int(qty)}\"\n\n\ndef build_feed(products, settings):\n    \"\"\"Feed lines plus the quantity each line announces, keyed by SKU.\"\"\"\n    lines, sent = [], {}\n    for product in products:\n        qty = market_qty(product, settings)\n        lines.append(feed_line(product.sku, qty))\n        sent[product.sku] = qty\n    return [line for line in lines if line], sent\n\"\"\"Thin wrapper around the open-market stock sync CLI (vendor/bin/stockpush).\"\"\"\nimport os\nimport subprocess\nimport tempfile\n\nfrom hbstock.models import MarketRow, Transfer, VendorError\n\n\nclass StockpushClient:\n    def __init__(self, settings):\n        self.binary = settings.stockpush_bin\n        self.home = settings.stockpush_home or os.environ.get(\"STOCKPUSH_HOME\", \"\")\n        self.timeout = settings.stockpush_timeout\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"STOCKPUSH_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise VendorError(code, args[0])\n        return proc.stdout\n\n    def push(self, lines):\n        fd, path = tempfile.mkstemp(prefix=\"stockpush-\", suffix=\".tsv\")\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                f.write(\"\\n\".join(lines) + \"\\n\")\n            out = self._run(\"push\", \"--in\", path)\n        finally:\n            os.unlink(path)\n        transfer_id, _, count = out.strip().partition(\"\\t\")\n        if not transfer_id.startswith(\"T\") or not count.isdigit() or int(count) != len(lines):\n            raise VendorError(\"E??\", \"push\")\n        return Transfer(transfer_id, int(count))\n\n    def rows(self):\n        rows = []\n        for line in self._run(\"list\").splitlines():\n            parts = line.split(\"\\t\")\n            if len(parts) != 4 or not parts[1].isdigit():\n                continue\n            sku, qty, st, transfer = parts\n            rows.append(MarketRow(sku, int(qty), int(st), transfer))\n        return rows\n\n    def show(self, sku):\n        out = self._run(\"show\", sku)\n        info = dict(line.split(\" \", 1) for line in out.splitlines() if \" \" in line)\n        return MarketRow(info[\"sku\"], int(info[\"qty\"]), int(info[\"st\"]), info[\"transfer\"])\n\"\"\"SKU codes: two letters, a dash, three to five digits (GD-104, VC-20031).\"\"\"\nimport re\n\n_SKU = re.compile(r\"^[A-Z]{2}-\\d{3,5}$\")\n\n\ndef normalize_sku(raw):\n    return str(raw or \"\").strip().upper().replace(\"_\", \"-\")\n\n\ndef is_sku(value):\n    return bool(_SKU.match(value or \"\"))\n\n\ndef parse_qty(raw, allow_zero=False):\n    \"\"\"Whole units only; '3', 3 and '03' are fine, '2.5' and '-1' are not.\"\"\"\n    try:\n        value = int(str(raw).strip())\n    except (TypeError, ValueError):\n        raise ValueError(\"quantity must be a whole number\") from None\n    if value < 0 or (value == 0 and not allow_zero):\n        raise ValueError(\"quantity out of range\")\n    return value\n\"\"\"Warehouse side: catalog entries, goods received, stock counts.\"\"\"\nfrom hbstock.models import Product\nfrom hbstock.util.sku import is_sku, normalize_sku, parse_qty\n\n\nclass InventoryService:\n    def __init__(self, repo, settings):\n        self.repo = repo\n        self.settings = settings\n\n    def create(self, payload):\n        sku = normalize_sku(payload.get(\"sku\"))\n        if not is_sku(sku):\n            raise ValueError(\"sku must look like GD-104\")\n        name = str(payload.get(\"name\", \"\")).strip()\n        if not name:\n            raise ValueError(\"name is required\")\n        category = str(payload.get(\"category\", \"goods\")).strip().lower()\n        if category not in self.settings.categories:\n            raise ValueError(f\"unknown category {category}\")\n        price = parse_qty(payload.get(\"price\"))\n        on_hand = parse_qty(payload.get(\"on_hand\", 0), allow_zero=True)\n        product = Product(sku=sku, name=name, category=category, price=price, on_hand=on_hand)\n        self.repo.add_product(product)\n        self.repo.log(sku, \"create\", on_hand)\n        return product\n\n    def receive(self, sku, qty):\n        product = self.repo.product(normalize_sku(sku))\n        qty = parse_qty(qty)\n        product.on_hand += qty\n        self.repo.log(product.sku, \"receive\", qty)\n        return product\n\n    def count(self, sku, counted):\n        \"\"\"Stock count: the shelf wins over the books.\"\"\"\n        product = self.repo.product(normalize_sku(sku))\n        counted = parse_qty(counted, allow_zero=True)\n        delta = counted - product.on_hand\n        product.on_hand = counted\n        self.repo.log(product.sku, \"count\", delta)\n        return product","is_error":false}]},"parent_tool_use_id":null,"session_id":"e2fcb63d-21fc-45f3-b18b-2a2eb2cdaa49","uuid":"83ad4b04-aef5-4544-80d2-96de6c58e869","timestamp":"2026-10-08T18:21:46.956Z","tool_use_result":{"stdout":"\"\"\"Market sync: pushes the market quantity of every changed product to the vendor.\"\"\"\nfrom hbstock.market.feed import build_feed\n\n\nclass SyncService:\n    def __init__(self, repo, client, settings, on_synced=None):\n        self.repo = repo\n        self.client = client\n        self.settings = settings\n        self.on_synced = on_synced\n        self.last_sent = {}\n\n    def run(self, full=False):\n        skus = [p.sku for p in self.repo.products()] if full else self.repo.take_dirty()\n        if full:\n            self.repo.take_dirty()\n        products = [self.repo.product(sku) for sku in skus]\n        lines, sent = build_feed(products, self.settings)\n        # nothing to tell the market about a product whose announced quantity did not move\n        changed = [line for line, sku in zip(lines, sent) if full or self.last_sent.get(sku) != sent[sku]]\n        if not changed:\n            return {\"transfer\": None, \"lines\": 0, \"skus\"