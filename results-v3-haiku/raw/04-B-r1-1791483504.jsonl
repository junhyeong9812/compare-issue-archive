AIL\"\n  [ \"$T_FAIL\" -eq 0 ]\n}\n----\n#!/usr/bin/env bash\n# A week of daily runs (2026-10-01..07); partners must be able to download\n# every day's settlement.\n. \"$(dirname \"$0\")/lib.sh\"\nt_setup\n\nfor d in 20261001 20261002 20261003 20261004 20261005 20261006 20261007; do\n  payout run \"$d\" 2>>\"$T_WORK/run.err\"; rc=$?\n  assert_rc \"daily run $d completes\" \"$rc\" 0\n  assert_contains \"run $d got transfer tickets\" \"$(payout manifest \"$d\")\" \" T0\"\ndone\n\nexpect_day() {  # report date rows net\n  local line\n  line=$(printf '%s\\n' \"$1\" | grep \"^$2 \")\n  assert_contains \"partner can download $2 settlement ($3 rows)\" \"$line\" \"$2  $(printf '%4d' \"$3\")\"\n  assert_contains \"partner total for $2\" \"$line\" \"$4\"\n}\n\nr1=$(payout receipts P001 20261001 20261007)\nprintf '%s\\n' \"$r1\"\nexpect_day \"$r1\" 2026-10-01 12 \"2,829,356\"\nexpect_day \"$r1\" 2026-10-02 26 \"5,363,775\"\nexpect_day \"$r1\" 2026-10-03  9 \"1,817,402\"\nexpect_day \"$r1\" 2026-10-04  7 \"1,501,892\"\nexpect_day \"$r1\" 2026-10-05 31 \"6,257,753\"\nexpect_day \"$r1\" 2026-10-06 14 \"3,937,833\"\nexpect_day \"$r1\" 2026-10-07 18 \"4,705,841\"\n\nr3=$(payout receipts P003 20261001 20261007)\nexpect_day \"$r3\" 2026-10-02 3 \"728,033\"\nexpect_day \"$r3\" 2026-10-05 2 \"195,293\"\n\nr4=$(payout receipts P004 20261001 20261007)\nassert_eq \"suspended partner gets nothing\" \"$(printf '%s\\n' \"$r4\" | grep -c ' - ')\" 7\nt_done\n----\n#!/usr/bin/env bash\n. \"$(dirname \"$0\")/lib.sh\"\nt_setup\nt_source_libs\n\nseq 1 45 > \"$T_WORK/rows\"\nassert_eq \"45 rows at 20 per file -> 3 parts\" \"$(chunk_rows \"$T_WORK/rows\" 20 \"$T_WORK/a\")\" 3\nassert_eq \"first part full\"  \"$(wc -l < \"$T_WORK/a.01\" | tr -d ' ')\" 20\nassert_eq \"second part full\" \"$(wc -l < \"$T_WORK/a.02\" | tr -d ' ')\" 20\nassert_eq \"last part rest\"   \"$(wc -l < \"$T_WORK/a.03\" | tr -d ' ')\" 5\nassert_eq \"no row lost\"      \"$(cat \"$T_WORK\"/a.0? | tail -1)\" 45\n\nseq 1 20 > \"$T_WORK/rows20\"\nassert_eq \"exactly at the limit -> 1 part\" \"$(chunk_rows \"$T_WORK/rows20\" 20 \"$T_WORK/b\")\" 1\n\n: > \"$T_WORK/empty\"\nassert_eq \"empty day still yields a part\" \"$(chunk_rows \"$T_WORK/empty\" 20 \"$T_WORK/c\")\" 1\nassert_eq \"empty part is empty\" \"$(wc -c < \"$T_WORK/c.01\" | tr -d ' ')\" 0\nt_done\n----\n#!/usr/bin/env bash\n. \"$(dirname \"$0\")/lib.sh\"\nt_setup\nt_source_libs\n\nbody=$(printf 'M001\\t10000\\t250\\nM002\\t5500\\t137\\n' | csv_render 20261005 P002 1 1)\nassert_contains \"header names sender, partner, day and part\" \"$body\" \"H,HBP,P002,20261005,1/1\"\nassert_contains \"detail carries net amount\" \"$body\" \"D,M001,20261005,10000,250,9750\"\nassert_contains \"trailer counts and totals\" \"$body\" \"T,2,15113\"\nassert_eq \"lines end in CRLF\" \"$(printf '%s\\n' \"$body\" | head -1 | tr -d '\\n' | tail -c 1 | od -An -c | tr -d ' ')\" '\\r'\nassert_eq \"one file for a normal day\" \"$(settle_name P002 20261005 1 1)\" \"HBP_SETTLE_P002_20261005.csv\"\nt_done\n----\n# settle_date^Ipartner^Itxn^Iamount^Ifee  (card acquiring extract, KRW)$\n20261001^IP001^IM001010001^I37600^I940$\n20261001^IP001^IM001010002^I21800^I545$\n20261001^IP001^IM001010003^I338100^I8452$\n20261001^IP001^IM001010004^I355700^I8892$\n20261001^IP001^IM001010005^I283800^I7095$\n20261001^IP001^IM001010006^I295200^I7380$\n20261001^IP001^IM001010007^I451600^I11290$\n20261001^IP001^IM001010008^I120500^I3012$\n20261001^IP001^IM001010009^I245500^I6137$\n20261001^IP001^IM001010010^I389300^I9732$\n20261001^IP001^IM001010011^I208100^I5202$\n20261001^IP001^IM001010012^I154700^I3867$\n20261001^IP002^IM002010001^I333200^I8330$\n20261001^IP002^IM002010002^I177400^I4435$\n20261001^IP002^IM002010003^I221100^I5527$\n20261001^IP002^IM002010004^I214400^I5360$\n20261001^IP003^IM003010001^I187500^I4687$\n20261001^IP003^IM003010002^I126800^I3170$\n20261001^IP004^IM004010001^I460400^I11510$\n----\nELF\u0002\u0001\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u