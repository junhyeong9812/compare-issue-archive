() { return refundNo; }\n    44\t\n    45\t    public void submitted(String batchId) {\n    46\t        this.status = Status.SUBMITTED;\n    47\t        this.batchId = batchId;\n    48\t    }\n    49\t\n    50\t    public void done(String refundNo) {\n    51\t        this.status = Status.DONE;\n    52\t        this.refundNo = refundNo;\n    53\t    }\n    54\t\n    55\t    @Override\n    56\t    public String toString() {\n    57\t        return requestId + \"/\" + orderNo + \"#\" + lineNo + \" \" + amount + \" \" + status;\n    58\t    }\n    59\t}\n=== src/domain/OrderLine.java\n     1\tpackage domain;\n     2\t\n     3\t/** One unit of a product in an order. Quantity is always 1: two of the same product are two lines. */\n     4\tpublic record OrderLine(int lineNo, String sku, String name, long price, long discount) {\n     5\t    public long paid() {\n     6\t        return price - discount;\n     7\t    }\n     8\t}\n=== src/domain/Order.java\n     1\tpackage domain;\n     2\t\n     3\timport java.util.List;\n     4\t\n     5\tpublic record Order(String orderNo, String customerId, String tid, List<OrderLine> lines, long coupon) {\n     6\t    public long paidTotal() {\n     7\t        return lines.stream().mapToLong(OrderLine::paid).sum();\n     8\t    }\n     9\t\n    10\t    public OrderLine line(int lineNo) {\n    11\t        return lines.stream().filter(l -> l.lineNo() == lineNo).findFirst()\n    12\t                .orElseThrow(() -> new IllegalArgumentException(\"no line \" + lineNo + \" in \" + orderNo));\n    13\t    }\n    14\t}\n=== src/api/RefundDeskApi.java\n     1\tpackage api;\n     2\t\n     3\timport config.AppConfig;\n     4\timport domain.CatalogItem;\n     5\timport domain.CustomerStatement;\n     6\timport domain.Order;\n     7\timport domain.RefundLine;\n     8\timport domain.RunResult;\n     9\timport infra.CatalogLoader;\n    10\timport infra.PgsimClient;\n    11\timport service.CheckoutService;\n    12\timport service.CustomerStatementService;\n    13\timport service.RefundBatchJob;\n    14\timport service.RefundService;\n    15\timport store.OrderRepository;\n    16\timport store.RefundRepository;\n    17\t\n    18\timport java.time.LocalDate;\n    19\timport java.util.List;\n    20\timport java.util.Map;\n    21\t\n    22\t/** Facade used by the CS console, the nightly scheduler and the tests. */\n    23\tpublic class RefundDeskApi {\n    24\t    private final CheckoutService checkout;\n    25\t    private final RefundService refundService;\n    26\t    private final RefundBatchJob batchJob;\n    27\t    private final CustomerStatementService statements;\n    28\t    private final RefundRepository refunds;\n    29\t\n    30\t    public RefundDeskApi(AppConfig cfg) {\n    31\t        Map<String, CatalogItem> catalog = CatalogLoader.load(cfg.catalogFile());\n    32\t        PgsimClient pg = new PgsimClient(cfg.pgBin(), cfg.pgHome(), cfg.pgTimeoutSeconds());\n    33\t        OrderRepository orders = new OrderRepository();\n    34\t        this.refunds = new RefundRepository();\n    35\t        this.checkout = new CheckoutService(catalog, orders, pg, cfg.merchantId());\n    36\t        this.refundService = new RefundService(orders, refunds);\n    37\t        this.batchJob = new RefundBatchJob(refunds, pg, cfg.merchantId(), cfg.batchPrefix(),\n    38\t                cfg.maxLinesPerBatch(), cfg.workDir());\n    39\t        this.statements = new CustomerStatementService(orders, refunds, pg);\n    40\t    }\n    41\t\n    42\t    public Order placeOrder(String customerId, List<String> skus, long coupon, LocalDate day) {\n    43\t        return checkout.place(customerId, skus, coupon, day);\n    44\t    }\n    45\t\n    46\t    public String requestRefund(String orderNo, List<Integer> lineNos, LocalDate day) {\n    47\t        return refundService.request(orderNo, lineNos, day);\n    48\t    }\n    49\t\n    50\t    public RunResult runRefunds(LocalDate day) {\n    51\t        return batchJob.run(day);\n