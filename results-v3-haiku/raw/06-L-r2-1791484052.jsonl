{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KCDofDMVoeYu7nY8LwV6Vq","type":"tool_result","content":"=== src/infra/PgsimClient.java\n     1\tpackage infra;\n     2\t\n     3\timport java.io.IOException;\n     4\timport java.io.InputStream;\n     5\timport java.nio.charset.StandardCharsets;\n     6\timport java.nio.file.Files;\n     7\timport java.nio.file.Path;\n     8\timport java.util.ArrayList;\n     9\timport java.util.HashMap;\n    10\timport java.util.List;\n    11\timport java.util.Map;\n    12\timport java.util.concurrent.TimeUnit;\n    13\t\n    14\t/** Thin wrapper around the PG vendor CLI (vendor/bin/pgsim). One process per call. */\n    15\tpublic class PgsimClient {\n    16\t    /** What the PG reports for one payment. */\n    17\t    public record Txn(String tid, long amount, long refunded, long balance) {}\n    18\t\n    19\t    /** One row of a PG batch status: refund number, TID, amount, merchant field. */\n    20\t    public record RefundRow(String refundNo, String tid, long amount, String aux) {}\n    21\t\n    22\t    private final Path bin;\n    23\t    private final Path home;\n    24\t    private final long timeoutSeconds;\n    25\t\n    26\t    public PgsimClient(Path bin, Path home, long timeoutSeconds) {\n    27\t        this.bin = bin;\n    28\t        this.home = home;\n    29\t        this.timeoutSeconds = timeoutSeconds;\n    30\t    }\n    31\t\n    32\t    /** Charges the customer; returns the PG transaction id. */\n    33\t    public String pay(String mid, long amount, String orderNo) {\n    34\t        return run(List.of(\"pay\", \"--mid\", mid, \"--amt\", Long.toString(amount), \"--oid\", orderNo)).strip();\n    35\t    }\n    36\t\n    37\t    /** Submits one refund batch file; returns the accepted count reported by the PG. */\n    38\t    public int refund(String mid, String batchId, Path file) {\n    39\t        String out = run(List.of(\"refund\", \"--mid\", mid, \"--batch\", batchId, file.toString())).strip();\n    40\t        String[] t = out.split(\"\\\\s+\");\n    41\t        if (t.length != 2 || !t[0].equals(\"accepted\")) {\n    42\t            throw new PgException(\"unexpected refund reply: \" + out);\n    43\t        }\n    44\t        return Integer.parseInt(t[1]);\n    45\t    }\n    46\t\n    47\t    public List<RefundRow> status(String batchId) {\n    48\t        List<RefundRow> rows = new ArrayList<>();\n    49\t        for (String line : run(List.of(\"status\", \"--batch\", batchId)).split(\"\\n\")) {\n    50\t            if (line.isBlank()) continue;\n    51\t            String[] f = line.split(\"\\t\");\n    52\t            if (f.length != 4) throw new PgException(\"unexpected status line: \" + line);\n    53\t            rows.add(new RefundRow(f[0], f[1], Long.parseLong(f[2]), f[3].equals(\"-\") ? \"\" : f[3]));\n    54\t        }\n    55\t        return rows;\n    56\t    }\n    57\t\n    58\t    public Txn txn(String tid) {\n    59\t        Map<String, String> kv = new HashMap<>();\n    60\t        for (String line : run(List.of(\"txn\", tid)).split(\"\\n\")) {\n    61\t            int sp = line.indexOf(' ');\n    62\t            if (sp > 0) kv.put(line.substring(0, sp), line.substring(sp + 1).strip());\n    63\t        }\n    64\t        return new Txn(kv.get(\"tid\"), Long.parseLong(kv.get(\"amt\")), Long.parseLong(kv.get(\"refunded\")),\n    65\t                Long.parseLong(kv.get(\"bal\")));\n    66\t    }\n    67\t\n    68\t    private String run(List<String> args) {\n    69\t        List<String> cmd = new ArrayList<>();\n    70\t        cmd.add(bin.toString());\n    71\t        cmd.addAll(args);\n    72\t        try {\n    73\t            Files.createDirectories(home);\n    74\t            ProcessBuilder pb = new ProcessBuilder(cmd);\n    75\t            pb.environment().put(\"PGSIM_HOME\", home.toAbsolutePath().toString());\n    76\t            Process p = pb.start();\n    77\t            byte[] out;\n    78\t            byte[] err;\n    79\t            try (InputStream o = p.getInputStream(); InputStream e = p.getErrorStream()) {\n    80\t                out = o.readAllBytes();\n    81\t                err = e.readAllBytes();\n    82\t            }\n    83\t            if (!p.waitFor(timeoutSeconds, TimeUnit.SECONDS)) {\n    84\t                p.destroyForcibly();\n    85\t                throw new PgException(\"timeout: \" + String.join(\" \", cmd));\n    86\t            }\n    87\t            if (p.exitValue() != 0) {\n    88\t                throw new PgException(\"pgsim failed [\" + new String(err, StandardCharsets.UTF_8).strip() + \"]: \"\n    89\t                        + String.join(\" \", cmd));\n    90\t            }\n    91\t            return new String(out, StandardCharsets.UTF_8);\n    92\t        } catch (IOException e) {\n    93\t            throw new PgException(\"exec failed: \" + e.getMessage());\n    94\t        } catch (InterruptedException e) {\n    95\t            Thread.currentThread().interrupt();\n    96\t            throw new PgException(\"interrupted\");\n    97\t        }\n    98\t    }\n    99\t\n   100\t    public static class PgException extends RuntimeException {\n   101\t        public PgException(String msg) {\n   102\t            super(msg);\n   103\t        }\n   104\t    }\n   105\t}\n=== src/infra/RefundFileWriter.java\n     1\tpackage infra;\n     2\t\n     3\timport domain.RefundLine;\n     4\timport util.Refs;\n     5\t\n     6\timport java.io.IOException;\n     7\timport java.nio.charset.StandardCharsets;\n     8\timport java.nio.file.Files;\n     9\timport java.nio.file.Path;\n    10\timport java.util.List;\n    11\t\n    12\t/** Writes the PG refund batch file: one line per refund, TID TAB AMOUNT TAB merchant reference. */\n    13\tpublic final class RefundFileWriter {\n    14\t    private RefundFileWriter() {}\n    15\t\n    16\t    /** Merchant reference printed on the PG settlement file so finance can trace the refund to our order. */\n    17\t    public static String merchantRef(RefundLine line) {\n    18\t        return Refs.sanitize(line.orderNo());\n    19\t    }\n    20\t\n    21\t    public static String format(List<RefundLine> lines) {\n    22\t        StringBuilder sb = new StringBuilder();\n    23\t        for (RefundLine l : lines) {\n    24\t            sb.append(l.tid()).append('\\t').append(l.amount()).append('\\t').append(merchantRef(l)).append('\\n');\n    25\t        }\n    26\t        return sb.toString();\n    27\t    }\n    28\t\n    29\t    public static Path write(Path dir, String batchId, List<RefundLine> lines) {\n    30\t        try {\n    31\t            Files.createDirectories(dir);\n    32\t            Path file = dir.resolve(batchId + \".tsv\");\n    33\t            Files.writeString(file, format(lines), StandardCharsets.UTF_8);\n    34\t            return file;\n    35\t        } catch (IOException e) {\n    36\t            throw new IllegalStateException(\"cannot write refund batch \" + batchId, e);\n    37\t        }\n    38\t    }\n    39\t}\n=== src/service/RefundBatchJob.java\n     1\tpackage service;\n     2\t\n     3\timport domain.RefundLine;\n     4\timport domain.RunResult;\n     5\timport infra.PgsimClient;\n     6\timport infra.RefundFileWriter;\n     7\timport store.RefundRepository;\n     8\t\n     9\timport java.nio.file.Path;\n    10\timport java.time.LocalDate;\n    11\timport java.time.format.DateTimeFormatter;\n    12\timport java.util.ArrayList;\n    13\timport java.util.LinkedHashMap;\n    14\timport java.util.List;\n    15\timport java.util.Map;\n    16\t\n    17\t/**\n    18\t * Nightly refund run: every pending refund line goes to the PG in batches of\n    19\t * at most maxLines. Batch id = run id + chunk number; the PG settles and is\n    20\t * reconciled per batch id.\n    21\t */\n    22\tpublic class RefundBatchJob {\n    23\t    private final RefundRepository refunds;\n    24\t    private final PgsimClient pg;\n    25\t    private final String mid;\n    26\t    private final String prefix;\n    27\t    private final int maxLines;\n    28\t    private final Path workDir;\n    29\t\n    30\t    public RefundBatchJob(RefundRepository refunds, PgsimClient pg, String mid, String prefix, int maxLines,\n    31\t                          Path workDir) {\n    32\t        this.refunds = refunds;\n    33\t        this.pg = pg;\n    34\t        this.mid = mid;\n    35\t        this.prefix = prefix;\n    36\t        this.maxLines = maxLines;\n    37\t        this.workDir = workDir;\n    38\t    }\n    39\t\n    40\t    public RunResult run(LocalDate day) {\n    41\t        String runId = String.format(\"%s%s-%02d\", prefix, day.format(DateTimeFormatter.BASIC_ISO_DATE),\n    42\t                refunds.nextRunSeq());\n    43\t        List<RefundLine> pending = uniquePending();\n    44\t        List<String> batchIds = new ArrayList<>();\n    45\t        int completed = 0;\n    46\t        for (int start = 0, chunk = 1; start < pending.size(); start += maxLines, chunk++) {\n    47\t            List<RefundLine> part = pending.subList(start, Math.min(pending.size(), start + maxLines));\n    48\t            String batchId = runId + \"-\" + chunk;\n    49\t            Path file = RefundFileWriter.write(workDir, batchId, part);\n    50\t            int accepted = pg.refund(mid, batchId, file);\n    51\t            if (accepted != part.size()) {\n    52\t                throw new IllegalStateException(\"PG accepted \" + accepted + \" of \" + part.size() + \" in \" + batchId);\n    53\t            }\n    54\t            for (RefundLine l : part) l.submitted(batchId);\n    55\t            batchIds.add(batchId);\n    56\t            completed += RefundResultMatcher.apply(part, pg.status(batchId));\n    57\t        }\n    58\t        int awaiting = (int) pending.stream().filter(l -> l.status() == RefundLine.Status.SUBMITTED).count();\n    59\t        return new RunResult(runId, List.copyOf(batchIds), pending.size(), completed, awaiting);\n    60\t    }\n    61\t\n    62\t    /** A line queued twice by a CS double-click must be refunded once. */\n    63\t    private List<RefundLine> uniquePending() {\n    64\t        Map<String, RefundLine> byKey = new LinkedHashMap<>();\n    65\t        for (RefundLine l : refunds.pending()) {\n    66\t            byKey.putIfAbsent(l.orderNo() + \"#\" + l.lineNo(), l);\n    67\t        }\n    68\t        return new ArrayList<>(byKey.values());\n    69\t    }\n    70\t}\n=== src/service/RefundResultMatcher.java\n     1\tpackage service;\n     2\t\n     3\timport domain.RefundLine;\n     4\timport infra.PgsimClient.RefundRow;\n     5\timport infra.RefundFileWriter;\n     6\t\n     7\timport java.util.ArrayList;\n     8\timport java.util.List;\n     9\t\n    10\t/** Attaches PG refund numbers from a batch status to the lines we sent in that batch. */\n    11\tpublic final class RefundResultMatcher {\n    12\t    private RefundResultMatcher() {}\n    13\t\n    14\t    /** Returns how many lines got a refund number. Each PG row is used at most once. */\n    15\t    public static int apply(List<RefundLine> sent, List<RefundRow> rows) {\n    16\t        List<RefundRow> free = new ArrayList<>(rows);\n    17\t        int matched = 0;\n    18\t        for (RefundLine line : sent) {\n    19\t            String ref = RefundFileWriter.merchantRef(line);\n    20\t            for (int i = 0; i < free.size(); i++) {\n    21\t                RefundRow row = free.get(i);\n    22\t                if (row.tid().equals(line.tid()) && row.amount() == line.amount() && row.aux().equals(ref)) {\n    23\t                    line.done(row.refundNo());\n    24\t                    free.remove(i);\n    25\t                    matched++;\n    26\t                    break;\n    27\t                }\n    28\t            }\n    29\t        }\n    30\t        return matched;\n    31\t    }\n    32\t}\n=== src/service/RefundService.java\n     1\tpackage service;\n     2\t\n     3\timport dom