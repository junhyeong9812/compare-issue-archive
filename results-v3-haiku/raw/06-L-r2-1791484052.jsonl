und(caseOrder.orderNo(), List.of(2), REFUND_DAY);\n    25\t        api.requestRefund(earbuds.orderNo(), List.of(1), REFUND_DAY);\n    26\t        api.requestRefund(films.orderNo(), List.of(1), REFUND_DAY);\n    27\t        RunResult run = api.runRefunds(REFUND_DAY);\n    28\t\n    29\t        t.test(\"nightly refund run submits every requested item\", () -> {\n    30\t            TestSupport.eq(5, run.submitted(), \"items submitted\");\n    31\t            TestSupport.eq(1, run.batchIds().size(), \"PG batches\");\n    32\t        });\n    33\t\n    34\t        t.test(\"customer C-2051 gets both returned power banks back (31,800원)\", () -> {\n    35\t            CustomerStatement s = api.statement(chargers.orderNo());\n    36\t            TestSupport.eq(38_700L, s.paid(), \"paid\");\n    37\t            TestSupport.eq(31_800L, s.refunded(), \"refunded to the customer by the PG\");\n    38\t            TestSupport.eq(6_900L, s.balance(), \"remaining payment\");\n    39\t        });\n    40\t\n    41\t        t.test(\"every returned item shows 환불 완료 with a PG refund number\", () -> {\n    42\t            for (Order o : List.of(chargers, caseOrder, earbuds, films)) {\n    43\t                for (CustomerStatement.Line l : api.statement(o.orderNo()).lines()) {\n    44\t                    if (l.state().equals(\"구매\")) continue;\n    45\t                    TestSupport.eq(\"환불 완료\", l.state(), o.orderNo() + \" line \" + l.lineNo());\n    46\t                    TestSupport.check(l.refundNo() != null, o.orderNo() + \" line \" + l.lineNo() + \" has no refund number\");\n    47\t                }\n    48\t            }\n    49\t        });\n    50\t\n    51\t        t.test(\"nothing is left waiting at the PG after the nightly run\", () ->\n    52\t                TestSupport.eq(List.of(), api.awaitingPg().stream().map(Object::toString).toList(), \"awaiting\"));\n    53\t\n    54\t        t.test(\"other customers' partial refunds are paid\", () -> {\n    55\t            TestSupport.eq(9_900L, api.statement(caseOrder.orderNo()).refunded(), \"C-3310 case\");\n    56\t            TestSupport.eq(49_000L, api.statement(earbuds.orderNo()).refunded(), \"C-4127 earbuds\");\n    57\t            TestSupport.eq(7_615L, api.statement(films.orderNo()).refunded(), \"C-1188 one film after coupon\");\n    58\t            TestSupport.eq(0L, api.statement(earbuds.orderNo()).balance(), \"C-4127 balance\");\n    59\t        });\n    60\t\n    61\t        t.test(\"statement text for C-3310\", () -> {\n    62\t            String text = api.statementText(caseOrder.orderNo());\n    63\t            TestSupport.check(text.contains(\"투명 젤리 케이스  9,900원  환불 완료 [RF\"), text);\n    64\t            TestSupport.check(text.contains(\"결제 22,800원 / 환불 9,900원 / 잔액 12,900원\"), text);\n    65\t        });\n    66\t\n    67\t        t.test(\"an item cannot be refunded twice\", () -> {\n    68\t            try {\n    69\t                api.requestRefund(caseOrder.orderNo(), List.of(2), REFUND_DAY.plusDays(1));\n    70\t                throw new AssertionError(\"second refund of the same item was accepted\");\n    71\t            } catch (IllegalStateException expected) {\n    72\t                // ok\n    73\t            }\n    74\t        });\n    75\t\n    76\t        t.test(\"a run with nothing pending sends nothing\", () -> {\n    77\t            RunResult again = api.runRefunds(REFUND_DAY.plusDays(1));\n    78\t            TestSupport.eq(0, again.submitted(), \"submitted\");\n    79\t            TestSupport.eq(List.of(), again.batchIds(), \"batches\");\n    80\t        });\n    81\t\n    82\t        t.finish();\n    83\t    }\n    84\t}\n=== test/UnitChecks.java\n     1\timport domain.RefundLine;\n     2\timport infra.PgsimClient.RefundRow;\n     3\timport infra.RefundFileWriter;\n     4\timport service.DiscountAllocator;\n     5\timport service.RefundResultMatcher;\n     6\timport util.Money;\n     7\timport util.Refs;\n     8\t\n     9\timport java.time.LocalDate;\n 