c enum Status {\n     8\t        /** accepted by CS, waiting for the nightly refund run */\n     9\t        REQUESTED,\n    10\t        /** sent to the PG in a refund batch, no PG refund number yet */\n    11\t        SUBMITTED,\n    12\t        /** PG refund number received */\n    13\t        DONE\n    14\t    }\n    15\t\n    16\t    private final String requestId;\n    17\t    private final String orderNo;\n    18\t    private final int lineNo;\n    19\t    private final String tid;\n    20\t    private final long amount;\n    21\t    private final LocalDate requestedOn;\n    22\t    private Status status = Status.REQUESTED;\n    23\t    private String batchId;\n    24\t    private String refundNo;\n    25\t\n    26\t    public RefundLine(String requestId, String orderNo, int lineNo, String tid, long amount, LocalDate requestedOn) {\n    27\t        this.requestId = requestId;\n    28\t        this.orderNo = orderNo;\n    29\t        this.lineNo = lineNo;\n    30\t        this.tid = tid;\n    31\t        this.amount = amount;\n    32\t        this.requestedOn = requestedOn;\n    33\t    }\n    34\t\n    35\t    public String requestId() { return requestId; }\n    36\t    public String orderNo() { return orderNo; }\n    37\t    public int lineNo() { return lineNo; }\n    38\t    public String tid() { return tid; }\n    39\t    public long amount() { return amount; }\n    40\t    public LocalDate requestedOn() { return requestedOn; }\n    41\t    public Status status() { return status; }\n    42\t    public String batchId() { return batchId; }\n    43\t    public String refundNo() { return refundNo; }\n    44\t\n    45\t    public void submitted(String batchId) {\n    46\t        this.status = Status.SUBMITTED;\n    47\t        this.batchId = batchId;\n    48\t    }\n    49\t\n    50\t    public void done(String refundNo) {\n    51\t        this.status = Status.DONE;\n    52\t        this.refundNo = refundNo;\n    53\t    }\n    54\t\n    55\t    @Override\n    56\t    public String toString() {\n    57\t        return requestId + \"/\" + orderNo + \"#\" + lineNo + \" \" + amount + \" \" + status;\n    58\t    }\n    59\t}\n=== src/domain/OrderLine.java\n     1\tpackage domain;\n     2\t\n     3\t/** One unit of a product in an order. Quantity is always 1: two of the same product are two lines. */\n     4\tpublic record OrderLine(int lineNo, String sku, String name, long price, long discount) {\n     5\t    public long paid() {\n     6\t        return price - discount;\n     7\t    }\n     8\t}\n=== src/domain/Order.java\n     1\tpackage domain;\n     2\t\n     3\timport java.util.List;\n     4\t\n     5\tpublic record Order(String orderNo, String customerId, String tid, List<OrderLine> lines, long coupon) {\n     6\t    public long paidTotal() {\n     7\t        return lines.stream().mapToLong(OrderLine::paid).sum();\n     8\t    }\n     9\t\n    10\t    public OrderLine line(int lineNo) {\n    11\t        return lines.stream().filter(l -> l.lineNo() == lineNo).findFirst()\n    12\t                .orElseThrow(() -> new IllegalArgumentException(\"no line \" + lineNo + \" in \" + orderNo));\n    13\t    }\n    14\t}\n=== src/api/RefundDeskApi.java\n     1\tpackage api;\n     2\t\n     3\timport config.AppConfig;\n     4\timport domain.CatalogItem;\n     5\timport domain.CustomerStatement;\n     6\timport domain.Order;\n     7\timport domain.RefundLine;\n     8\timport domain.RunResult;\n     9\timport infra.CatalogLoader;\n    10\timport infra.PgsimClient;\n    11\timport service.CheckoutService;\n    12\timport service.CustomerStatementService;\n    13\timport service.RefundBatchJob;\n    14\timport service.RefundService;\n    15\timport store.OrderRepository;\n    16\timport store.RefundRepository;\n    17\t\n    18\timport java.time.LocalDate;\n    19\timport java.util.List;\n    20\timport java.util.Map;\n    21\t\n    22\t/** Facade used by the CS console, the nightly scheduler and the tests. */\n    23\tpublic class RefundDeskApi {\n    24\t    private final CheckoutService checkout;\n    25\t    private final RefundService refundService;\n    26\t    private final RefundBatchJob batchJob;\n    27\t    private final CustomerStatementService statements;\n    28\t    private final RefundRepository refunds;\n    29\t\n    30\t    public RefundDeskApi(AppConfig cfg) {\n    31\t        Map<String, CatalogItem> catalog = CatalogLoader.load(cfg.catalogFile());\n    32\t        PgsimClient pg = new PgsimClient(cfg.pgBin(), cfg.pgHome(), cfg.pgTimeoutSeconds());\n    33\t        OrderRepository orders = new OrderRepository();\n    34\t        this.refunds = new RefundRepository();\n    35\t        this.checkout = new CheckoutService(catalog, orders, pg, cfg.merchantId());\n    36\t        this.refundService = new RefundService(orders, refunds);\n    37\t        this.batchJob = new RefundBatchJob(refunds, pg, cfg.merchantId(), cfg.batchPrefix(),\n    38\t                cfg.maxLinesPerBatch(), cfg.workDir());\n    39\t        this.statements = new CustomerStatementService(orders, refunds, pg);\n    40\t    }\n    41\t\n    42\t    public Order placeOrder(String customerId, List<String> skus, long coupon, LocalDate day) {\n    43\t        return checkout.place(customerId, skus, coupon, day);\n    44\t    }\n    45\t\n    46\t    public String requestRefund(String orderNo, List<Integer> lineNos, LocalDate day) {\n    47\t        return refundService.request(orderNo, lineNos, day);\n    48\t    }\n    49\t\n    50\t    public RunResult runRefunds(LocalDate day) {\n    51\t        return batchJob.run(day);\n    52\t    }\n    53\t\n    54\t    public CustomerStatement statement(String orderNo) {\n    55\t        return statements.statement(orderNo);\n    56\t    }\n    57\t\n    58\t    public String statementText(String orderNo) {\n    59\t        return StatementFormatter.format(statement(orderNo));\n    60\t    }\n    61\t\n    62\t    /** Lines sent to the PG that still have no PG refund number. */\n    63\t    public List<RefundLine> awaitingPg() {\n    64\t        return refunds.all().stream().filter(l -> l.status() == RefundLine.Status.SUBMITTED).toList();\n    65\t    }\n    66\t}\n=== test/RefundE2ETest.java\n     1\timport api.RefundDeskApi;\n     2\timport domain.CustomerStatement;\n     3\timport domain.Order;\n     4\timport domain.RunResult;\n     5\t\n     6\timport java.time.LocalDate;\n     7\timport java.util.List;\n     8\t\n     9\t/** End-to-end: orders paid through the PG sandbox, CS refund requests, nightly refund run, customer statement. */\n    10\tpublic class RefundE2ETest {\n    11\t    private static final LocalDate ORDER_DAY = LocalDate.of(2026, 10, 7);\n    12\t    private static final LocalDate REFUND_DAY = LocalDate.of(2026, 10, 8);\n    13\t\n    14\t    public static void main(String[] args) throws Exception {\n    15\t        TestSupport t = new TestSupport(\"e2e\");\n    16\t        RefundDeskApi api = new RefundDeskApi(TestSupport.sandbox());\n    17\t\n    18\t        Order chargers = api.placeOrder(\"C-2051\", List.of(\"SKU-PB10\", \"SKU-PB10\", \"SKU-CB1M\"), 0, ORDER_DAY);\n    19\t        Order caseOrder = api.placeOrder(\"C-3310\", List.of(\"SKU-AD20\", \"SKU-CASE\"), 0, ORDER_DAY);\n    20\t        Order earbuds = api.placeOrder(\"C-4127\", List.of(\"SKU-EARB\"), 0, ORDER_DAY);\n    21\t        Order films = api.placeOrder(\"C-1188\", List.of(\"SKU-FILM\", \"SKU-FILM\", \"SKU-STND\"), 1000, ORDER_DAY);\n    22\t\n    23\t        api.requestRefund(chargers.orderNo(), List.of(1, 2), REFUND_DAY);\n    24\t        api.requestRefund(caseOrder.orderNo(), List.of(2), REFUND_DAY);\n    25\t        api.requestRefund(earbuds.orderNo(), List.of(1), REFUND_DAY);\n    26\t        api.requestRefund(films.orderNo(), List.of(1), REFUND_DAY);\n    27\t        RunResult run = api.runRefunds(REFUND_DAY);\n    28\t\n    29\t        t.test(\"nightly refund run submits every requested item\", () -> {\n    30\t            TestSupport.eq(5, run.submitted(), \"items submitted\");\n    31\t            TestSupport.eq(1, run.batchIds().size(), \"PG batches\");\n    32\t        });\n    33\t\n    34\t        t.test(\"customer C-2051 gets both returned power banks back (31,800원)\", () -> {\n    35\t            CustomerStatement s = api.statement(chargers.orderNo());\n    36\t            TestSupport.eq(38_700L, s.paid(), \"paid\");\n    37\t            TestSupport.eq(31_800L, s.refunded(), \"refunded to the customer by the PG\");\n    38\t            TestSupport.eq(6_900L, s.balance(), \"remaining payment\");\n    39\t        });\n    40\t\n    41\t        t.test(\"every returned item shows 환불 완료 with a PG refund number\", () -> {\n    42\t            for (Order o : List.of(chargers, caseOrder, earbuds, films)) {\n    43\t                for (CustomerStatement.Line l : api.statement(o.orderNo()).lines()) {\n    44\t                    if (l.state().equals(\"구매\")) continue;\n    45\t                    TestSupport.eq(\"환불 완료\", l.state(), o.orderNo() + \" line \" + l.lineNo());\n    46\t                    TestSupport.check(l.refundNo() != null, o.orderNo() + \" line \" + l.lineNo() + \" has no refund number\");\n    47\t                }\n    48\t            }\n    49\t        });\n    50\t\n    51\t        t.test(\"nothing is left waiting at the PG after the nightly run\", () ->\n    52\t                TestSupport.eq(List.of(), api.awaitingPg().stream().map(Object::toString).toList(), \"awaiting\"));\n    53\t\n    54\t        t.test(\"other customers' partial refunds are paid\", () -> {\n    55\t            TestSupport.eq(9_900L, api.statement(caseOrder.orderNo()).refunded(), \"C-3310 case\");\n    56\t            TestSupport.eq(49_000L, api.statement(earbuds.orderNo()).refunded(), \"C-4127 earbuds\");\n    57\t            TestSupport.eq(7_615L, api.statement(films.orderNo()).refunded(), \"C-1188 one film after coupon\");\n    58\t            TestSupport.eq(0L, api.statement(earbuds.orderNo()).bal