\n            sb.append(l.tid()).append('\\t').append(l.amount()).append('\\t').append(merchantRef(l)).append('\\n');\n        }\n        return sb.toString();\n    }\n\n    public static Path write(Path dir, String batchId, List<RefundLine> lines) {\n        try {\n            Files.createDirectories(dir);\n            Path file = dir.resolve(batchId + \".tsv\");\n            Files.writeString(file, format(lines), StandardCharsets.UTF_8);\n            return file;\n        } catch (IOException e) {\n            throw new IllegalStateException(\"cannot write refund batch \" + batchId, e);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":13,"oldLines":9,"newStart":13,"newLines":13,"lines":[" public final class RefundFileWriter {","     private RefundFileWriter() {}"," ","-    /** Merchant reference printed on the PG settlement file so finance can trace the refund to our order. */","+    /**","+     * Merchant reference (AUX) printed on the PG settlement file so finance can trace the refund to our order line.","+     * The PG treats lines with the same TID, amount and AUX as one refund, so the reference must differ per line:","+     * two units of the same product in one order share TID and amount.","+     */","     public static String merchantRef(RefundLine line) {","-        return Refs.sanitize(line.orderNo());","+        return Refs.sanitize(line.orderNo() + \"-\" + line.lineNo());","     }"," ","     public static String format(List<RefundLine> lines) {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_018TbPbAYf2yDSJNfcBWBvjd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
