         return [], 0\n        by_id = {m.member_id: m for m in fresh}\n        batch = build_batch(fresh)\n        jobs = []\n        for start in range(0, len(batch), MAX_BATCH_LINES):\n            chunk = batch[start:start + MAX_BATCH_LINES]\n            ticket = self.client.submit(chunk)\n            jobs.append(ticket.job_id)\n            # mark only what the vendor has accepted, so a failed later chunk is retried alone\n            for request in chunk:\n                member = by_id[request.ref]\n                member.kyc_state = KYC_SENT\n                member.kyc_job = ticket.job_id\n                member.history.append(KYC_SENT)\n        return jobs, len(fresh)","originalFile":"\"\"\"Identity-check run: sends new members to the vendor and applies verdicts.\"\"\"\nfrom hbonboard.kyc.requests import build_batch\nfrom hbonboard.kyc.verdicts import apply_verdict\nfrom hbonboard.models import KYC_NEW, KYC_SENT\n\n\nclass VerificationService:\n    def __init__(self, repo, client, settings, notifier=None, on_resolved=None):\n        self.repo = repo\n        self.client = client\n        self.settings = settings\n        self.notifier = notifier\n        self.on_resolved = on_resolved\n\n    def _send_new(self):\n        fresh = sorted(self.repo.by_kyc_state(KYC_NEW), key=lambda m: m.member_id)\n        if not fresh:\n            return [], 0\n        ticket = self.client.submit(build_batch(fresh))\n        for member in fresh:\n            member.kyc_state = KYC_SENT\n            member.kyc_job = ticket.job_id\n            member.history.append(KYC_SENT)\n        return [ticket.job_id], len(fresh)\n\n    def _collect(self):\n        resolved, waiting = [], []\n        for member in sorted(self.repo.by_kyc_state(KYC_SENT), key=lambda m: m.member_id):\n            code = self.client.result(member.member_id)\n            if code is None:\n                # the vendor has not answered for this one yet; ask again next run\n                waiting.append(member.member_id)\n                continue\n            apply_verdict(member, code)\n            if self.notifier:\n                self.notifier.verdict(member)\n            resolved.append({\"id\": member.member_id, \"status\": member.status})\n        return resolved, waiting\n\n    def run(self):\n        jobs, sent = self._send_new()\n        resolved, waiting = self._collect()\n        if resolved and self.on_resolved:\n            self.on_resolved()\n        return {\"jobs\": jobs, \"sent\": sent, \"resolved\": resolved, \"waiting\": len(waiting)}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":5,"lines":[" \"\"\"Identity-check run: sends new members to the vendor and applies verdicts.\"\"\"","+from hbonboard.kyc.client import MAX_BATCH_LINES"," from hbonboard.kyc.requests import build_batch"," from hbonboard.kyc.verdicts import apply_verdict"," from hbonboard.models import KYC_NEW, KYC_SENT"]},{"oldStart":16,"oldLines":12,"newStart":17,"newLines":20,"lines":["         fresh = sorted(self.repo.by_kyc_state(KYC_NEW), key=lambda m: m.member_id)","         if not fresh:","             return [], 0","-        ticket = self.client.submit(build_batch(fresh))","-        for member in fresh:","-            member.kyc_state = KYC_SENT","-            member.kyc_job = ticket.job_id","-            member.history.append(KYC_SENT)","-        return [ticket.job_id], len(fresh)","+        by_id = {m.member_id: m for m in fresh}","+        batch = build_batch(fresh)","+        jobs = []","+        for start in range(0, len(batch), MAX_BATCH_LINES):","+            chunk = batch[start:start + MAX_BATCH_LINES]","+            ticket = self.client.submit(chunk)","+            jobs.append(ticket.job_id)","+            # mark only what the vendor has accepted, so a failed later chunk is retried alone","+            for request in chunk:","+                member = by_id[request.ref]","+                member.kyc_state = KYC_SENT","+                member.kyc_job = t