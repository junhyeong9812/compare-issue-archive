{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BnJ5Dwht5jt3KwWuMuemfQ","type":"tool_result","content":"\"\"\"Contract checks against the vendor CLI binary shipped in vendor/bin.\"\"\"\nimport unittest\n\nfrom hbonboard.config import DEFAULTS\nfrom hbonboard.kyc.client import IdchkClient\nfrom hbonboard.models import KycRequest, VendorError\nfrom tests.support import VendorHome\n\n\nclass IdchkClientTest(unittest.TestCase):\n    def setUp(self):\n        self.home = VendorHome()\n        self.client = IdchkClient(DEFAULTS.with_overrides(idchk_home=self.home.path))\n\n    def tearDown(self):\n        self.home.cleanup()\n\n    def test_submit_then_result_roundtrip(self):\n        ticket = self.client.submit([\n            KycRequest(\"T-1\", \"홍길동\", \"19900101\", \"01011112222\"),\n            KycRequest(\"T-2\", \"Kim Ara\", \"19851231\", \"01033334444\"),\n            KycRequest(\"T-3\", \"이도\", \"20000229\", \"0162223333\"),\n        ])\n        self.assertTrue(ticket.job_id.startswith(\"J\"))\n        self.assertEqual(ticket.lines, 3)\n        for ref in (\"T-1\", \"T-2\", \"T-3\"):\n            self.assertIn(self.client.result(ref), (1, 2))\n        self.assertEqual(self.client.job(ticket.job_id)[\"in\"], \"3\")\n\n    def test_unknown_reference_has_no_result(self):\n        self.assertIsNone(self.client.result(\"T-404\"))\n\n    def test_malformed_line_rejects_the_file(self):\n        with self.assertRaises(VendorError) as ctx:\n            self.client.submit([KycRequest(\"T-1\", \"홍길동\", \"19900101\", \"021234567\")])\n        self.assertEqual(ctx.exception.code, \"E17\")\n        self.assertIsNone(self.client.result(\"T-1\"))\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n\"\"\"Shared fixtures for the API tests: a fresh vendor working dir per test.\"\"\"\nimport datetime\nimport json\nimport os\nimport shutil\nimport tempfile\n\nfrom hbonboard.app import build_app\n\nFIXTURES = os.path.join(os.path.dirname(__file__), \"fixtures\")\nTODAY = datetime.date(2026, 10, 9)\n\n\ndef load_signups(name=\"signups_2026_10.json\"):\n    with open(os.path.join(FIXTURES, name), encoding=\"utf-8\") as f:\n        return json.load(f)\n\n\nclass VendorHome:\n    def __init__(self):\n        self.path = tempfile.mkdtemp(prefix=\"idchk-\")\n\n    def cleanup(self):\n        shutil.rmtree(self.path, ignore_errors=True)\n\n\ndef app_with_members(home, signups):\n    app = build_app(today=TODAY, idchk_home=home.path)\n    ids = []\n    for payload in signups:\n        resp = app.post(\"/members\", payload)\n        assert resp.status == 201, resp.body\n        ids.append(resp.body[\"id\"])\n    return app, ids\n[\n  {\"name\": \"김하늘\", \"birth\": \"1991-03-14\", \"phone\": \"010-4821-7730\", \"channel\": \"app\"},\n  {\"name\": \"Park Jiwon\", \"birth\": \"1988-11-02\", \"phone\": \"010 2290 1184\", \"channel\": \"web\"},\n  {\"name\": \"이서연\", \"birth\": \"19990521\", \"phone\": \"01093317702\", \"channel\": \"app\"},\n  {\"name\": \"최민준\", \"birth\": \"1975-07-30\", \"phone\": \"+82 10-5502-9913\", \"channel\": \"partner\"},\n  {\"name\": \"정유나\", \"birth\": \"2001-01-09\", \"phone\": \"010-7714-2045\", \"channel\": \"app\"},\n  {\"name\": \"한도윤\", \"birth\": \"1983-09-17\", \"phone\": \"010-3368-5521\", \"channel\": \"web\"},\n  {\"name\": \"남궁 민수\", \"birth\": \"1969-12-24\", \"phone\": \"010-6120-0457\", \"channel\": \"partner\"},\n  {\"name\": \"오지훈\", \"birth\": \"1995-04-03\", \"phone\": \"010.8845.3390\", \"channel\": \"app\"},\n  {\"name\": \"윤소희\", \"birth\": \"2003-06-28\", \"phone\": \"010-1407-6638\", \"channel\": \"app\"},\n  {\"name\": \"Lee Dana\", \"birth\": \"1990-02-11\", \"phone\": \"010-5099-4412\", \"channel\": \"web\"},\n  {\"name\": \"강다은\", \"birth\": \"1997-10-05\", \"phone\": \"010-2563-8807\", \"channel\": \"app\"},\n  {\"name\": \"서준\", \"birth\": \"1986-08-19\", \"phone\": \"011-742-3306\", \"channel\": \"partner\"},\n  {\"name\": \"임하린\", \"birth\": \"2000-03-31\", \"phone\": \"010-9182-4475\", \"channel\": \"app\"},\n  {\"name\": \"백지호\", \"birth\": \"1979-05-08\", \"phone\": \"010-3951-2268\", \"channel\": \"web\"},\n  {\"name\": \"조아라\", \"birth\": \"1993-12-01\", \"phone\": \"010-6677-1029\", \"channel\": \"app\"},\n  {\"name\": \"신우진\", \"birth\": \"1981-01-26\", \"phone\": \"010-4410-9963\", \"channel\": \"partner\"},\n  {\"name\": \n\"\"\"Name helpers shared by the sign-up form and the vendor bridge.\"\"\"\nimport unicodedata\n\n_SPACES = {\"\\t\", \"\\n\", \"\\r\", \"\\x0b\", \"\\x0c\", \" \", \"　\"}\n\n\ndef normalize_name(text):\n    \"\"\"NFC-normalize, turn odd whitespace into plain spaces, collapse runs.\"\"\"\n    if text is None:\n        return \"\"\n    text = unicodedata.normalize(\"NFC\", str(text))\n    out = []\n    for ch in text:\n        if ch in _SPACES:\n            ch = \" \"\n        elif unicodedata.category(ch) in (\"Cc\", \"Cf\"):\n            continue\n        if ch == \" \" and out and out[-1] == \" \":\n            continue\n        out.append(ch)\n    return \"\".join(out).strip()\n\n\ndef mask_name(name):\n    \"\"\"홍길동 -> 홍*동, 이도 -> 이*, Kim Minseo -> K********o.\"\"\"\n    if len(name) <= 1:\n        return name\n    if len(name) == 2:\n        return name[0] + \"*\"\n    return name[0] + \"*\" * (len(name) - 2) + name[-1]\n\n\ndef vendor_name(name):\n    \"\"\"The vendor matches on the registered name without spaces.\"\"\"\n    return name.replace(\" \", \"\")\n\"\"\"Korean mobile numbers: accept what people type, store digits only.\"\"\"\nimport re\n\n_MOBILE = re.compile(r\"^01[016789]\\d{7,8}$\")\n\n\ndef normalize_phone(raw):\n    \"\"\"'010-1234-5678', '+82 10 1234 5678', '(010)1234.5678' -> '01012345678'.\"\"\"\n    if raw is None:\n        return \"\"\n    digits = re.sub(r\"\\D\", \"\", str(raw))\n    if digits.startswith(\"82\") and len(digits) in (11, 12):\n        digits = \"0\" + digits[2:]\n    return digits\n\n\ndef is_mobile(digits):\n    return bool(_MOBILE.match(digits or \"\"))\n\