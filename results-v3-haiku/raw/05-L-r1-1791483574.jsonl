ing\nSANDBOX_MISMATCH = {\"김하늘\", \"오지훈\", \"임하린\", \"황보 현\"}\n\n\nclass OnboardingRunTest(unittest.TestCase):\n    def setUp(self):\n        self.home = VendorHome()\n        self.signups = load_signups()\n        self.app, self.ids = app_with_members(self.home, self.signups)\n        # noise: a second sign-up with an already registered phone is refused\n        dup = dict(self.signups[3], name=\"최민준\", phone=\"010 5502 9913\")\n        self.assertEqual(self.app.post(\"/members\", dup).status, 409)\n        self.run = self.app.post(\"/kyc/run\")\n\n    def tearDown(self):\n        self.home.cleanup()\n\n    def member(self, member_id):\n        resp = self.app.get(f\"/members/{member_id}\")\n        self.assertEqual(resp.status, 200, resp.body)\n        return resp.body\n\n    def test_run_sends_every_new_member(self):\n        self.assertEqual(self.run.status, 200, self.run.body)\n        self.assertEqual(self.run.body[\"sent\"], len(self.signups))\n        self.assertTrue(self.run.body[\"jobs\"])\n\n    def test_no_member_is_left_waiting_after_the_run(self):\n        waiting = [i for i in self.ids if self.member(i)[\"status\"] == \"pending\"]\n        self.assertEqual(waiting, [], \"new members are still waiting for the identity check\")\n\n    def test_decisions_follow_the_identity_check(self):\n        for member_id, payload in zip(self.ids, self.signups):\n            body = self.member(member_id)\n            expected = \"rejected\" if body[\"name\"] in SANDBOX_MISMATCH else \"active\"\n            self.assertEqual(body[\"status\"], expected, f\"{member_id} {payload['name']}\")\n\n    def test_backlog_report_is_empty(self):\n        report = self.app.get(\"/reports/kyc-backlog\").body\n        self.assertEqual(report[\"total\"], len(self.signups))\n        self.assertEqual(report[\"counts\"][\"pending\"], 0, \"admin backlog still lists pending members\")\n        self.assertEqual(report[\"pending\"], [])\n\n    def test_every_member_gets_exactly_one_notice(self):\n        messages = self.app.get(\"/outbox\").body[\"items\"]\n        self.assertEqual(sorted(m[\"member\"] for m in messages), sorted(self.ids),\n                         \"some members never got a sign-up result message\")\n\n    def test_next_run_has_nothing_new_to_send(self):\n        again = self.app.post(\"/kyc/run\").body\n        self.assertEqual(again[\"sent\"], 0)\n        self.assertEqual(again[\"jobs\"], [])\n\n    def test_member_detail_masks_phone(self):\n        body = self.member(self.ids[0])\n        self.assertEqual(body[\"phone\"], \"010-****-7730\")\n        self.assertEqual(body[\"channel\"], \"app\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n\"\"\"Member notifications (the real service hands these to the SMS gateway).\"\"\"\nfrom hbonboard.models import ACTIVE, REJECTED, REVIEW\nfrom hbonboard.util.phone import mask_phone\nfrom hbonboard.util.text import mask_name\n\nTEMPLATES = {\n    ACTIVE: \"[한빛페이] {name}님, 본인확인이 완료되어 가입이 끝났습니다.\",\n    REJECTED: \"[한빛페이] {name}님, 입력하신 정보로 본인확인이 되지 않았습니다. 앱에서 다시 시도해 주세요.\",\n    REVIEW: \"[한빛페이] {name}님, 본인확인 결과를 담당자가 확인하고 있습니다.\",\n}\n\n\nclass Outbox:\n    def __init__(self):\n        self._messages = []\n\n    def verdict(self, member):\n        template = TEMPLATES.get(member.status)\n        if template is None:\n            return None\n        message = {\n            \"member\": member.member_id,\n            \"to\": mask_phone(member.phone),\n            \"kind\": member.status,\n            \"text\": template.format(name=mask_name(member.name)),\n        }\n        self._messages.append(message)\n        return message\n\n    def messages(self, member_id=None):\n        if member_id is None:\n            return list(self._messages)\n        return [m for m in self._messages if m[\"member\"] == member_id]\n\"\"\"Sign-up form validation and registration.\"\"\"\nfrom hbonboard.models import Conflict, Member, PENDING\nfrom hbonboard.util.dates import age_on, parse_date\nfrom hbonboard.util.phone import is_mobile, normalize_phone\nfrom hbonboard.util.text import normalize_name\n\n\nclass SignupService:\n    def __init__(self, repo, settings, today):\n        self.repo = repo\n        self.settings = settings\n        self.today = today\n\n    def validate(self, payload):\n        name = normalize_name(payload.get(\"name\"))\n        if not name or len(name) > self.settings.name_max_chars:\n            raise ValueError(\"name is required (max %d characters)\" % self.settings.name_max_chars)\n        birth = parse_date(payload.get(\"birth\"))\n        if birth > self.today:\n            raise ValueError(\"birth date is in the future\")\n        if age_on(birth.isoformat(), self.today) < self.settings.adult_age:\n            raise ValueError(\"members must be %d or older\" % self.settings.adult_age)\n        phone = normalize_phone(payload.get(\"phone\"))\n        if not is_mobile(phone):\n            raise ValueError(\"phone must be a mobile number\")\n        channel = str(payload.get(\"channel\", \"app\")).strip().lower()\n        if channel not in self.settings.channels:\n            raise ValueError(f\"unknown channel {channel}\")\n        return {\"name\": name, \"birth\": birth.isoformat(), \"phone\": phone, \"channel\": channel}\n\n    def register(self, payload):\n        fields = self.validate(payload)\n        if self.repo.by_phone(fields[\"phone\"]) is not None:\n            raise Conflict(\"phone number already registered\")\n        member = Member(member_id=self.repo.next_id(), **fields)\n        member.history.append(PENDING)\n        return self.repo.add(member)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018guMjoKj12s2zWFVAR8x8v","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
