30\t}\n    31\t\n    32\texport function reminderKey(kind: ReminderKind, autopayId: string, dueAt: LocalDateTime): string {\n    33\t  return `rmd.${autopayId}.${KIND_CODE[kind]}.${dueAt.slice(0, 10).replace(/-/g, \"\")}`;\n    34\t}\n==== src/repository/reminderRepository.ts\n     1\timport { Reminder } from \"../domain/reminder\";\n     2\timport { LocalDate } from \"../time/localTime\";\n     3\t\n     4\t/** 예약해 둔 알림 — 키 단위로 한 번만 저장된다. */\n     5\texport class ReminderRepository {\n     6\t  private readonly rows = new Map<string, Reminder>();\n     7\t\n     8\t  has(key: string): boolean {\n     9\t    return this.rows.has(key);\n    10\t  }\n    11\t\n    12\t  save(r: Reminder): void {\n    13\t    this.rows.set(r.key, { ...r });\n    14\t  }\n    15\t\n    16\t  find(key: string): Reminder | undefined {\n    17\t    const r = this.rows.get(key);\n    18\t    return r ? { ...r } : undefined;\n    19\t  }\n    20\t\n    21\t  byPlanDate(date: LocalDate): Reminder[] {\n    22\t    return [...this.rows.values()]\n    23\t      .filter((r) => r.planDate === date)\n    24\t      .sort((a, b) => (a.sendAt < b.sendAt ? -1 : a.sendAt > b.sendAt ? 1 : a.key < b.key ? -1 : 1))\n    25\t      .map((r) => ({ ...r }));\n    26\t  }\n    27\t\n    28\t  byAutopay(autopayId: string): Reminder[] {\n    29\t    return [...this.rows.values()].filter((r) => r.autopayId === autopayId).map((r) => ({ ...r }));\n    30\t  }\n    31\t\n    32\t  remove(key: string): void {\n    33\t    this.rows.delete(key);\n    34\t  }\n    35\t}\n==== src/api/routes.ts\n     1\timport { AppConfig } from \"../config\";\n     2\timport { validateAutopay } from \"../domain/autopay\";\n     3\timport { validateMember } from \"../domain/member\";\n     4\timport { normalizeDevice } from \"../push/deviceToken\";\n     5\timport { PushqClient } from \"../push/pushqClient\";\n     6\timport { ReminderReportBuilder } from \"../report/reminderReport\";\n     7\timport { AutopayRepository } from \"../repository/autopayRepository\";\n     8\timport { MemberRepository } from \"../repository/memberRepository\";\n     9\timport { ReminderService } from \"../service/reminderService\";\n    10\timport { isLocalDateTime } from \"../time/localTime\";\n    11\timport { notFound, ok, Router } from \"./router\";\n    12\t\n    13\tconst DATE = /^\\d{4}-\\d{2}-\\d{2}$/;\n    14\t\n    15\texport function mountAccountRoutes(router: Router, config: AppConfig, members: MemberRepository, autopays: AutopayRepository): void {\n    16\t  router.add(\"POST\", \"/members\", (_p, body) => {\n    17\t    const m = validateMember(body, config.allowedLeads);\n    18\t    return ok(members.save({ ...m, device: normalizeDevice(m.device) }));\n    19\t  });\n    20\t\n    21\t  router.add(\"POST\", \"/autopays\", (_p, body) => {\n    22\t    const input = validateAutopay(body);\n    23\t    if (!members.find(input.memberId)) return notFound(`member ${input.memberId}`);\n    24\t    return ok(autopays.create(input));\n    25\t  });\n    26\t}\n    27\t\n    28\texport function mountReminderRoutes(\n    29\t  router: Router,\n    30\t  service: ReminderService,\n    31\t  report: ReminderReportBuilder,\n    32\t  members: MemberRepository,\n    33\t  push: PushqClient,\n    34\t): void {\n    35\t  router.add(\"POST\", \"/reminders/plan\", (_p, body) => {\n    36\t    const date = (body as { date?: unknown } | undefined)?.date;\n    37\t    if (typeof date !== \"string\" || !DATE.test(date)) throw new Error(\"date must be YYYY-MM-DD\");\n    38\t    return ok(service.planDay(date));\n    39\t  });\n    40\t\n    41\t  router.add(\"POST\", \"/autopays/:id/failures\", (p, body) => ok(service.recordFailure(p.id, body)));\n    42\t\n    43\t  router.add(\"POST\", \"/autopays/:id/cancel\", (p) => ok(service.cancelAutopay(p.id)));\n    44\t\n    45\t  router.add(\"POST\", \"/clock\", (_p, body) => {\n    46\t    const until = (body as { until?: unknown } | undefined)?.until;\n    47\t    if (!isLocalDateTime(until)) throw new Error(\"until must be YYYY-MM-DDTHH:MM:SS\");\n    48\t    return ok(service.advance(until));\n    49\t  });\n    50\t\n    51\t  router.add(\"GET\", \"/reports/reminders/:date\", (p) => {\n    52\t    if (!DATE.test(p.date)) throw new Error(\"date must be YYYY-MM-DD\");\n    53\t    return ok(report.build(p.date, service.now()));\n    54\t  });\n    55\t\n    56\t  router.add(\"GET\", \"/members/:id/notifications\", (p) => {\n    57\t    const m = members.find(p.id);\n    58\t    if (!m) return notFound(`member ${p.id}`);\n    59\t    const notifications = push.delivered(m.device).map((d) => ({ at: d.at, tag: d.tag, message: d.message }));\n    60\t    return ok({ memberId: m.id, notifications });\n    61\t  });\n    62\t}\n==== src/push/messageTemplates.ts\n     1\timport { Autopay } from \"../domain/autopay\";\n     2\timport { ReminderKind } from \"../domain/reminder\";\n     3\timport { LocalDateTime, timeOf } from \"../time/localTime\";\n     4\timport { shortMerchant, won } from \"../util/money\";\n     5\t\n     6\tfunction whenText(dueAt: LocalDateTime): string {\n     7\t  const [, mo, d] = dueAt.slice(0, 10).split(\"-\").map(Number);\n     8\t  return `${mo}/${d} ${timeOf(dueAt)}`;\n     9\t}\n    10\t\n    11\texport function renderMessage(kind: ReminderKind, autopay: Autopay, dueAt: LocalDateTime): string {\n    12\t  const m = shortMerchant(autopay.merchant);\n    13\t  const amount = won(autopay.amount);\n    14\t  switch (kind) {\n    15\t    case \"BILL_DUE\":\n    16\t      return `[한빛페이] ${m} 자동이체 ${amount}이 ${whenText(dueAt)}에 출금됩니다. 잔액을 확인해 주세요.`;\n    17\t    case \"RETRY\":\n    18\t      return `[한빛페이] ${m} 자동이체 ${amount} 출금이 실패해 ${whenText(dueAt)}에 다시 출금합니다.`;\n    19\t  }\n    20\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"ad03aded-4355-487a-b756-7f5067996cf7","uuid":"d9d74c75-aeab-48a7-bce2-31d0e12fd7c4","timestamp":"2026-10-08T18:28:06.889Z","tool_use_result":{"stdout":"==== src/report/reminder