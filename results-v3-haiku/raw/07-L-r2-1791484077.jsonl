    22\t}\n    23\t\n    24\t/** 앱 푸시 예약 벤더 CLI(pushq 2.x) 래퍼 */\n    25\texport class PushqClient {\n    26\t  constructor(private readonly bin: string, private readonly home: string) {}\n    27\t\n    28\t  private run(args: string[]): string {\n    29\t    const r = spawnSync(this.bin, args, {\n    30\t      encoding: \"utf8\",\n    31\t      env: { ...process.env, PUSHQ_HOME: this.home },\n    32\t    });\n    33\t    if (r.error) throw r.error;\n    34\t    if (r.status !== 0) {\n    35\t      const code = /E\\d+/.exec(r.stderr)?.[0] ?? \"E?\";\n    36\t      throw new PushqError(code, r.status);\n    37\t    }\n    38\t    return r.stdout;\n    39\t  }\n    40\t\n    41\t  /** 지정 시각 발송을 예약하고 티켓 번호를 돌려준다. */\n    42\t  schedule(device: string, at: LocalDateTime, tag: string, message: string): string {\n    43\t    const out = this.run([\"schedule\", \"--to\", device, \"--at\", at, \"--tag\", tag, message]);\n    44\t    const m = /^ticket (T\\d+)$/m.exec(out);\n    45\t    if (!m) throw new PushqError(\"unparsed-output\", 0);\n    46\t    return m[1];\n    47\t  }\n    48\t\n    49\t  cancel(ticket: string): void {\n    50\t    this.run([\"cancel\", ticket]);\n    51\t  }\n    52\t\n    53\t  /** 벤더 시계를 until 까지 진행시켜 그 사이 예약분을 내보낸다. */\n    54\t  advance(until: LocalDateTime): number {\n    55\t    const out = this.run([\"run\", \"--until\", until]);\n    56\t    const m = /^delivered (\\d+)$/m.exec(out);\n    57\t    if (!m) throw new PushqError(\"unparsed-output\", 0);\n    58\t    return Number(m[1]);\n    59\t  }\n    60\t\n    61\t  queued(device?: string): QueuedPush[] {\n    62\t    const out = this.run(device ? [\"list\", \"--to\", device] : [\"list\"]);\n    63\t    return rows(out).map(([ticket, at, dev, tag]) => ({ ticket, at, device: dev, tag }));\n    64\t  }\n    65\t\n    66\t  delivered(device?: string): DeliveredPush[] {\n    67\t    const out = this.run(device ? [\"log\", \"--to\", device] : [\"log\"]);\n    68\t    return rows(out).map(([at, 