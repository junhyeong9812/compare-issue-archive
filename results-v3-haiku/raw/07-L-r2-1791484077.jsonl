TCSeconds())}`\n  );\n}\n\nexport function isLocalDateTime(t: unknown): t is LocalDateTime {\n  if (typeof t !== \"string\" || !RE.test(t)) return false;\n  try {\n    toEpochSeconds(t);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nexport function addMinutes(t: LocalDateTime, minutes: number): LocalDateTime {\n  return fromEpochSeconds(toEpochSeconds(t) + minutes * 60);\n}\n\nexport function compare(a: LocalDateTime, b: LocalDateTime): number {\n  return toEpochSeconds(a) - toEpochSeconds(b);\n}\n\nexport function dateOf(t: LocalDateTime): LocalDate {\n  return t.slice(0, 10);\n}\n\nexport function timeOf(t: LocalDateTime): string {\n  return t.slice(11, 16);\n}\n\n/** \"2026-10-12\" + \"13:47\" → \"2026-10-12T13:47:00\" */\nexport function at(date: LocalDate, hhmm: string): LocalDateTime {\n  const t = `${date}T${hhmm}:00`;\n  toEpochSeconds(t);\n  return t;\n}\n\nexport function dayOfMonth(date: LocalDate): number {\n  return Number(date.slice(8, 10));\n}\n\nexport function previousDate(date: LocalDate): LocalDate {\n  return dateOf(addMinutes(at(date, \"00:00\"), -1440));\n}\n","structuredPatch":[{"oldStart":46,"oldLines":6,"newStart":46,"newLines":12,"lines":["   return fromEpochSeconds(toEpochSeconds(t) + minutes * 60);"," }"," ","+/** 직전 5분 경계(분 % 5 == 0, 초 00)로 내린다. 올림은 약속 시각보다 늦어지므로 쓰지 않는다. */","+export function floorToFiveMinutes(t: LocalDateTime): LocalDateTime {","+  const step = 300;","+  return fromEpochSeconds(Math.floor(toEpochSeconds(t) / step) * step);","+}","+"," export function compare(a: LocalDateTime, b: LocalDateTime): number {","   return toEpochSeconds(a) - toEpochSeconds(b);"," }"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_0139dMFHnMHg2gBNBcLSQyu5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
