39\t    },\n    40\t    plan(date: string): { planned: number; scheduled: number; alreadyScheduled: number; skippedOptOut: number } {\n    41\t      return call(\"POST\", \"/reminders/plan\", { date }) as { planned: number; scheduled: number; alreadyScheduled: number; skippedOptOut: number };\n    42\t    },\n    43\t    fail(autopayId: string, failedAt: string): void {\n    44\t      call(\"POST\", `/autopays/${autopayId}/failures`, { failedAt });\n    45\t    },\n    46\t    cancel(autopayId: string): void {\n    47\t      call(\"POST\", `/autopays/${autopayId}/cancel`);\n    48\t    },\n    49\t    clock(until: string): void {\n    50\t      call(\"POST\", \"/clock\", { until });\n    51\t    },\n    52\t    report(date: string): Report {\n    53\t      return call(\"GET\", `/reports/reminders/${date}`) as Report;\n    54\t    },\n    55\t    inbox(memberId: string): Notifications[\"notifications\"] {\n    56\t      return (call(\"GET\", `/members/${memberId}/notifications`) as Notifications).notifications;\n    57\t    },\n    58\t  };\n    59\t}\n    60\t\n    61\ttest(\"every autopay customer gets the withdrawal reminder in time on billing day\", () => {\n    62\t  const w = world();\n    63\t  w.member(\"M1001\", \"김하늘\", \"ios:Hb7cQ2xk91ZpA\", 30);\n    64\t  w.member(\"M1002\", \"이도윤\", \"and:fT0p3LmQw8eR\", 60);\n    65\t  w.member(\"M1003\", \"박서연\", \" IOS:Zx81kQpLm0Ty \", 30);\n    66\t  w.member(\"M1004\", \"최민준\", \"and:Pq19sXkLm2Vb\", 10);\n    67\t  w.member(\"M1005\", \"정지우\", \"ios:Nn41tRe7Ku3Q\", 1440);\n    68\t\n    69\t  const phone = w.autopay(\"M1001\", \"한빛모바일 통신요금\", 55000, 12, \"08:00\");\n    70\t  w.autopay(\"M1002\", \"든든손해보험\", 89000, 12, \"10:20\");\n    71\t  w.autopay(\"M1003\", \"스트림플러스 구독\", 13900, 12, \"13:47\");\n    72\t  w.autopay(\"M1004\", \"푸른마을 관리비\", 187420, 12, \"18:33\");\n    73\t  w.autopay(\"M1005\", \"새싹수학학원\", 320000, 12, \"09:00\");\n    74\t\n    75\t  const plan = w.plan(\"2026-10-12\");\n    76\t  eq([plan.planned, plan.scheduled], [5, 5], \"reminders planned for the 12th\");\n    77\t\n    78\t  // 08:00 출금이 잔액 부족으로 실패 → 2시간 뒤 재출금, 그 30분 전에 안내\n    79\t  w.clock(\"2026-10-12T08:00:37\");\n    80\t  w.fail(phone, \"2026-10-12T08:00:37\");\n    81\t  w.clock(\"2026-10-12T23:59:00\");\n    82\t\n    83\t  const r = w.report(\"2026-10-12\");\n    84\t  eq(r.lines.filter((l) => l.status !== \"발송\").map((l) => `${l.memberId} ${l.kind}`), [], \"reminders not delivered\");\n    85\t  eq([r.planned, r.delivered, r.missing], [6, 6, 0], `report counts (${r.text})`);\n    86\t\n    87\t  // 고객이 설정한 시점보다 늦게 도착하면 안 된다\n    88\t  const latest: [string, string[], string][] = [\n    89\t    [\"M1001\", [\"2026-10-12T07:30:00\", \"2026-10-12T09:30:37\"], \"한빛모바일\"],\n    90\t    [\"M1002\", [\"2026-10-12T09:20:00\"], \"든든손해보험\"],\n    91\t    [\"M1003\", [\"2026-10-12T13:17:00\"], \"스트림플러스\"],\n    92\t    [\"M1004\", [\"2026-10-12T18:23:00\"], \"푸른마을\"],\n    93\t    [\"M1005\", [\"2026-10-11T09:00:00\"], \"새싹수학학원\"],\n    94\t  ];\n    95\t  for (const [id, deadlines, merchant] of latest) {\n    96\t    const inbox = w.inbox(id);\n    97\t    eq(inbox.length, deadlines.length, `pushes received by ${id}`);\n    98\t    inbox.forEach((n, i) => {\n    99\t      assert(n.at <= deadlines[i], `${id} push #${i + 1} arrived at ${n.at}, later than ${deadlines[i]}`);\n   100\t      assert(n.message.includes(merchant), `${id} push mentions ${merchant}`);\n   101\t    });\n   102\t  }\n   103\t});\n   104\t\n   105\ttest(\"customers who turned pushes off are skipped and counted\", () => {\n   106\t  const w = world();\n   107\t  w.member(\"M2001\", \"한지민\", \"ios:Aa11bB22cC33\", 30);\n   108\t  w.member(\"M2002\", \"오세훈\", \"and:Dd44eE55fF66\", 30, false);\n   109\t  w.autopay(\"M2001\", \"든든손해보험\", 42000, 3, \"09:00\");\n   110\t  w.autopay(\"M2002\", \"든든손해보험\", 42000, 3, \"09:00\");\n   111\t  const plan = w.plan(\"2026-11-03\");\n   112\t  eq([plan.planned, plan.skippedOptOut], [1, 1], \"planned / opted out\");\n   113\t  w.clock(\"2026-11-03T12:00:00\");\n   114\t  eq(w.inbox(\"M2001\").length, 1, \"opted-in customer\");\n   115\t  eq(w.inbox(\"M2002\"), [], \"opted-out customer\");\n   116\t});\n   117\t\n   118\ttest(\"planning the same day twice does not double-book, and cancelled contracts stay quiet\", () => {\n   119\t  const w = world();\n   120\t  w.member(\"M3001\", \"서지호\", \"ios:Gg77hH88iI99\", 60);\n   121\t  w.member(\"M3002\", \"윤시우\", \"and:Jj00kK11lL22\", 30);\n   122\t  w.autopay(\"M3001\", \"한빛모바일 통신요금\", 61000, 20, \"11:00\");\n   123\t  const gym = w.autopay(\"M3002\", \"바른필라테스\", 99000, 20, \"07:30\");\n   124\t  eq(w.plan(\"2026-10-20\").scheduled, 2, \"first planning\");\n   125\t  const again = w.plan(\"2026-10-20\");\n   126\t  eq([again.scheduled, again.alreadyScheduled], [0, 2], \"second planning\");\n   127\t  w.cancel(gym);\n   128\t  w.clock(\"2026-10-20T23:00:00\");\n   129\t  eq(w.inbox(\"M3001\").length, 1, \"one reminder, not two\");\n   130\t  eq(w.inbox(\"M3002\"), [], \"cancelled contract\");\n   131\t});\n   132\t\n   133\trun();\n=== tests/harness.ts\n     1\ttype Fn = () => void;\n     2\tconst registered: [string, Fn][] = [];\n     3\tconst cleanups: (() => void)[] = [];\n     4\t\n     5\texport function test(name: string, fn: Fn): void {\n     6\t  registered.push([name, fn]);\n     7\t}\n     8\t\n     9\texport function onCleanup(fn: () => void): void {\n    10\t  cleanups.push(fn);\n    11\t}\n    12\t\n    13\texport function eq(actual: unknown, expected: unknown, label: string): void {\n    14\t  const a = JSON.stringify(actual);\n    15\t  const e = JSON.stringify(expected);\n    16\t  if (a !== e) throw new Error(`${label}: expected ${e}, got ${a}`);\n    17\t}\n    18\t\n    19\texport function assert(cond: boolean, label: string): void {\n    20\t  if (!cond) throw new Error(label);\n    21\t}\n    22\t\n    23\texport function run(): void {\n    24\t  let failed = 0;\n    25\t  for (const [name, fn] of registered) {\n    26\t    try {\n    27\t      fn();\n    28\t      console.log(`ok   - ${name}`);\n    29\t    } catch (e) {\n    30\t      failed++;\n    31\t      console.log(`FAIL - ${name}: ${e instanceof Error ? e.message : String(e)}`);\n    32\t    }\n    33\t  }\n    34\t  for (const c of cleanups) {\n    35\t    try {\n    36\t      c();\n    37\t    } catch {\n    38\t      /* ignore */\n    39\t    }\n    40\t  }\n    41\t  console.log(failed === 0 ? \"all passed\" : `${failed} failed`);\n    42\t  process.exitCode = failed === 0 ? 0 : 1;\n    43\t}\n=== src/push/pushqClient.ts\n     1\timport { spawnSync } from \"child_process\";\n     2\timport { LocalDateTime } from \"../time/localTime\";\n     3\t\n     4\texport interface QueuedPush {\n     5\t  ticket: string;\n     6\t  at: LocalDateTime;\n     7\t  device: string;\n     8\t  tag: string;\n     9\t}\n    10\t\n    11\texport interface DeliveredPush {\n    12\t  at: LocalDateTime;\n    13\t  device: string;\n    14\t  tag: string;\n    15\t  message: string;\n    16\t}\n    17\t\n    18\texport class PushqError extends Error {\n    19\t  constructor(readonly code: string, readonly exitStatus: number | null) {\n    20\t    super(`pushq ${code} (exit ${exitStatus})`);\n    21\t  }\n    22\t}\n    23\t\n    24\t/** 앱 푸시 예약 벤더 CLI(pushq 2.x) 래퍼 */\n    25\texport class PushqClient {\n    26\t  constructor(private readonly bin: string, private readonly home: string) {}\n    27\t\n    28\t  private run(args: string[]): string {\n    29\t    const r = spawnSync(this.bin, args, {\n    30\t      encoding: \"utf8\",\n    31\t      env: { ...process.env, PUSHQ_HOME: this.home },\n    32\t    });\n    33\t    if (r.error) throw r.error;\n    34\t    if (r.status !== 0) {\n    35\t      const code = /E\\d+/.exec(r.stderr)?.[0] ?? \"E?\";\n    36\t      throw new PushqError(code, r.status);\n    37\t    }\n    38\t    return r.stdout;\n    39\t  }\n    40\t\n    41\t  /** 지정 시각 발송을 예약하고 티켓 번호를 돌려준다. */\n    42\t  schedule(device: string, at: LocalDateTime, tag: string, message: string): string {\n    43\t    const out = this.run([\"schedule\", \"--to\", device, \"--at\", at, \"--tag\", tag, message]);\n    44\t    const m = /^ticket (T\\d+)$/m.exec(out);\n    45\t    if (!m) throw new PushqError(\"unparsed-output\", 0);\n    46\t    return m[1];\n    47\t  }\n    48\t\n    49\t  cancel(ticket: string): void {\n    50\t    this.run([\"cancel\", ticket]);\n    51\t  }\n    52\t\n    53\t  /** 벤더 시계를 until 까지 진행시켜 그 사이 예약분을 내보낸다. */\n    54\t  advance(until: LocalDateTime): number {\n    55\t    const out = this.run([\"run\", \"--until\", until]);\n    56\t    const m = /^delivered (\\d+)$/m.exec(out);\n    57\t    if (!m) throw new PushqError(\"unparsed-output\", 0);\n    58\t    return Number(m[1]);\n    59\t  }\n    60\t\n    61\t  queued(device?: string): QueuedPush[] {\n    62\t    const out = this.run(device ? [\"list\", \"--to\", device] : [\"list\"]);\n    63\t    return rows(out).map(([ticket, at, dev, tag]) => ({ ticket, at, device: dev, tag }));\n    64\t  }\n    65\t\n    66\t  delivered(device?: string): DeliveredPush[] {\n    67\t    const out = this.run(device ? [\"log\", \"--to\", device] : [\"log\"]);\n    68\t    return rows(out).map(([at, dev, tag, ...msg]) => ({ at, device: dev, tag, message: msg.join(\"\\t\") }));\n    69\t  }\n    70\t}\n    71\t\n    72\tfunction rows(out: string): string[][] {\n    73\t  return out\n    74\t    .split(\"\\n\")\n    75\t    .filter((l) => l !== \"\")\n    76\t    .map((l) => l.split(\"\\t\"));\n    77\t}\n=== src/service/reminderPlanner.ts\n     1\timport { Autopay } from \"../domain/autopay\";\n     2\timport { Member } from \"../domain/member\";\n     3\timport { Reminder, ReminderKind, reminderKey } from \"../domain/reminder\";\n     4\timport { renderMessage } from \"../push/messageTemplates\";\n     5\timport { AutopayRepository } from \"../repository/autopayRepository\";\n     6\timport { MemberRepository } from \"../repository/memberRepository\";\n     7\timport { SendTimePolicy } from \"../scheduling/sendTime\";\n     8\timport { at, dateOf, dayOfMonth, LocalDate, LocalDateTime } from \"../time/localTime\";\n     9\t\n    10\texport interface DayPlan {\n    11\t  reminders: Reminder[];\n    12\t  skippedOptOut: number;\n    13\t}\n    14\t\n    15\t/** 어떤 알림을 언제 보낼지 정한다(예약은 하지 않는다). */\n    16\texport class ReminderPlanner {\n    17\t  constructor(\n    18\t    private readonly members: MemberRepository,\n    19\t    private readonly autopays: AutopayRepository,\n    20\t    private readonly policy: SendTimePolicy,\n    21\t    private readonly retryNoticeLeadMinutes: number,\n    22\t  ) {}\n    23\t\n    24\t  /** 그날 출금되는 계약마다 출금 예정 알림 1건 */\n    25\t  billDue(date: LocalDate): DayPlan {\n    26\t    const reminders: Reminder[] = [];\n    27\t    let skippedOptOut = 0;\n    28\t    const seen = new Set<string>();\n    29\t    for (const a of this.autopays.billingOn(dayOfMonth(date))) {\n    30\t      const m = this.members.find(a.memberId);\n    31\t      if (!m) continue;\n    32\t      if (!m.pushOptIn) {\n    33\t        skippedOptOut++;\n    34\t        continue;\n    35\t      }\n    36\t      const dueAt = at(date, a.billingTime);\n    37\t      const r = this.build(\"BILL_DUE\", a, m, dueAt, m.leadMinutes);\n    38\t      if (seen.has(r.key)) continue;\n    39\t      seen.add(r.key);\n    40\t      reminders.push(r);\n    41\t    }\n    42\t    return { reminders, skippedOptOut };\n    43\t  }\n    44\t\n    45\t  /** 출금 실패 → 재출금 안내 1건(수신 거부면 없음) */\n    46\t  retryNotice(autopay: Autopay, retryAt: LocalDateTime): Reminder | undefined {\n    47\t    const m = this.members.find(autopay.memberId);\n    48\t    if (!m || !m.pushOptIn) return undefined;\n    49\t    return this.build(\"RETRY\", autopay, m, retryAt, this.retryNoticeLeadMinutes);\n    50\t  }\n    51\t\n    52\t  private build(kind: ReminderKind, a: Autopay, m: Member, dueAt: LocalDateTime, lead: number): Reminder {\n    53\t    return {\n    54\t      key: reminderKey(kind, a.id, dueAt),\n    55\t      kind,\n    56\t      memberId: m.id,\n    57\t      autopayId: a.id,\n    58\t      device: m.device,\n    59\t      dueAt,\n    60\t      sendAt: this.policy.sendAt(dueAt, lead),\n    61\t      planDate: dateOf(dueAt),\n    62\t      message: renderMessage(kind, a, dueAt),\n    63\t    };\n    64\t  }\n    65\t}\n=== src/service/reminderService.ts\n     1\timport { validateFailure } from \"../domain/autopay\";\n     2\timport { Reminder } from \"../domain/reminder\";\n     3\timport { PushqClient, PushqError } from \"../push/pushqClient\";\n     4\timport { AutopayRepository } from \"../repository/autopayRepository\";\n     5\timport { ReminderRepository } from \"../repository/reminderRepository\";\n     6\timport { addMinutes, compare, LocalDate, LocalDateTime } from \"../time/localTime\";\n     7\timport { ReminderPlanner } from \"./reminderPlanner\";\n     8\t\n     9\texport interface PlanResult {\n    10\t  date: LocalDate;\n    11\t  planned: number;\n    12\t  scheduled: number;\n    13\t  alreadyScheduled: number;\n    14\t  skippedOptOut: number;\n    15\t}\n    16\t\n    17\t/** 알림 예약·취소와 벤더 시계 진행 */\n    18\texport class ReminderService {\n    19\t  private clock: LocalDateTime | undefined;\n    20\t\n    21\t  constructor(\n    22\t    private readonly planner: ReminderPlanner,\n    23\t    private readonly autopays: AutopayRepository,\n    24\t    private readonly reminders: ReminderRepository,\n    25\t    private readonly push: PushqClient,\n    26\t    private readonly retryDelayMinutes: number,\n    27\t  ) {}\n    28\t\n    29\t  now(): LocalDateTime | undefined {\n    30\t    return this.clock;\n    31\t  }\n    32\t\n    33\t  /** 하루치 출금 예정 알림을 예약한다. 다시 불러도 이미 예약한 알림은 건너뛴다. */\n    34\t  planDay(date: LocalDate): PlanResult {\n    35\t    const plan = this.planner.billDue(date);\n    36\t    let scheduled = 0;\n    37\t    let already = 0;\n    38\t    for (const r of plan.reminders) {\n    39\t      if (this.reminders.has(r.key)) {\n    40\t        already++;\n    41\t        continue;\n    42\t      }\n    43\t      this.schedule(r);\n    44\t      scheduled++;\n    45\t    }\n    46\t    return { date, planned: plan.reminders.length, scheduled, alreadyScheduled: already, skippedOptOut: plan.skippedOptOut };\n    47\t  }\n    48\t\n    49\t  /** 출금 실패를 기록하고 재출금 안내를 예약한다. */\n    50\t  recordFailure(autopayId: string, body: unknown): { retryAt: LocalDateTime; notice?: { key: string; sendAt: LocalDateTime } } {\n    51\t    const a = this.autopays.find(autopayId);\n    52\t    if (!a) throw new Error(`autopay ${autopayId} not found`);\n    53\t    const f = validateFailure(autopayId, body);\n    54\t    this.autopays.addFailure(f);\n    55\t    const retryAt = addMinutes(f.failedAt, this.retryDelayMinutes);\n    56\t    const r = this.planner.retryNotice(a, retryAt);\n    57\t    if (!r || this.reminders.has(r.key)) return { retryAt };\n    58\t    this.schedule(r);\n    59\t    return { retryAt, notice: { key: r.key, sendAt: r.sendAt } };\n    60\t  }\n    61\t\n    62\t  /** 계약 해지 — 아직 나가지 않은 알림 예약을 취소한다. */\n    63\t  cancelAutopay(autopayId: string): { cancelled: number } {\n    64\t    this.autopays.deactivate(autopayId);\n    65\t    let cancelled = 0;\n    66\t    for (const r of this.reminders.byAutopay(autopayId)) {\n    67\t      if (!r.ticket || (this.clock && compare(r.sendAt, this.clock) <= 0)) continue;\n    68\t      try {\n    69\t        this.push.cancel(r.ticket);\n    70\t        cancelled++;\n    71\t      } catch (e) {\n    72\t        // 이미 나간 티켓은 벤더가 E31 을 준다 — 취소할 것이 없으므로 넘어간다.\n    73\t        if (!(e instanceof PushqError && e.code === \"E31\")) throw e;\n    74\t      }\n    75\t      this.reminders.remove(r.key);\n    76\t    }\n    77\t    return { cancelled };\n    78\t  }\n    79\t\n    80\t  /** 벤더 시계를 until 까지 진행한다(운영에서는 벤더가 스스로 흐른다). */\n    81\t  advance(until: LocalDateTime): { delivered: number } {\n    82\t    const delivered = this.push.advance(until);\n    83\t    this.clock = until;\n    84\t    return { delivered };\n    85\t  }\n    86\t\n    87\t  private schedule(r: Reminder): void {\n    88\t    const ticket = this.push.schedule(r.device, r.sendAt, r.key, r.message);\n    89\t    this.reminders.save({ ...r, ticket });\n    90\t  }\n    91\t}\n=== src/scheduling/sendTime.ts\n     1\timport { addMinutes, LocalDateTime } from \"../time/localTime\";\n     2\timport { QuietHours } from \"./quietHours\";\n     3\t\n     4\t/**\n     5\t * 알림 발송 시각 정책.\n     6\t * - 안내 대상 시각(출금·재출금)보다 lead 분 앞서 보낸다.\n     7\t * - 야간 방해 금지 구간에 걸리면 전날 저녁으로 당긴다.\n     8\t * 결과는 그대로 푸시 예약 시각이 된다.\n     9\t */\n    10\texport class SendTimePolicy {\n    11\t  constructor(private readonly quiet: QuietHours) {}\n    12\t\n    13\t  sendAt(dueAt: LocalDateTime, leadMinutes: number): LocalDateTime {\n    14\t    const nominal = addMinutes(dueAt, -leadMinutes);\n    15\t    return this.quiet.pullBack(nominal);\n    16\t  }\n    17\t}\n=== src/scheduling/quietHours.ts\n     1\timport { at, dateOf, LocalDateTime, previousDate, timeOf } from \"../time/localTime\";\n     2\t\n     3\t/**\n     4\t * 야간 방해 금지 — [start, end) 구간(자정을 넘는다)에 걸린 알림은\n     5\t * 늦게 보내지 않고 직전 저녁(fallback 시각)으로 당긴다. 금융 알림은 늦으면 안 되기 때문이다.\n     6\t */\n     7\texport class QuietHours {\n     8\t  constructor(\n     9\t    private readonly start: string,\n    10\t    private readonly end: string,\n    11\t    private readonly fallback: string,\n    12\t  ) {}\n    13\t\n    14\t  contains(t: LocalDateTime): boolean {\n    15\t    const hm = timeOf(t);\n    16\t    return this.start > this.end ? hm >= this.start || hm < this.end : hm >= this.start && hm < this.end;\n    17\t  }\n    18\t\n    19\t  /** 구간 밖이면 그대로, 안이면 직전 저녁 fallback 시각 */\n    20\t  pullBack(t: LocalDateTime): LocalDateTime {\n    21\t    if (!this.contains(t)) return t;\n    22\t    const d = dateOf(t);\n    23\t    const eveningOf = timeOf(t) >= this.start ? d : previousDate(d);\n    24\t    return at(eveningOf, this.fallback);\n    25\t  }\n    26\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"52d5bb0f-b422-4e09-b6f6-962a9d1ad7ee","uuid":"1e604925-9846-4cb7-8ec1-d793b9dfaea7","timestamp":"2026-10-08T18:21:20.910Z","tool_use_result":{"stdout":"=== tests/reminders.e2e.test.ts\n     1\timport { mkdtempSync, rmSync } from \"fs\";\n     2\timport { tmpdir } from \"os\";\n     3\timport { join } from \"path\";\n     4\timport { App, createApp } from \"../src/app\";\n     5\timport { assert, eq, onCleanup, run, test } from \"./harness\";\n     6\t\n     7\tinterface Report {\n     8\t  planned: number;\n     9\t  delivered: number;\n    10\t  missing: number;\n    11\t  pending: number;\n    12\t  lines: { key: string; memberId: string; kind: string; status: string; sendAt: string }[];\n    13\t  text: string;\n    14\t}\n    15\t\n    16\tinterface Notifications {\n    17\t  memberId: string;\n    18\t  notifications: { at: string; tag: string; message: string }[];\n    19\t}\n    20\t\n    21\t/** 빈 pushq 상태 디렉토리를 가진 앱 하나 */\n    22\tfunction world() {\n    23\t  const home = mkdtempSync(join(tmpdir(), \"autopay-rmd-\"));\n    24\t  onCleanup(() => rmSync(home, { recursive: true, force: true }));\n    25\t  const app: App = createApp({ pushqHome: home, pushqBin: join(process.cwd(), \"vendor\", \"bin\", \"pushq\") });\n    26\t\n    27\t  const call = (method: string, url: string, body?: unknown): unknown => {\n    28\t    const r = app.handle(method, url, body);\n    29\t    eq(r.status, 200, `${method} ${url} → ${JSON.stringify(r.body)}`);\n    30\t    return r.body;\n    31\t  };\n    32\t\n    33\t  return {\n    34\t    member(id: string, name: string, device: string, leadMinutes: number, pushOptIn = true): void {\n    35\t      call(\"POST\", \"/members\", { id, name, device, leadMinutes, pushOptIn });\n    36\t    },\n    37\t    autopay(memberId: string, merchant: string, amount: number, billingDay: number, billingTime: string): string {\n    38\t      return (call(\"POST\", \"/autopays\", { memberId, merchant, amount, billingDay, billingTime }) as { id: string }).id;\n    39\t    },\n    40\t    plan(date: string): { planned: number; scheduled: number; alreadyScheduled: number; skippedOptOut: number } {\n    41\t      return call(\"POST\", \"/reminders/plan\", { date }) as { planned: number; scheduled: number; alreadyScheduled: number; skippedOptOut: number };\n    42\t    },\n    43\t    fail(autopayId: string, failedAt: string): void {\n    44\t      call(\"POST\", `/autopays/${autopayId}/failures`, { failedAt });\n    45\t    },\n    46\t    cancel(autopayId: string): void {\n    47\t      call(\"POST\", `/autopays/${autopayId}/cancel`);\n    48\t    },\n    49\t    clock(until: string): void {\n    50\t      call(\"POST\", \"/clock\", { until });\n    51\t    },\n    52\t    report(date: string): Report {\n    53\t      return call(\"GET\", `/reports/reminders/${date}`) as Report;\n    54\t    },\n    55\t    inbox(memberId: string): Notifications[\"notifications\"] {\n    56\t      return (call(\"GET\", `/members/${memberId}/notifications`) as Notifications).notifications;\n    57\t    },\n    58\t  };\n    59\t}\n    60\t\n    61\ttest(\"every autopay customer gets the withdrawal reminder in time on billing day\", () => {\n    62\t  const w = world();\n    63\t  w.member(\"M1001\", \"김하늘\", \"ios:Hb7cQ2xk91ZpA\", 30);\n    64\t  w.member(\"M1002\", \"이도윤\", \"and:fT0p3LmQw8eR\", 60);\n    65\t  w.member(\"M1003\", \"박서연\", \" IOS:Zx81kQpLm0Ty \", 30);\n    66\t  w.member(\"M1004\", \"최민준\", \"and:Pq19sXkLm2Vb\", 10);\n    67\t  w.member(\"M1005\", \"정지우\", \"ios:Nn41tRe7Ku3Q\", 1440);\n    68\t\n    69\t  const phone = w.autopay(\"M1001\", \"한빛모바일 통신요금\", 55000, 12, \"08:00\");\n    70\t  w.autopay(\"M1002\", \"든든손해보험\", 89000, 12, \"10:20\");\n    71\t  w.autopay(\"M1003\", \"스트림플러스 구독\", 13900, 12, \"13:47\");\n    72\t  w.autopay(\"M1004\", \"푸른마을 관리비\", 187420, 12, \"18:33\");\n    73\t  w.autopay(\"M1005\", \"새싹수학학원\", 320000, 12, \"09:00\");\n    74\t\n    75\t  const plan = w.plan(\"2026-10-12\");\n    76\t  eq([plan.planned, plan.scheduled], [5, 5], \"reminders planned for the 12th\");\n    77\t\n    78\t  // 08:00 출금이 잔액 부족으로 실패 → 2시간 뒤 재출금, 그 30분 전에 안내\n    79\t  w.clock(\"2026-10-12T08:00:37\");\n    80\t  w.fail(phone, \"2026-10-12T08:00:37\");\n    81\t  w.clock(\"2026-10-12T23:59:00\");\n    82\t\n    83\t  const r = w.report(\"2026-10-12\");\n    84\t  eq(r.lines.filter((l) => l.status !== \"발송\").map((l) => `${l.memberId} ${l.kind}`), [], \"reminders not delivered\");\n    85\t  eq([r.planned, r.delivered, r.missing], [6, 6, 0], `report counts (${r.text})`);\n    86\t\n    87\t  // 고객이 설정한 시점보다 늦게 도착하면 안 된다\n    88\t  const latest: [string, string[], string][] = [\n    89\t    [\"M1001\", [\"2026-10-12T07:30:00\", \"2026-10-12T09:30:37\"], \"한빛모바일\"],\n    90\t    [\"M1002\", [\"2026-10-12T09:20:00\"], \"든든손해보험\"],\n    91\t    [\"M1003\", [\"2026-10-12T13:17:00\"], \"스트림플러스\"],\n    92\t    [\"M1004\", [\"2026-10-12T18:23:00\"], \"푸른마을\"],\n    93\t    [\"M1005\", [\"2026-10-11T09:00:00\"], \"새싹수학학원\"],\n    94\t  ];\n    95\t  for (const [id, deadlines, merchant] of latest) {\n    96\t    const inbox = w.inbox(id);\n    97\t    eq(inbox.length, deadlines.length, `pushes received by ${id}`);\n    98\t    inbox.forEach((n, i) => {\n    99\t      assert(n.at <= deadlines[i], `${id} push #${i + 1} arrived at ${n.at}, later than ${deadlines[i]}`);\n   100\t      assert(n.message.includes(merchant), `${id} push mentions ${merchant}`);\n   101\t    });\n   102\t  }\n   103\t});\n   104\t\n   105\ttest(\"customers who turned pushes off are skipped and counted\", () => {\n   106\t  const w = world();\n   107\t  w.member(\"M2001\", \"한지민\", \"ios:Aa11bB22cC33\", 30);\n   108\t  w.member(\"M2002\", \"오세훈\", \"and:Dd44eE55fF66\", 30, false);\n   109\t  w.autopay(\"M