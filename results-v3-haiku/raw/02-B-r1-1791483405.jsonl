_from, \"--to\", date_to)\n    47\t        rows = []\n    48\t        for line in out.splitlines():\n    49\t            if not line or line.startswith(\"#\"):\n    50\t                continue\n    51\t            parts = line.split(\"\\t\", 5)\n    52\t            if len(parts) != 6:\n    53\t                continue\n    54\t            receipt, date, account, amount, ref, memo = parts\n    55\t            rows.append(LedgerRow(receipt, date, account, int(amount), ref, memo))\n    56\t        return rows\n    57\t\n    58\t    def show(self, receipt):\n    59\t        out = self._run(\"show\", receipt)\n    60\t        info = {}\n    61\t        for line in out.splitlines():\n    62\t            key, _, value = line.partition(\" \")\n    63\t            info[key] = value\n    64\t        return info\n=== hbexpense/ledger/entries.py\n     1\t\"\"\"Turns an approved expense claim into a ledger entry.\"\"\"\n     2\tfrom hbexpense.models import LedgerEntry\n     3\tfrom hbexpense.util.text import clip_chars, normalize\n     4\t\n     5\t\n     6\tdef compose_memo(claim):\n     7\t    \"\"\"Memo shown to the finance team: claim id, claimant, what it was for.\"\"\"\n     8\t    parts = [claim.claim_id, claim.claimant, claim.description]\n     9\t    return normalize(\" \".join(p for p in parts if p))\n    10\t\n    11\t\n    12\tdef build_entry(claim, settings):\n    13\t    account = settings.accounts.get(claim.category)\n    14\t    if account is None:\n    15\t        raise ValueError(f\"no ledger account for category {claim.category}\")\n    16\t    memo = clip_chars(compose_memo(claim), settings.ledger_memo_chars)\n    17\t    return LedgerEntry(\n    18\t        account=account,\n    19\t        amount=claim.amount,\n    20\t        date=claim.spent_on,\n    21\t        ref=claim.claim_id,\n    22\t        memo=memo,\n    23\t    )\n=== hbexpense/services/reports.py\n     1\t\"\"\"Month-end expense report, read back from the ledger.\"\"\"\n     2\tfrom hbexpense.util.dates import month_bounds\n     3\tfrom hbexpense.util.money import format_krw, total\n     4\t\n     5\t\n     6\tclass ReportService:\n     7\t    def __init__(self, repo, ledger, cache):\n     8\t        self.repo = repo\n     9\t        self.ledger = ledger\n    10\t        self.cache = cache\n    11\t\n    12\t    def invalidate(self, month):\n    13\t        self.cache.invalidate(f\"monthly:{month}\")\n    14\t\n    15\t    def _rows(self, month):\n    16\t        date_from, date_to = month_bounds(month)\n    17\t        rows = self.ledger.list_rows(date_from, date_to)\n    18\t        # a claim re-posted after a correction keeps the newest receipt only\n    19\t        latest = {}\n    20\t        for row in rows:\n    21\t            seen = latest.get(row.ref)\n    22\t            if seen is None or row.receipt > seen.receipt:\n    23\t                latest[row.ref] = row\n    24\t        return sorted(latest.values(), key=lambda r: (r.date, r.receipt))\n    25\t\n    26\t    def monthly(self, month):\n    27\t        key = f\"monthly:{month}\"\n    28\t        cached = self.cache.get(key)\n    29\t        if cached is not None:\n    30\t            return cached\n    31\t        rows = self._rows(month)\n    32\t        by_account, by_cost_center, lines = {}, {}, []\n    33\t        for row in rows:\n    34\t            by_account[row.account] = by_account.get(row.account, 0) + row.amount\n    35\t            claim = self.repo.by_ref(row.ref)\n    36\t            center = claim.cost_center if claim else \"UNKNOWN\"\n    37\t            by_cost_center[center] = by_cost_center.get(center, 0) + row.amount\n    38\t            lines.append({\n    39\t                \"receipt\": row.receipt,\n    40\t                \"date\": row.date,\n    41\t                \"ref\": row.ref,\n    42\t                \"account\": row.account,\n    43\t                \"amount\": row.amount,\n    44\t                \"memo\": row.memo,\n    45\t            })\n    46\t        grand = total(r.amount for r in rows)\n    47\t        report = {\n    48\t            \"month\": month,\n    49\t            \"entries\": len(rows),\n    50\t            \"total\": grand,\n    51\t            \"total_display\": format_krw(grand),\n    52\t            \"by_account\": dict(sorted(by_account.items())),\n    53\t            \"by_cost_center\": dict(sorted(by_cost_center.items())),\n    54\t            \"lines\": lines,\n    55\t        }\n    56\t        self.cache.put(key, report)\n    57\t        return report\n=== hbexpense/services/settlement.py\n     1\t\"\"\"Month-end settlement: posts approved claims to the vendor ledger.\"\"\"\n     2\tfrom hbexpense.ledger.entries import build_entry\n     3\tfrom hbexpense.models import APPROVED, POSTED\n     4\t\n     5\t\n     6\tclass SettlementService:\n     7\t    def __init__(self, repo, ledger, settings, on_posted=None):\n     8\t        self.repo = repo\n     9\t        self.ledger = ledger\n    10\t        self.settings = settings\n    11\t        self.on_posted = on_posted\n    12\t\n    13\t    def run(self, month):\n    14\t        posted, failed = [], []\n    15\t        claims = sorted(\n    16\t            (c for c in self.repo.in_month(month) if c.status == APPROVED),\n    17\t            key=lambda c: (c.spent_on, c.claim_id),\n    18\t        )\n    19\t        for claim in claims:\n    20\t            entry = build_entry(claim, self.settings)\n    21\t            try:\n    22\t                receipt = self.ledger.post(entry)\n    23\t            except Exception as exc:  # keep going; failures are reported\n    24\t                failed.append({\"id\": claim.claim_id, \"error\": str(exc)})\n    25\t                continue\n    26\t            claim.receipt = receipt\n    27\t            claim.status = POSTED\n    28\t            claim.history.append(POSTED)\n    29\t            posted.append({\"id\": claim.claim_id, \"receipt\": receipt})\n    30\t        if posted and self.on_posted:\n    31\t            self.on_posted(month)\n    32\t        return {\"month\": month, \"posted\": posted, \"failed\": failed}\n=== hbexpense/util/dates.py\n     1\t\"\"\"Date helpers (ISO strings only; no time zones involved).\"\"\"\n     2\timport calendar\n     3\timport datetime as _dt\n     4\t\n     5\t\n     6\tdef parse_date(value):\n     7\t    try:\n     8\t        return _dt.date.fromisoformat(str(value).strip())\n     9\t    except ValueError:\n    10\t        raise ValueError(f\"invalid date: {value!r}\") from None\n    11\t\n    12\t\n    13\tdef month_of(value):\n    14\t    d = parse_date(value)\n    15\t    return f\"{d.year:04d}-{d.month:02d}\"\n    16\t\n    17\t\n    18\tdef month_bounds(month):\n    19\t    \"\"\"Inclusive first and last day of a YYYY-MM month as ISO strings.\"\"\"\n    20\t    year, mon = (int(x) for x in month.split(\"-\"))\n    21\t    last = calendar.monthrange(year, mon)[1]\n    22\t    return f\"{year:04d}-{mon:02d}-01\", f\"{year:04d}-{mon:02d}-{last:02d}\"\n    23\t\n    24\t\n    25\tdef previous_month(month):\n    26\t    year, mon = (int(x) for x in month.split(\"-\"))\n    27\t    if mon == 1:\n    28\t        return f\"{year - 1:04d}-12\"\n    29\t    return f\"{year:04d}-{mon - 1:02d}\"\n=== hbexpense/util/cache.py\n     1\t\"\"\"Tiny TTL cache for computed reports.\"\"\"\n     2\timport time\n     3\t\n     4\t\n     5\tclass TTLCache:\n     6\t    def __init__(self, ttl, clock=None):\n     7\t        self.ttl = ttl\n     8\t        self._clock = clock or time.monotonic\n     9\t        self._data = {}\n    10\t\n    11\t    def get(self, key):\n    12\t        item = self._data.get(key)\n    13\t        if item is None:\n    14\t            return None\n    15\t        stored_at, value = item\n    16\t        if self._clock() - stored_at > self.ttl:\n    17\t            del self._data[key]\n    18\t            return None\n    19\t        return value\n    20\t\n    21\t    def put(self, key, value):\n    22\t        self._data[key] = (self._clock(), value)\n    23\t\n    24\t    def invalidate(self, prefix=\"\"):\n    25\t        for key in [k for k in self._data if str(k).startswith(prefix)]:\n    26\t            del self._data[key]\n    27\t\n    28\t    def clear(self):\n    29\t        self._data.clear()\n=== hbexpense/util/text.py\n     1\t\"\"\"Text helpers shared by the claim form and the ledger bridge.\"\"\"\n     2\timport unicodedata\n     3\t\n     4\t_SPACES = {\"\\t\", \"\\n\", \"\\r\", \"\\x0b\", \"\\x0c\", \" \", \"　\"}\n     5\t\n     6\t\n     7\tdef normalize(text):\n     8\t    \"\"\"NFC-normalize, turn odd whitespace into plain spaces, collapse runs.\"\"\"\n     9\t    if text is None:\n    10\t        return \"\"\n    11\t    text = unicodedata.normalize(\"NFC\", str(text))\n    12\t    out = []\n    13\t    for ch in text:\n    14\t        if ch in _SPACES:\n    15\t            ch = \" \"\n    16\t        elif unicodedata.category(ch) == \"Cc\":\n    17\t            continue\n    18\t        if ch == \" \" and out and out[-1] == \" \":\n    19\t            continue\n    20\t        out.append(ch)\n    21\t    return \"\".join(out).strip()\n    22\t\n    23\t\n    24\tdef clip_chars(text, limit):\n    25\t    \"\"\"Cut text to at most `limit` characters (never splits a character).\"\"\"\n    26\t    if limit <= 0:\n    27\t        return \"\"\n    28\t    if len(text) <= limit:\n    29\t        return text\n    30\t    return text[:limit].rstrip()\n    31\t\n    32\t\n    33\tdef display_width(text):\n    34\t    \"\"\"Terminal/report column width: East Asian wide characters count as 2.\"\"\"\n    35\t    width = 0\n    36\t    for ch in text:\n    37\t        width += 2 if unicodedata.east_asian_width(ch) in (\"W\", \"F\") else 1\n    38\t    return width\n    39\t\n    40\t\n    41\tdef pad_display(text, width):\n    42\t    \"\"\"Pad (or cut) text so that it occupies exactly `width` report columns.\"\"\"\n    43\t    out, used = [], 0\n    44\t    for ch in text:\n    45\t        w = display_width(ch)\n    46\t        if used + w > width:\n    47\t            break\n    48\t        out.append(ch)\n    49\t        used += w\n    50\t    return \"\".join(out) + \" \" * (width - used)\n=== hbexpense/util/money.py\n     1\t\"\"\"Won amounts are integers; these helpers only format and sum them.\"\"\"\n     2\t\n     3\t\n     4\tdef format_krw(amount):\n     5\t    sign = \"-\" if amount < 0 else \"\"\n     6\t    return f\"{sign}{abs(int(amount)):,}\"\n     7\t\n     8\t\n     9\tdef total(amounts):\n    10\t    result = 0\n    11\t    for value in amounts:\n    12\t        result += int(value)\n    13\t    return result","is_error":false}]},"parent_tool_use_id":null,"session_id":"b104e56d-18cf-458d-bc54-7ac761d3eae1","uuid":"5e53d25c-4b5b-4b44-b0d7-098a47483ea9","timestamp":"2026-10-08T18:16:52.798Z","tool_use_result":{"stdout":"=== hbexpense/ledger/client.py\n     1\t\"\"\"Thin wrapper around the vendor ledger CLI (vendor/bin/ledgerctl).\"\"\"\n     2\timport os\n     3\timport subprocess\n     4\t\n     5\tfrom hbexpense.models import LedgerError, LedgerRow\n     6\t\n     7\t\n     8\tclass LedgerClient:\n     9\t    def __init__(self, settings):\n    10\t        self.binary = settings.ledger_bin\n    11\t        self.home = settings.ledger_home or os.environ.get(\"LEDGERCTL_HOME\", \"\")\n    12\t        self.timeout = settings.ledger_timeout\n    13\t\n    14\t    def _run(self, *args):\n    15\t        env = dict(os.environ)\n    16\t        if self.home:\n    17\t            env[\"LEDGERCTL_HOME\"] = self.home\n    18\t        proc = subprocess.run(\n    19\t            [self.binary, *args],\n    20\t            capture_output=True,\n    21\t            text=True,\n    22\t            encoding=\"utf-8\",\n    23\t            env=env,\n    24\t            timeout=self.timeout,\n    25\t        )\n    26\t        if proc.returncode != 0:\n    27\t            code = (proc.stderr.strip().splitlines() or [\"