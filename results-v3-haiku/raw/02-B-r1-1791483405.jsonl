eanup()\n    17\t\n    18\t    def test_post_then_list_roundtrip(self):\n    19\t        r1 = self.client.post(LedgerEntry(\"5110\", 1000, \"2026-09-01\", \"T-1\", \"taxi\"))\n    20\t        r2 = self.client.post(LedgerEntry(\"5120\", 2500, \"2026-09-30\", \"T-2\", \"lunch\"))\n    21\t        self.client.post(LedgerEntry(\"5120\", 700, \"2026-10-01\", \"T-3\", \"coffee\"))\n    22\t        rows = self.client.list_rows(\"2026-09-01\", \"2026-09-30\")\n    23\t        self.assertEqual([r.receipt for r in rows], [r1, r2])\n    24\t        self.assertEqual(rows[1].amount, 2500)\n    25\t        self.assertEqual(rows[0].memo, \"taxi\")\n    26\t\n    27\t    def test_show_returns_entry_fields(self):\n    28\t        rc = self.client.post(LedgerEntry(\"5130\", 4200, \"2026-09-02\", \"T-9\", \"펜 한 다스\"))\n    29\t        info = self.client.show(rc)\n    30\t        self.assertEqual(info[\"receipt\"], rc)\n    31\t        self.assertEqual(info[\"ref\"], \"T-9\")\n    32\t        self.assertEqual(info[\"memo\"], \"펜 한 다스\")\n    33\t\n    34\t    def test_invalid_date_is_rejected_with_vendor_code(self):\n    35\t        with self.assertRaises(LedgerError) as ctx:\n    36\t            self.client.post(LedgerEntry(\"5110\", 1000, \"2026/09/01\", \"T-1\", \"taxi\"))\n    37\t        self.assertEqual(ctx.exception.code, \"E13\")\n    38\t\n    39\t\n    40\tif __name__ == \"__main__\":\n    41\t    unittest.main()\n=== tests/test_monthly_report.py\n     1\t\"\"\"End-to-end: submit -> approve -> month-end settlement -> monthly report.\"\"\"\n     2\timport unittest\n     3\t\n     4\tfrom tests.support import LedgerHome, app_with_claims, load_claims\n     5\t\n     6\t\n     7\tclass MonthEndCloseTest(unittest.TestCase):\n     8\t    def setUp(self):\n     9\t        self.home = LedgerHome()\n    10\t        self.claims = load_claims()\n    11\t        self.app, self.ids = app_with_claims(self.home, self.claims)\n    12\t        # noise: a rejected claim and a claim from the next month\n    13\t        extra = dict(self.claims[0], description=\"반려 대상 택시비\", amount=12000)\n    14\t        rejected = self.app.post(\"/claims\", extra).body[\"id\"]\n    15\t        self.app.post(f\"/claims/{rejected}/reject\")\n    16\t        october = dict(self.claims[6], spent_on=\"2026-10-01\")\n    17\t        oid = self.app.post(\"/claims\", october).body[\"id\"]\n    18\t        self.app.post(f\"/claims/{oid}/approve\")\n    19\t        self.run = self.app.post(\"/settlement/run\", query={\"month\": \"2026-09\"})\n    20\t\n    21\t    def tearDown(self):\n    22\t        self.home.cleanup()\n    23\t\n    24\t    def report(self):\n    25\t        resp = self.app.get(\"/reports/monthly\", {\"month\": \"2026-09\"})\n    26\t        self.assertEqual(resp.status, 200, resp.body)\n    27\t        return resp.body\n    28\t\n    29\t    def test_settlement_gives_every_approved_claim_a_receipt(self):\n    30\t        self.assertEqual(self.run.status, 200, self.run.body)\n    31\t        self.assertEqual(self.run.body[\"failed\"], [])\n    32\t        self.assertEqual(sorted(p[\"id\"] for p in self.run.body[\"posted\"]), sorted(self.ids))\n    33\t\n    34\t    def test_claim_detail_shows_posted_status(self):\n    35\t        body = self.app.get(f\"/claims/{self.ids[3]}\").body\n    36\t        self.assertEqual(body[\"status\"], \"posted\")\n    37\t        self.assertTrue(body[\"receipt\"].startswith(\"R\"))\n    38\t\n    39\t    def test_monthly_report_lists_every_settled_claim(self):\n    40\t        refs = sorted(line[\"ref\"] for line in self.report()[\"lines\"])\n    41\t        self.assertEqual(\n    42\t            refs, sorted(self.ids),\n    43\t            \"settled September claims are missing from the month-end report\",\n    44\t        )\n    45\t\n    46\t    def test_monthly_report_totals_match_settlement(self):\n    47\t        report = self.report()\n    48\t        expected = sum(c[\"amount\"] for c in self.claims)\n    49\t        self.assertEqual(report[\"entries\"], len(self.claims), \"entry count is short\")\n    50\t        self.assertEqual(report[\"total\"], expected, \"month-end total is lower than what was settled\")\n    51\t        per_center = {}\n    52\t        for c in self.claims:\n    53\t            per_center[c[\"cost_center\"]] = per_center.get(c[\"cost_center\"], 0) + c[\"amount\"]\n    54\t        self.assertEqual(report[\"by_cost_center\"], per_center)\n    55\t\n    56\t    def test_report_memos_stay_readable(self):\n    57\t        memos = {line[\"ref\"]: line[\"memo\"] for line in self.report()[\"lines\"]}\n    58\t        expected_full = {\n    59\t            self.ids[0]: f\"{self.ids[0]} 김하늘 부산 출장 KTX 왕복\",\n    60\t            self.ids[2]: f\"{self.ids[2]} 이서연 사무용품 구매 토너\",\n    61\t            self.ids[4]: f\"{self.ids[4]} 정유나 9월 휴대폰 요금\",\n    62\t            self.ids[6]: f\"{self.ids[6]} 김하늘 야근 식대\",\n    63\t            self.ids[7]: f\"{self.ids[7]} 오지훈 SQL 분석 세미나 참가\",\n    64\t            self.ids[8]: f\"{self.ids[8]} 윤소희 모니터 암 2개 구매\",\n    65\t        }\n    66\t        for ref, memo in expected_full.items():\n    67\t            self.assertEqual(memos.get(ref), memo)\n    68\t        self.assertEqual(memos.get(self.ids[1]), f\"{self.ids[1]} Park Jiwon Team dinner with p\")\n    69\t        for ref, memo in memos.items():\n    70\t            self.assertTrue(memo.startswith(ref + \" \"), memo)\n    71\t\n    72\t    def test_text_report_renders(self):\n    73\t        text = self.app.get(\"/reports/monthly.txt\", {\"month\": \"2026-09\"}).body[\"text\"]\n    74\t        self.assertTrue(text.startswith(\"Expense report 2026-09\"))\n    75\t        self.assertIn(\"entries\", text.splitlines()[-1])\n    76\t\n    77\t    def test_october_claim_is_not_settled_in_september(self):\n    78\t        refs = {line[\"ref\"] for line in self.report()[\"lines\"]}\n    79\t        self.assertFalse(any(r.startswith(\"EX-2610\") for r in refs))\n    80\t\n    81\t\n    82\tif __name__ == \"__main__\":\n    83\t    unittest.main()\n=== tests/test_text.py\n     1\timport unittest\n     2\t\n     3\tfrom hbexpense.util.text import clip_chars, display_width, normalize, pad_display\n     4\t\n     5\t\n     6\tclass TextTest(unittest.TestCase):\n     7\t    def test_normalize_collapses_whitespace_and_controls(self):\n     8\t        self.assertEqual(normalize(\" a\\t\\tb　c\\x07 \"), \"a b c\")\n     9\t        self.assertEqual(normalize(None), \"\")\n    10\t\n    11\t    def test_normalize_composes_hangul(self):\n    12\t        decomposed = \"한\"  # 한 as jamo\n    13\t        self.assertEqual(normalize(decomposed), \"한\")\n    14\t\n    15\t    def test_clip_chars_counts_characters(self):\n    16\t        self.assertEqual(clip_chars(\"가나다라마\", 3), \"가나다\")\n    17\t        self.assertEqual(clip_chars(\"abc\", 5), \"abc\")\n    18\t        self.assertEqual(clip_chars(\"ab cd\", 3), \"ab\")\n    19\t        self.assertEqual(clip_chars(\"abc\", 0), \"\")\n    20\t\n    21\t    def test_display_width(self):\n    22\t        self.assertEqual(display_width(\"ab\"), 2)\n    23\t        self.assertEqual(display_width(\"가나\"), 4)\n    24\t\n    25\t    def test_pad_display(self):\n    26\t        self.assertEqual(pad_display(\"가나다\", 5), \"가나 \")\n    27\t        self.assertEqual(pad_display(\"ab\", 4), \"ab  \")\n    28\t\n    29\t\n    30\tif __name__ == \"__main__\":\n    31\t    unittest.main()\n=== hbexpense/config.py\n     1\t\"\"\"Runtime settings. Values can be overridden through build_app(**overrides).\"\"\"\n     2\timport os\n     3\tfrom dataclasses import dataclass, field, replace\n     4\t\n     5\t_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n     6\t\n     7\t\n     8\tdef _default_ledger_bin():\n     9\t    return os.environ.get(\"HB_LEDGER_BIN\", os.path.join(_ROOT, \"vendor\", \"bin\", \"ledgerctl\"))\n    10\t\n    11\t\n    12\t@dataclass(frozen=True)\n    13\tclass Settings:\n    14\t    # vendor ledger CLI\n    15\t    ledger_bin: str = field(default_factory=_default_ledger_bin)\n    16\t    ledger_home: str = \"\"\n    17\t    ledger_timeout: float = 10.0\n    18\t    # claim form rules (expense portal screen spec v3)\n    19\t    description_max_chars: int = 30\n    20\t    claimant_max_chars: int = 10\n    21\t    max_amount: int = 5_000_000\n    22\t    # ledger memo column as agreed with the finance team\n    23\t    ledger_memo_chars: int = 40\n    24\t    # category -> ledger account code\n    25\t    accounts: dict = field(default_factory=lambda: {\n    26\t        \"TRAVEL\": \"5110\",\n    27\t        \"MEAL\": \"5120\",\n    28\t        \"SUPPLIES\": \"5130\",\n    29\t        \"TRAINING\": \"5140\",\n    30\t        \"COMMS\": \"5150\",\n    31\t    })\n    32\t    report_cache_ttl: float = 60.0\n    33\t\n    34\t    def with_overrides(self, **overrides):\n    35\t        unknown = set(overrides) - set(self.__dataclass_fields__)\n    36\t        if unknown:\n    37\t            raise KeyError(f\"unknown settings: {sorted(unknown)}\")\n    38\t        return replace(self, **overrides)\n    39\t\n    40\t\n    41\tDEFAULTS = Settings()\n=== hbexpense/models.py\n     1\t\"\"\"Domain objects and service-level errors.\"\"\"\n     2\tfrom dataclasses import dataclass, field\n     3\t\n     4\t\n     5\tclass NotFound(Exception):\n     6\t    pass\n     7\t\n     8\t\n     9\tclass Conflict(Exception):\n    10\t    pass\n    11\t\n    12\t\n    13\tclass LedgerError(Exception):\n    14\t    \"\"\"The vendor ledger CLI rejected a call (opaque vendor code in .code).\"\"\"\n    15\t\n    16\t    def __init__(self, code, command):\n    17\t        super().__init__(f\"ledger {command} failed: {code}\")\n    18\t        self.code = code\n    19\t        self.command = command\n    20\t\n    21\t\n    22\tSUBMITTED = \"submitted\"\n    23\tAPPROVED = \"approved\"\n    24\tREJECTED = \"rejected\"\n    25\tPOSTED = \"posted\"\n    26\t\n    27\t\n    28\t@dataclass\n    29\tclass Claim:\n    30\t    claim_id: str\n    31\t    claimant: str\n    32\t    cost_center: str\n    33\t    category: str\n    34\t    amount: int\n    35\t    spent_on: str           # YYYY-MM-DD\n    36\t    description: str\n    37\t    status: str = SUBMITTED\n    38\t    receipt: str = \"\"\n    39\t    history: list = field(default_factory=list)\n    40\t\n    41\t    def to_dict(self):\n    42\t        return {\n    43\t            \"id\": self.claim_id,\n    44\t            \"claimant\": self.claimant,\n    45\t            \"cost_center\": self.cost_center,\n    46\t            \"category\": self.category,\n    47\t            \"amount\": self.amount,\n    48\t            \"spent_on\": self.spent_on,\n    49\t            \"description\": self.description,\n    50\t            \"status\": self.status,\n    51\t            \"receipt\": self.receipt,\n    52\t        }\n    53\t\n    54\t\n    55\t@dataclass(frozen=True)\n    56\tclass LedgerEntry:\n    57\t    account: str\n    58\t    amount: int\n    59\t    date: str\n    60\t    ref: str\n    61\t    memo: str\n    62\t\n    63\t\n    64\t@dataclass(frozen=True)\n    65\tclass LedgerRow:\n    66\t    receipt: str\n    67\t    date: str\n    68\t    account: str\n    69\t    amount: int\n    70\t    ref: str\n    71\t    memo: str\n\n[\n  {\"claimant\": \"김하늘\", \"cost_center\": \"CC210\", \"category\": \"TRAVEL\", \"amount\": 59800, \"spent_on\": \"2026-09-02\", \"description\": \"부산 출장 KTX 왕복\"},\n  {\"claimant\": \"Park Jiwon\", \"cost_center\": \"CC110\", \"category\": \"MEAL\", \"amount\": 186000, \"spent_on\": \"2026-09-03\", \"description\": \"Team dinner with partner QA\"},\n  {\"claimant\": \"이서연\", \"cost_center\": \"CC110\", \"category\": \"SUPPLIES\", \"amount\": 43500, \"spent_on\": \"2026-09-05\", \"description\": \"사무용품 구매 토너\"},\n  {\"claimant\": \"최민준\", \"cost_center\": \"CC320\", \"category\": \"TRAINING\", \"amount\": 420000, \"spent_on\": \"2026-09-08\", \"description\": \"클라우