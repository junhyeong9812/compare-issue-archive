{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011R29g7TEvEcTfwgGxW6ZAC","type":"tool_result","content":"=== tests/__init__.py\n=== tests/support.py\n     1\t\"\"\"Shared fixtures for the API tests: a fresh ledger journal per test.\"\"\"\n     2\timport json\n     3\timport os\n     4\timport shutil\n     5\timport tempfile\n     6\t\n     7\tfrom hbexpense.app import build_app\n     8\t\n     9\tFIXTURES = os.path.join(os.path.dirname(__file__), \"fixtures\")\n    10\t\n    11\t\n    12\tdef load_claims(name=\"claims_2026_09.json\"):\n    13\t    with open(os.path.join(FIXTURES, name), encoding=\"utf-8\") as f:\n    14\t        return json.load(f)\n    15\t\n    16\t\n    17\tclass LedgerHome:\n    18\t    def __init__(self):\n    19\t        self.path = tempfile.mkdtemp(prefix=\"ledger-\")\n    20\t\n    21\t    def cleanup(self):\n    22\t        shutil.rmtree(self.path, ignore_errors=True)\n    23\t\n    24\t\n    25\tdef app_with_claims(home, claims, approve=True):\n    26\t    app = build_app(ledger_home=home.path)\n    27\t    ids = []\n    28\t    for payload in claims:\n    29\t        resp = app.post(\"/claims\", payload)\n    30\t        assert resp.status == 201, resp.body\n    31\t        ids.append(resp.body[\"id\"])\n    32\t        if approve:\n    33\t            assert app.post(f\"/claims/{ids[-1]}/approve\").status == 200\n    34\t    return app, ids\n=== tests/test_claims.py\n     1\timport unittest\n     2\t\n     3\tfrom hbexpense.app import build_app\n     4\tfrom hbexpense.models import Conflict\n     5\t\n     6\t\n     7\tdef payload(**kw):\n     8\t    base = {\n     9\t        \"claimant\": \"김하늘\", \"cost_center\": \"cc210\", \"category\": \"travel\",\n    10\t        \"amount\": \"15000\", \"spent_on\": \"2026-09-01\", \"description\": \"  택시비\\t(야근) \",\n    11\t    }\n    12\t    base.update(kw)\n    13\t    return base\n    14\t\n    15\t\n    16\tclass ClaimValidationTest(unittest.TestCase):\n    17\t    def setUp(self):\n    18\t        self.app = build_app(ledger_home=\"/nonexistent\")\n    19\t\n    20\t    def test_submit_normalizes_fields(self):\n    21\t        resp = self.app.post(\"/claims\", payload())\n    22\t        self.assertEqual(resp.status, 201)\n    23\t        self.assertEqual(resp.body[\"description\"], \"택시비 (야근)\")\n    24\t        self.assertEqual(resp.body[\"cost_center\"], \"CC210\")\n    25\t        self.assertEqual(resp.body[\"category\"], \"TRAVEL\")\n    26\t        self.assertEqual(resp.body[\"amount\"], 15000)\n    27\t        self.assertEqual(resp.body[\"id\"], \"EX-2609001\")\n    28\t\n    29\t    def test_description_over_screen_limit_is_rejected(self):\n    30\t        resp = self.app.post(\"/claims\", payload(description=\"가\" * 31))\n    31\t        self.assertEqual(resp.status, 400)\n    32\t        self.assertEqual(self.app.post(\"/claims\", payload(description=\"가\" * 30)).status, 201)\n    33\t\n    34\t    def test_bad_cost_center_and_category(self):\n    35\t        self.assertEqual(self.app.post(\"/claims\", payload(cost_center=\"210\")).status, 400)\n    36\t        self.assertEqual(self.app.post(\"/claims\", payload(category=\"GIFT\")).status, 400)\n    37\t\n    38\t    def test_amount_bounds(self):\n    39\t        self.assertEqual(self.app.post(\"/claims\", payload(amount=0)).status, 400)\n    40\t        self.assertEqual(self.app.post(\"/claims\", payload(amount=\"many\")).status, 400)\n    41\t        self.assertEqual(self.app.post(\"/claims\", payload(amount=5_000_001)).status, 400)\n    42\t\n    43\t    def test_approve_twice_conflicts(self):\n    44\t        cid = self.app.post(\"/claims\", payload()).body[\"id\"]\n    45\t        self.assertEqual(self.app.post(f\"/claims/{cid}/approve\").status, 200)\n    46\t        self.assertEqual(self.app.post(f\"/claims/{cid}/approve\").status, 409)\n    47\t\n    48\t    def test_unknown_claim_is_404(self):\n    49\t        self.assertEqual(self.app.get(\"/claims/EX-000000