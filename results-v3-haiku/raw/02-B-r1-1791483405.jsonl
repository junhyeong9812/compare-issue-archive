(month) if c.status == APPROVED),\n    17\t            key=lambda c: (c.spent_on, c.claim_id),\n    18\t        )\n    19\t        for claim in claims:\n    20\t            entry = build_entry(claim, self.settings)\n    21\t            try:\n    22\t                receipt = self.ledger.post(entry)\n    23\t            except Exception as exc:  # keep going; failures are reported\n    24\t                failed.append({\"id\": claim.claim_id, \"error\": str(exc)})\n    25\t                continue\n    26\t            claim.receipt = receipt\n    27\t            claim.status = POSTED\n    28\t            claim.history.append(POSTED)\n    29\t            posted.append({\"id\": claim.claim_id, \"receipt\": receipt})\n    30\t        if posted and self.on_posted:\n    31\t            self.on_posted(month)\n    32\t        return {\"month\": month, \"posted\": posted, \"failed\": failed}\n=== hbexpense/util/dates.py\n     1\t\"\"\"Date helpers (ISO strings only; no time zones involved).\"\"\"\n     2\timport calendar\n     3\timport datetime as _dt\n     4\t\n     5\t\n     6\tdef parse_date(value):\n     7\t    try:\n     8\t        return _dt.date.fromisoformat(str(value).strip())\n     9\t    except ValueError:\n    10\t        raise ValueError(f\"invalid date: {value!r}\") from None\n    11\t\n    12\t\n    13\tdef month_of(value):\n    14\t    d = parse_date(value)\n    15\t    return f\"{d.year:04d}-{d.month:02d}\"\n    16\t\n    17\t\n    18\tdef month_bounds(month):\n    19\t    \"\"\"Inclusive first and last day of a YYYY-MM month as ISO strings.\"\"\"\n    20\t    year, mon = (int(x) for x in month.split(\"-\"))\n    21\t    last = calendar.monthrange(year, mon)[1]\n    22\t    return f\"{year:04d}-{mon:02d}-01\", f\"{year:04d}-{mon:02d}-{last:02d}\"\n    23\t\n    24\t\n    25\tdef previous_month(month):\n    26\t    year, mon = (int(x) for x in month.split(\"-\"))\n    27\t    if mon == 1:\n    28\t        return f\"{year - 1:04d}-12\"\n    29\t    return f\"{year:04d}-{mon - 1:02d}\"\n=== hbexpense/util/cache.py\n     1\t\"\"\"Tiny TTL cache for computed reports.\"\"\"\n     2\timport time\n     3\t\n     4\t\n     5\tclass TTLCache:\n     6\t    def __init__(self, ttl, clock=None):\n     7\t        self.ttl = ttl\n     8\t        self._clock = clock or time.monotonic\n     9\t        self._data = {}\n    10\t\n    11\t    def get(self, key):\n    12\t        item = self._data.get(key)\n    13\t        if item is None:\n    14\t            return None\n    15\t        stored_at, value = item\n    16\t        if self._clock() - stored_at > self.ttl:\n    17\t            del self._data[key]\n    18\t            return None\n    19\t        return value\n    20\t\n    21\t    def put(self, key, value):\n    22\t        self._data[key] = (self._clock(), value)\n    23\t\n    24\t    def invalidate(self, prefix=\"\"):\n    25\t        for key in [k for k in self._data if str(k).startswith(prefix)]:\n    26\t            del self._data[key]\n    27\t\n    28\t    def clear(self):\n    29\t        self._data.clear()\n=== hbexpense/util/text.py\n     1\t\"\"\"Text helpers shared by the claim form and the ledger bridge.\"\"\"\n     2\timport unicodedata\n     3\t\n     4\t_SPACES = {\"\\t\", \"\\n\", \"\\r\", \"\\x0b\", \"\\x0c\", \" \", \"　\"}\n     5\t\n     6\t\n     7\tdef normalize(text):\n     8\t    \"\"\"NFC-normalize, turn odd whitespace into plain spaces, collapse runs.\"\"\"\n     9\t    if text is None:\n    10\t        return \"\"\n    11\t    text = unicodedata.normalize(\"NFC\", str(text))\n    12\t    out = []\n    13\t    for ch in text:\n    14\t        if ch in _SPACES:\n    15\t            ch = \" \"\n    16\t        elif unicodedata.category(ch) == \"Cc\":\n    17\t            continue\n    18\t        if ch == \" \" and out and out[-1] == \" \":\n    19\t            continue\n    20\t        out.append(ch)\n    21\t    return \"\".join(out).strip()\n    22\t\n    23\t\n    24\tdef clip_chars(text, limit):\n    25\t    \"\"\"Cut text to at most `limit` characters (never splits a character).\"\"\"\n    26\t    if limit <= 0:\n    27\t        return \"\"\n    28\t    if len(text) <= limit:\n    29\t        return text\n    30\t    return text[:limit].rstrip()\n    31\t\n    32\t\n    33\tdef display_width(text):\n    34\t    \"\"\"Terminal/report column width: East Asian wide characters count as 2.\"\"\"\n    35\t    width = 0\n    36\t    for ch in text:\n    37\t        width += 2 if unicodedata.east_asian_width(ch) in (\"W\", \"F\") else 1\n    38\t    return width\n    39\t\n    40\t\n    41\tdef pad_display(text, width):\n    42\t    \"\"\"Pad (or cut) text so that it occupies exactly `width` report columns.\"\"\"\n    43\t    out, used = [], 0\n    44\t    for ch in text:\n    45\t        w = display_width(ch)\n    46\t        if used + w > width:\n    47\t            break\n    48\t        out.append(ch)\n    49\t        used += w\n    50\t    return \"\".join(out) + \" \" * (width - used)\n=== hbexpense/util/money.py\n     1\t\"\"\"Won amounts are integers; these helpers only format and sum them.\"\"\"\n     2\t\n     3\t\n     4\tdef format_krw(amount):\n     5\t    sign = \"-\" if amount < 0 else \"\"\n     6\t    return f\"{sign}{abs(int(amount)):,}\"\n     7\t\n     8\t\n     9\tdef total(amounts):\n    10\t    result = 0\n    11\t    for value in amounts:\n    12\t        result += int(value)\n    13\t    return result","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XkshvS41cahQzETdr3Y8g1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
