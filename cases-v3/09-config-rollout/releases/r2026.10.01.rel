# r2026.10.01 — baseline after the September DB migration
@release r2026.10.01
global.db_url          = jdbc:postgresql://pay-db.hbp.internal:5432/pay?ssl=true&app=hbpay
global.db_pool_size    = 16
global.timeout_ms      = 5000
global.worker_threads  = 4
global.log_level       = info
global.feature_fastpay = off
pool.api.db_pool_size  = 20
pool.api.timeout_ms    = 3000
pool.batch.worker_threads = 8
pool.batch.timeout_ms  = 60000
host.web-01.log_level  = warn
