$rows\" \"$MAX_ROWS_PER_FILE\" \"$dir/rows/$p.part\") || die \"split failed for $p\"\n  for i in $(seq 1 \"$parts\"); do\n    chunk=$(printf '%s/rows/%s.part.%02d' \"$dir\" \"$p\" \"$i\")\n    name=$(settle_name \"$p\" \"$date\" \"$i\" \"$parts\")\n    csv_render \"$date\" \"$p\" \"$i\" \"$parts\" < \"$chunk\" > \"$dir/files/$name\" \\\n      || die \"render failed for $name\"\n    printf '%s|%s|%s\\n' \"$p\" \"$name\" \"$(wc -l < \"$chunk\" | tr -d ' ')\" >> \"$dir/files.lst\"\n  done\ndone\nlog \"built $(wc -l < \"$dir/files.lst\" | tr -d ' ') files\"\n# code|name|cycle|status   (status I = suspended, no files are produced)\nP001|한빛마트|daily|A\nP002|온누리약국체인|daily|A\nP003|바다횟집 연합|daily|A\nP004|구)스마일편의점|daily|I\n# payout.conf — defaults for the merchant payout file batch.\n# Every value can be overridden from the environment (PAYOUT_*); the scheduler\n# and the tests use that to point the batch at other directories.\n\nTXN_FILE=${PAYOUT_TXN_FILE:-$PAYOUT_HOME/fixtures/txns-202610.tsv}\nPARTNERS_FILE=${PAYOUT_PARTNERS_FILE:-$PAYOUT_HOME/conf/partners.conf}\nWORK_DIR=${PAYOUT_WORK_DIR:-/var/tmp/payout}\nOUT_DIR=${PAYOUT_OUT_DIR:-/var/lib/payout}\n\n# Transfer CLI (vendor). Its spool directory comes from XFERQ_HOME.\nXFERQ=${PAYOUT_XFERQ:-$PAYOUT_HOME/vendor/bin/xferq}\nSEND_RETRIES=${PAYOUT_SEND_RETRIES:-2}\n\n# Settlement file layout agreed with the partners (PAY-IF-03 rev.2)\nFILE_PREFIX=HBP_SETTLE\nFILE_EXT=csv\nSENDER_ID=HBP\n# Partners load at most this many detail rows per file.\nMAX_ROWS_PER_FILE=20\n# Partner intake runs on Windows hosts.\nLINE_END=crlf\n2026-10-04     7        1,501,892\n2026-10-05     -                -\n2026-10-06    14        3,937,833\n2026-10-07    18        4,705,841\nok   - partner can download 2026-10-01 settlement (12 rows)\nok   - partner total for 2026-10-01\nFAIL - partner can download 2026-10-02 settlement (26 rows)\n       missing [2026-10-02    26]\nFAIL - partner total for 2026-10-02\n       missing [5,363,775]\nok   - partner 