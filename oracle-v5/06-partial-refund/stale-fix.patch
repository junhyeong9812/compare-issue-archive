+    /**
+     * Inside one batch the PG refunds lines with the same TID and amount only once (the third column is
+     * not looked at), so two identical items of one order must go out in different batches. Lines that
+     * would repeat a (TID, amount) already in a batch move on to the next one.
+     */
+    private static List<List<RefundLine>> splitSameTidAmount(List<RefundLine> lines) {
+        List<List<RefundLine>> rounds = new ArrayList<>();
+        List<Set<String>> keys = new ArrayList<>();
+        for (RefundLine l : lines) {
+            String key = l.tid() + "#" + l.amount();
+            int r = 0;
+            while (r < rounds.size() && keys.get(r).contains(key)) r++;
+            if (r == rounds.size()) {
+                rounds.add(new ArrayList<>());
+                keys.add(new HashSet<>());
+            }
+            rounds.get(r).add(l);
+            keys.get(r).add(key);
+        }
+        return rounds;
+    }
