{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wrLRUQPhGJeLdGTgnmG2e","type":"tool_result","content":"# hbexpense\n\nExpense settlement service for Hanbit Pay staff. Employees submit expense\nclaims, team leads approve them, and the month-end settlement books every\napproved claim into the company ledger through the ledger vendor's CLI\n(`vendor/bin/ledgerctl`, delivered as a binary by the vendor). The month-end\nreport is read back from the ledger so it matches what finance sees.\n\n```\nhbexpense/\n  app.py            wiring (build_app) and the tiny router\n  api/              request/response helpers and endpoint handlers\n  services/         claims workflow, settlement run, monthly report\n  ledger/           ledger entry mapping and the CLI wrapper\n  store/            in-memory claim repository\n  util/             text, dates, money, cache\nvendor/bin/         vendor ledger CLI (ledgerctl --help)\ntests/              unit tests and end-to-end API tests\n```\n\nThe CLI keeps its journal under `$LEDGERCTL_HOME` (tests use a temp dir).\nRun all tests with `bash test.sh`.\n#!/usr/bin/env bash\nexport PYTHONDONTWRITEBYTECODE=1\npython3 -m unittest discover -s tests -t . -v\ndocs:\nops\n\ndocs/ops:\nledger-vendor.md\n\nhbexpense:\n__init__.py\napi\napp.py\nconfig.py\nledger\nmodels.py\nservices\nstore\nutil\n\nhbexpense/api:\nhandlers.py\nhttp.py\n\nhbexpense/ledger:\nclient.py\nentries.py\n\nhbexpense/services:\nclaims.py\nreports.py\nsettlement.py\n\nhbexpense/store:\nrepository.py\n\nhbexpense/util:\ncache.py\ndates.py\nmoney.py\ntext.py\n\ntests:\n__init__.py\nfixtures\nsupport.py\ntest_claims.py\ntest_dates.py\ntest_ledger_client.py\ntest_ledger_status.py\ntest_monthly_report.py\ntest_text.py\n\ntests/fixtures:\nclaims_2026_09.json\n\nvendor:\nbin\n\nvendor/bin:\nledgerctl\n\"\"\"Hanbit Pay expense settlement service.\"\"\"\n\"\"\"Application wiring and a minimal router (no web framework on purpose).\"\"\"\nimport re\n\nfrom hbexpense.api import handlers\nfrom hbexpense.api.http import Request, Response\nfrom hbexpense.config import DEFAULTS\nfrom hbexpense.ledger.client import LedgerClient\nfrom hbexpense.models import Conflict, LedgerError, NotFound\nfrom hbexpense.services.claims import ClaimService\nfrom hbexpense.services.reports import ReportService\nfrom hbexpense.services.settlement import SettlementService\nfrom hbexpense.store.repository import ClaimRepository\nfrom hbexpense.util.cache import TTLCache\n\nROUTES = [\n    (\"POST\", r\"^/claims$\", handlers.submit_claim),\n    (\"GET\", r\"^/claims$\", handlers.list_claims),\n    (\"GET\", r\"^/claims/(?P<claim_id>[^/]+)$\", handlers.get_claim),\n    (\"POST\", r\"^/claims/(?P<claim_id>[^/]+)/approve$\", handlers.approve_claim),\n    (\"POST\", r\"^/claims/(?P<claim_id>[^/]+)/reject$\", handlers.reject_claim),\n    (\"POST\", r\"^/settlement/run$\", handlers.run_settlement),\n    (\"GET\", r\"^/reports/monthly$\", handlers.monthly_report),\n    (\"GET\", r\"^/reports/monthly\\.txt$\", handlers.monthly_report_text),\n]\n\n\nclass App:\n    def __init__(self, settings, repo, services):\n        self.settings = settings\n        self.repo = repo\n        self.services = services\n        self._routes = [(m, re.compile(p), h) for m, p, h in ROUTES]\n\n    def handle(self, request):\n        for method, pattern, handler in self._routes:\n            match = pattern.match(request.path)\n            if match and method == request.method:\n                try:\n                    return handler(self, request, **match.groupdict())\n                except NotFound as exc:\n                    return Response.error(404, str(exc))\n                except Conflict as exc:\n                    return Response.error(409, str(exc))\n                except LedgerError as exc:\n                    return Response.error(502, str(exc))\n                except ValueError as exc:\n                    return Response.error(400, str(exc))\n        return Response.error(404, f\"no route for {request.method} {request.path}\")\n\n    def get(self, path, query=None):\n        return self.handle(Request(\"GET\", path, dict(query or {}), None))\n\n    def post(self, path, body=None, query=None):\n        return self.handle(Request(\"POST\", path, dict(query or {}), body))\n\n\ndef build_app(clock=None, **overrides):\n    settings = DEFAULTS.with_overrides(**overrides)\n    repo = ClaimRepository()\n    ledger = LedgerClient(settings)\n    reports = ReportService(repo, ledger, TTLCache(settings.report_cache_ttl, clock=clock))\n    services = {\n        \"claims\": ClaimService(repo, settings),\n        \"reports\": reports,\n        \"settlement\": SettlementService(repo, ledger, settings, on_posted=reports.invalidate),\n    }\n    return App(settings, repo, services)\n\"\"\"Runtime settings. Values can be overridden through build_app(**overrides).\"\"\"\nimport os\nfrom dataclasses import dataclass, field, replace\n\n_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef _default_ledger_bin():\n    return os.environ.get(\"HB_LEDGER_BIN\", os.path.join(_ROOT, \"vendor\", \"bin\", \"ledgerctl\"))\n\n\n@dataclass(frozen=True)\nclass Settings:\n    # vendor ledger CLI\n    ledger_bin: str = field(default_factory=_default_ledger_bin)\n    ledger_home: str = \"\"\n    ledger_timeout: float = 10.0\n    # claim form rules (expense portal screen spec v3)\n    description_max_chars: int = 30\n    claimant_max_chars: int = 10\n    max_amount: int = 5_000_000\n    # ledger memo column as agreed with the finance team\n    ledger_memo_chars: int = 40\n    # the ledger only books memos up to 48 UTF-8 bytes; longer ones are parked\n    ledger_memo_bytes: int = 48\n    # per-entry lookups (`show`) stay with the finance reconciliation desk\n    # since EXP-412; the desk's own tooling turns this on\n    ledger_show_allowed: bool = False\n    # category -> ledger account code\n    accounts: dict = field(default_factory=lambda: {\n        \"TRAVEL\": \"5110\",\n        \"MEAL\": \"5120\",\n        \"SUPPLIES\": \"5130\",\n        \"TRAINING\": \"5140\",\n        \"COMMS\": \"5150\",\n    })\n    report_cache_ttl: float = 60.0\n\n    def with_overrides(self, **overrides):\n        unknown = set(overrides) - set(self.__dataclass_fields__)\n        if unknown:\n            raise KeyError(f\"unknown settings: {sorted(unknown)}\")\n        return replace(self, **overrides)\n\n\nDEFAULTS = Settings()\n\"\"\"Domain objects and service-level errors.\"\"\"\nfrom dataclasses import dataclass, field\n\n\nclass NotFound(Exception):\n    pass\n\n\nclass Conflict(Exception):\n    pass\n\n\nclass LedgerError(Exception):\n    \"\"\"The vendor ledger CLI rejected a call (opaque vendor code in .code).\"\"\"\n\n    def __init__(self, code, command):\n        super().__init__(f\"ledger {command} failed: {code}\")\n        self.code = code\n        self.command = command\n\n\nSUBMITTED = \"submitted\"\nAPPROVED = \"approved\"\nREJECTED = \"rejected\"\nPOSTED = \"posted\"\n\n\n@dataclass\nclass Claim:\n    claim_id: str\n    claimant: str\n    cost_center: str\n    category: str\n    amount: int\n    spent_on: str           # YYYY-MM-DD\n    description: str\n    status: str = SUBMITTED\n    receipt: str = \"\"\n    history: list = field(default_factory=list)\n\n    def to_dict(self):\n        return {\n            \"id\": self.claim_id,\n            \"claimant\": self.claimant,\n            \"cost_center\": self.cost_center,\n            \"category\": self.category,\n            \"amount\": self.amount,\n            \"spent_on\": self.spent_on,\n            \"description\": self.description,\n            \"status\": self.status,\n            \"receipt\": self.receipt,\n        }\n\n\n@dataclass(frozen=True)\nclass LedgerEntry:\n    account: str\n    amount: int\n    date: str\n    ref: str\n    memo: str\n\n\n@dataclass(frozen=True)\nclass LedgerRow:\n    receipt: str\n    date: str\n    account: str\n 