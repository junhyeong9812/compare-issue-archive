{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KPU8Wjfmk62oqS6fV7btiG","type":"tool_result","content":"\"\"\"Thin wrapper around the vendor ledger CLI (vendor/bin/ledgerctl).\"\"\"\nimport os\nimport subprocess\n\nfrom hbexpense.models import LedgerError, LedgerRow\n\n\nclass LedgerClient:\n    def __init__(self, settings):\n        self.binary = settings.ledger_bin\n        self.home = settings.ledger_home or os.environ.get(\"LEDGERCTL_HOME\", \"\")\n        self.timeout = settings.ledger_timeout\n        self.show_allowed = settings.ledger_show_allowed\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"LEDGERCTL_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise LedgerError(code, args[0])\n        return proc.stdout\n\n    def post(self, entry):\n        out = self._run(\n            \"post\",\n            \"--acct\", entry.account,\n            \"--amt\", str(entry.amount),\n            \"--date\", entry.date,\n            \"--ref\", entry.ref,\n            \"--memo\", entry.memo,\n        )\n        receipt = out.strip()\n        if not receipt.startswith(\"R\"):\n            raise LedgerError(\"E??\", \"post\")\n        return receipt\n\n    def list_rows(self, date_from, date_to):\n        out = self._run(\"list\", \"--from\", date_from, \"--to\", date_to)\n        rows = []\n        for line in out.splitlines():\n            if not line or line.startswith(\"#\"):\n                continue\n            parts = line.split(\"\\t\", 5)\n            if len(parts) != 6:\n                continue\n            receipt, date, account, amount, ref, memo = parts\n            rows.append(LedgerRow(receipt, date, account, int(amount), ref, memo))\n        return rows\n\n    def show(self, receipt):\n        # TODO: read-only lookup — do we still need to keep this switched off? (EXP-412)\n        if not self.show_allowed:\n            raise RuntimeError(\"ledger show is not enabled in this deployment\")\n        out = self._run(\"show\", receipt)\n        info = {}\n        for line in out.splitlines():\n            key, _, value = line.partition(\" \")\n            info[key] = value\n        return info\n\"\"\"Claim submission and approval workflow.\"\"\"\nimport re\n\nfrom hbexpense.models import APPROVED, REJECTED, SUBMITTED, Claim, Conflict\nfrom hbexpense.util.dates import month_of, parse_date\nfrom hbexpense.util.text import normalize\n\n_COST_CENTER = re.compile(r\"^CC\\d{3}$\")\n\n\nclass ClaimService:\n    def __init__(self, repo, settings):\n        self.repo = repo\n        self.settings = settings\n\n    def validate(self, payload):\n        claimant = normalize(payload.get(\"claimant\"))\n        description = normalize(payload.get(\"description\"))\n        cost_center = str(payload.get(\"cost_center\", \"\")).strip().upper()\n        category = str(payload.get(\"category\", \"\")).strip().upper()\n        if not claimant or len(claimant) > self.settings.claimant_max_chars:\n            raise ValueError(\"claimant is required (max %d characters)\" % self.settings.claimant_max_chars)\n        if not description:\n            raise ValueError(\"description is required\")\n        if len(description) > self.settings.description_max_chars:\n            raise ValueError(\"description is limited to %d characters\" % self.settings.description_max_chars)\n        if not _COST_CENTER.match(cost_center):\n            raise ValueError(\"cost_center must look like CC123\")\n        if category not in self.settings.accounts:\n            raise ValueError(f\"unknown category {category}\")\n        try:\n            amount = int(payload.get(\"amount\"))\n        except (TypeError, ValueError):\n            raise ValueError(\"amount must be an integer\") from None\n        if not 0 < amount <= self.settings.max_amount:\n            raise ValueError(\"amount out of range\")\n        spent_on = parse_date(payload.get(\"spent_on\")).isoformat()\n        return {\n            \"claimant\": claimant,\n            \"description\": description,\n            \"cost_center\": cost_center,\n            \"category\": category,\n            \"amount\": amount,\n            \"spent_on\": spent_on,\n        }\n\n    def submit(self, payload):\n        fields = self.validate(payload)\n        claim_id = self.repo.next_id(month_of(fields[\"spent_on\"]))\n        claim = Claim(claim_id=claim_id, **fields)\n        claim.history.append(SUBMITTED)\n        return self.repo.add(claim)\n\n    def approve(self, claim_id):\n        claim = self.repo.get(claim_id)\n        if claim.status != SUBMITTED:\n            raise Conflict(f\"claim {claim_id} is {claim.status}\")\n        claim.status = APPROVED\n        claim.history.append(APPROVED)\n        return claim\n\n    def reject(self, claim_id):\n        claim = self.repo.get(claim_id)\n        if claim.status != SUBMITTED:\n            raise Conflict(f\"claim {claim_id} is {claim.status}\")\n        claim.status = REJECTED\n        claim.history.append(REJECTED)\n        return claim\n\"\"\"Month-end expense report, read back from the ledger.\"\"\"\nfrom hbexpense.util.dates import month_bounds\nfrom hbexpense.util.money import format_krw, total\n\n\nclass ReportService:\n    def __init__(self, repo, ledger, cache):\n        self.repo = repo\n        self.ledger = ledger\n        self.cache = cache\n\n    def invalidate(self, month):\n        self.cache.invalidate(f\"monthly:{month}\")\n\n    def _rows(self, month):\n        date_from, date_to = month_bounds(month)\n        rows = self.ledger.list_rows(date_from, date_to)\n        # a claim re-posted after a correction keeps the newest receipt only\n        latest = {}\n        for row in rows:\n            seen = latest.get(row.ref)\n            if seen is None or row.receipt > seen.receipt:\n                latest[row.ref] = row\n        return sorted(latest.values(), key=lambda r: (r.date, r.receipt))\n\n    def monthly(self, month):\n        key = f\"monthly:{month}\"\n        cached = self.cache.get(key)\n        if cached is not None:\n            return cached\n        rows = self._rows(month)\n        by_account, by_cost_center, lines = {}, {}, []\n        for row in rows:\n            by_account[row.account] = by_account.get(row.account, 0) + row.amount\n            claim = self.repo.by_ref(row.ref)\n            center = claim.cost_center if claim else \"UNKNOWN\"\n            by_cost_center[center] = by_cost_center.get(center, 0) + row.amount\n            lines.append({\n                \"receipt\": row.receipt,\n                \"date\": row.date,\n                \"ref\": row.ref,\n                \"account\": row.account,\n                \"amount\": row.amount,\n                \"memo\": row.memo,\n            })\n        grand = total(r.amount for r in rows)\n        report = {\n            \"month\": month,\n            \"entries\": len(rows),\n            \"total\": grand,\n            \"total_display\": format_krw(grand),\n            \"by_account\": dict(sorted(by_account.items())),\n            \"by_cost_center\": dict(sorted(by_cost_center.items())),\n            \"lines\": lines,\n        }\n        self.cache.put(key, report)\n        return report\n\"\"\"Endpoint handlers. Each takes (app, request, **path_params) and returns a Response.\"\"\"\nfrom hbexpense.api.http import Response, month_param, str_param\nfrom hbexpense.util.money import format_krw\nfrom hbexpense.util.text import pad_display\n\n\ndef submit_claim(app, request):\n    claim = app.services[\"claims\"].submit(request.body or {})\n    return Response(201, claim.to_dict())\n\n\ndef approve_claim(app, request, claim_id):\n    return Response.ok(app.services[\"claims\"].approve(claim_id).to_dict())\n\n\ndef reject_claim(app, request, claim_id):\n    return Response.ok(app.services[\"claims\"].reject(claim_id).to_dict())\n\n\ndef get_claim(app, request, claim_id):\n    return Response.ok(app.repo.get(claim_id).to_dict())\n\n\ndef list_claims(app, request):\n    status = str_param(request.query, \"status\")\n    claims = app.repo.all()\n    if status:\n        claims = [c for c in claims if c.status == status]\n    return Response.ok({\"items\": [c.to_dict() for c in claims]})\n\n\ndef run_settlement(app, request):\n    month = month_param(request.query)\n    return Response.ok(app.services[\"settlement\"].run(month))\n\n\ndef monthly_report(app, request):\n    month = month_param(request.query)\n    return Response.ok(app.services[\"reports\"].monthly(month))\n\n\ndef monthly_report_text(app, request):\n    month = month_param(request.query)\n    report = app.services[\"reports\"].monthly(month)\n    out = [f\"Expense report {month}\", \"-\" * 64]\n    for line in report[\"lines\"]:\n        out.append(\n            f\"{line['receipt']}  {line['date']}  {pad_display(line['memo'], 36)}\"\n            f\"{format_krw(line['amount']):>12}\"\n        )\n    out.append(\"-\" * 64)\n    out.append(f\"{report['entries']} entries{report['total_display']:>{64 - 10}}\")\n    return Response.ok({\"text\": \"\\n\".join(out)})\n\"\"\"Tiny TTL cache for computed reports.\"\"\"\nimport time\n\n\nclass TTLCache:\n    def __init__(self, ttl, clock=None):\n        self.ttl = ttl\n        self._clock = clock or time.monotonic\n        self._data = {}\n\n    def get(self, key):\n        item = self._data.get(key)\n        if item is None:\n            return None\n        stored_at, value = item\n        if self._clock() - stored_at > self.ttl:\n            del self._data[key]\n            return None\n        return value\n\n    def put(self, key, value):\n        self._data[key] 