{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Btgbj2viJUBYtcQ7kPF88X","type":"tool_result","content":"package infra;\n\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.TimeUnit;\n\n/** Thin wrapper around the points vendor CLI (vendor/bin/ptsctl). One process per call. */\npublic class PtsctlClient {\n    /** One line of the vendor history: entry number, our reference, points. */\n    public record HistoryRow(String entryNo, String ref, long points) {}\n\n    private final Path bin;\n    private final Path home;\n    private final long timeoutSeconds;\n\n    public PtsctlClient(Path bin, Path home, long timeoutSeconds) {\n        this.bin = bin;\n        this.home = home;\n        this.timeoutSeconds = timeoutSeconds;\n    }\n\n    /** Credits points to a member; returns the vendor entry number. */\n    public String earn(String memberNo, long points, String ref) {\n        return run(List.of(\"earn\", \"--mbr\", mbr(memberNo), \"--pt\", Long.toString(points), \"--ref\", ref)).strip();\n    }\n\n    public long balance(String memberNo) {\n        String out = run(List.of(\"bal\", mbr(memberNo))).strip();\n        String[] t = out.split(\"\\\\s+\");\n        if (t.length != 2) throw new PtsException(\"unexpected bal reply: \" + out);\n        return Long.parseLong(t[1]);\n    }\n\n    public List<HistoryRow> history(String memberNo) {\n        List<HistoryRow> rows = new ArrayList<>();\n        for (String line : run(List.of(\"hist\", mbr(memberNo))).split(\"\\n\")) {\n            if (line.isBlank()) continue;\n            String[] f = line.split(\"\\t\");\n            if (f.length != 3) throw new PtsException(\"unexpected hist line: \" + line);\n            rows.add(new HistoryRow(f[0], f[1], Long.parseLong(f[2])));\n        }\n        return rows;\n    }\n\n    /**\n     * Member number as the vendor must read it. A bare all-digit number is read as a number by\n     * `earn` (leading zeros dropped: 004512 is credited to 4512); the @ form keeps it as issued.\n     */\n    static String mbr(String memberNo) {\n        return \"@\" + memberNo;\n    }\n\n    private String run(List<String> args) {\n        List<String> cmd = new ArrayList<>();\n        cmd.add(bin.toString());\n        cmd.addAll(args);\n        try {\n            Files.createDirectories(home);\n            ProcessBuilder pb = new ProcessBuilder(cmd);\n            pb.environment().put(\"PTSCTL_HOME\", home.toAbsolutePath().toString());\n            Process p = pb.start();\n            byte[] out;\n            byte[] err;\n            try (InputStream o = p.getInputStream(); InputStream e = p.getErrorStream()) {\n                out = o.readAllBytes();\n                err = e.readAllBytes();\n            }\n            if (!p.waitFor(timeoutSeconds, TimeUnit.SECONDS)) {\n                p.destroyForcibly();\n                throw new PtsException(\"timeout: \" + String.join(\" \", cmd));\n            }\n            if (p.exitValue() != 0) {\n                throw new PtsException(\"ptsctl failed [\" + new String(err, StandardCharsets.UTF_8).strip() + \"]: \"\n                        + String.join(\" \", cmd));\n            }\n            return new String(out, StandardCharsets.UTF_8);\n        } catch (IOException e) {\n            throw new PtsException(\"exec failed: \" + e.getMessage());\n        } catch (InterruptedException e) {\n            Thread.currentThread().interrupt();\n            throw new PtsException(\"interrupted\");\n        }\n    }\n\n    public static class PtsException extends RuntimeException {\n        public PtsException(String msg) {\n            super(msg);\n        }\n    }\n}\npackage service;\n\nimport domain.Member;\nimport domain.MemberStatement;\nimport infra.PtsctlClient;\nimport store.EarnLedger;\n\nimport java.time.YearMonth;\n\n/** Member-facing points summary. The balance is the vendor's, not ours. */\npublic class StatementService {\n    private final MemberDirectory members;\n    private final EarnLedger ledger;\n    private final PtsctlClient pts;\n\n    public StatementService(MemberDirectory members, EarnLedger ledger, PtsctlClient pts) {\n        this.members = members;\n        this.ledger = ledger;\n        this.pts = pts;\n    }\n\n    public MemberStatement statement(String memberNo, YearMonth month) {\n        Member m = members.find(memberNo).orElseThrow(() -> new IllegalArgumentException(\"unknown member \" + memberNo));\n        long balance = pts.balance(m.memberNo());\n        int entries = pts.history(m.memberNo()).size();\n        return new MemberStatement(m.memberNo(), m.name(), m.grade(), balance, entries,\n                ledger.earnedIn(m.memberNo(), month));\n    }\n}\npackage service;\n\nimport domain.EarnEntry;\nimport domain.Member;\nimport store.EarnLedger;\n\nimport java.time.YearMonth;\nimport java.util.ArrayList;\nimport java.util.Comparator;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * Marketing's monthly \"top earners\" list, from what the earn run sent to the vendor this\n * month (our own earn ledger), not from the vendor balance.\n */\n// TODO: the member app already shows the vendor balance -- do we still need our own count here?\npublic class TopEarnersReport {\n    public record Row(String memberNo, String name, long points) {}\n\n    private final MemberDirectory members;\n    private final EarnLedger ledger;\n\n    public TopEarnersReport(MemberDirectory members, EarnLedger ledger) {\n        this.members = members;\n        this.ledger = ledger;\n    }\n\n    public List<Row> top(YearMonth month, int n) {\n        Map<String, Long> sums = new LinkedHashMap<>();\n        for (EarnEntry e : ledger.all()) {\n            if (YearMonth.from(e.day()).equals(month)) sums.merge(e.memberNo(), e.points(), Long::sum);\n        }\n        List<Row> rows = new ArrayList<>();\n        for (Map.Entry<String, Long> s : sums.entrySet()) {\n            String name = members.find(s.getKey()).map(Member::name).orElse(\"?\");\n            rows.add(new Row(s.getKey(), name, s.getValue()));\n        }\n        rows.sort(Comparator.comparingLong(Row::points).reversed().thenComparing(Row::memberNo));\n        return rows.size() > n ? rows.subList(0, n) : rows;\n    }\n}\npackage service;\n\nimport domain.EarnEntry;\nimport domain.Member;\nimport domain.Payment;\nimport domain.RunResult;\nimport infra.PtsctlClient;\nimport store.EarnLedger;\n\nimport java.time.LocalDate;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Optional;\n\n/**\n * Daily earn run: every approved payment of a known member earns grade-rate\n * points at the points vendor once. The vendor reference is prefix + payment id,\n * so a re-run never earns twice.\n */\npublic class EarnBatchJob {\n    private final MemberDirectory members;\n    private final EarnPolicy policy;\n    private final EarnLedger ledger;\n    private final PtsctlClient pts;\n    private final String refPrefix;\n\n    public EarnBatchJob(MemberDirectory members, EarnPolicy policy, EarnLedger ledger, PtsctlClient pts,\n                        String refPrefix) {\n        this.members = members;\n        this.policy = policy;\n        this.ledger = ledger;\n        this.pts = pts;\n        this.refPrefix = refPrefix;\n    }\n\n    public RunResult run(LocalDate day, List<Payment> payments) {\n        int earned = 0;\n        int skipped = 0;\n        long total = 0;\n        List<String> unknown = new ArrayList<>();\n        for (Payment p : PaymentDeduper.unique(payments)) {\n            if (!p.approved() || ledger.contains(p.payId())) {\n                skipped++;\n                continue;\n            }\n            Optional<Member> m = members.find(p.memberNo());\n            if (m.isEmpty()) {\n                unknown.add(p.memberNo());\n                continue;\n            }\n            long pts = policy.points(p.amount(), m.get().grade());\n            if (pts == 0) {\n                skipped++;\n                continue;\n            }\n            String entryNo = this.pts.earn(m.get().memberNo(), pts, refPrefix + \"-\" + p.payId());\n            ledger.record(new EarnEntry(p.payId(), m.get().memberNo(), pts, day, entryNo));\n            earned++;\n            total += pts;\n        }\n        return new RunResult(earned, total, List.copyOf(unknown), skipped);\n    }\n}\npackage store;\n\nimport domain.EarnEntry;\n\nimport java.time.YearMonth;\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\n/** Our own record of earns already sent, keyed by payment id (a payment earns once). */\npublic class EarnLedger {\n    private final Map<String, EarnEntry> byPayment = new LinkedHashMap<>();\n\n    public synchronized boolean contains(String payId) {\n        return byPayment.containsKey(payId);\n    }\n\n    public synchronized void record(EarnEntry e) {\n        byPayment.put(e.payId(), e);\n    }\n\n    public synchronized List<EarnEntry> all() {\n        return new ArrayList<>(byPayment.values());\n    }\n\n    public synchronized long earnedIn(String memberNo, YearMonth month) {\n        return byPayment.values().stream()\n                .filter(e -> e.memberNo().equals(memberNo) && YearMonth.from(e.day()).equals(month))\n                .mapToLong(EarnEntry::points).sum();\n    }\n}\npackage service;\n\nimport domain.Member;\n\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\n\n/** Member lookup. Keys are the member number exactly as issued (text, not a number). */\npublic class MemberDirectory {\n    private final Map<String, Member> members = new LinkedHashMap<>();\n\n    public MemberDirectory(List<Member> list) {\n        for (Member m : 