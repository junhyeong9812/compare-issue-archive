\u0002m\n\u000e\bA\u000b4\u0000\u0000\u0000x\u0001\u0000\u0000T���P\u0000\u0000\u0000\u0000A\u000e\u0010�\u0002D\u000e\u0018�\u0003G\u000e I\u000e(K\u000e0\\\u000e(A\u000e K\n\u000e\u0018A\u000e\u0010A\u000e\bA\u000b\u0000\u00004\u0000\u0000\u0000�\u0001\u0000\u0000l���P\u0000\u0000\u0000\u0000A\u000e\u0010�\u0002D\u000e\u0018�\u0003G\u000e I\u000e(K\u000e0\\\u000e(A\u000e K\n\u000e\u0018A\u000e\u0010A\u000e\bA\u000b\u0000\u0000`\u0000\u0000\u0000�\u0001\u0000\u0000�����\u0003\u0000\u0000\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007G\u000e� L\u000e�!\u0003�\u0002\u000e�!O\u000e�!X\u000e�!A\u000e�!\u0002@\n\u000e8C\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bI\u000b\u0000\u0000 \u0000\u0000\u0000L\u0002\u0000\u0000\u0000���]\u0000\u0000\u0000\u0000A\u000e\u0010�\u0002N\u000e�\b\u0002G\n\u000e\u0010A\u000e\bA\u000bH\u0000\u0000\u0000p\u0002\u0000\u0000<���(\u0001\u0000\u0000\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003A\u000e �\u0004A\u000e(�\u0005G\u000e�\n\u0002�\u000e�\nT\u000e�","is_error":false}]},"parent_tool_use_id":null,"session_id":"f42def6c-706e-4662-9bb8-9d49ee7efbba","uuid":"f0a80260-b4b7-4bd3-b93e-59f560ad8cb9","timestamp":"2026-10-09T15:45:22.057Z","tool_use_result":{"stdout":"# receipts.sh — what the partner can actually download, per settlement day.\n# Reads the partner's box through the transfer CLI and totals the detail rows.\n\n# receipts_rows PARTNER — one line per header and per detail row of every file\n# in the partner's box:\n#   P<TAB>date<TAB>part<TAB>parts\n#   D<TAB>date<TAB>net\nreceipts_rows() {\n  local partner=$1 name bytes ticket\n  xfer_ls \"$partner\" | while IFS=$'\\t' read -r name bytes ticket; do\n    [ -n \"$name\" ] || continue\n    xfer_pull \"$partner\" \"$name\" | tr -d '\\r' | awk -F, '\n      $1 == \"H\" { split($5, pp, \"/\"); print \"P\\t\" $4 \"\\t\" pp[1] \"\\t\" pp[2] }\n      $1 == \"D\" { print \"D\\t\" $3 \"\\t\" $6 }'\n  done\n}\n\n# receipts_day ROWS DATE -> \"<count> <net>\" for the day.\n# A split day is totalled only once parts 1..n are all in the box; until then\n# the answer is \"0 0\", the same as a day with no file at all.\n# TODO: 일부 파트만 온 날도 온 만큼은 세어 주면 되지 않나? 지금은 '-'라 헷갈린다.\nreceipts_day() {\n  printf '%s\\n' \"$1\" | awk -F'\\t' -v d=\"$2\" '\n    $1 == \"P\" && $2 == d { seen[$3 + 0] = 1; want = $4 + 0 }\n    $1 == \"D\" && $2 == d { n++; s += $3 }\n    END {\n      have = 0\n      for (p in seen) if (p >= 1 && p <= want) have++\n      if (want == 0 || have < want) { print \"0 0\"; exit }\n      print n + 0, s + 0\n    }'\n}\n\n# receipts_report PARTNER FROM TO\nreceipts_report() {\n  local partner=$1 from=$2 to=$3 rows d cnt net\n  rows=$(receipts_rows \"$partner\")\n  printf '# partner %s  %s..%s\\n' \"$partner\" \"$(date_dash \"$from\")\" \"$(date_dash \"$to\")\"\n  for d in $(date_range \"$from\" \"$to\"); do\n    read -r cnt net <<< \"$(receipts_day \"$rows\" \"$d\")\"\n    if [ \"$cnt\" -eq 0 ]; then\n      printf '%s  %4s  %15s\\n' \"$(date_dash \"$d\")\" \"-\" \"-\"\n    else\n      printf '%s  %4d  %15s\\n' \"$(date_dash \"$d\")\" \"$cnt\" \"$(money_fmt \"$net\")\"\n    fi\n  done\n}\n# xfer.sh — thin wrapper around the transfer vendor CLI.\n\n_xferq() { \"$XFERQ\" \"$@\"; }\n\n# xfer_send PARTNER FILE NAME — uploads FILE as NAME and prints the ticket.\n# Transient spool errors are retried; a malformed answer counts as a failure.\nxfer_send() {\n  local partner=$1 file=$2 name=$3 out rc try=0\n  while :; do\n    out=$(_xferq send --to \"$partner\" --file \"$file\" --as \"$name\" 2>&1); rc=$?\n    if [ \"$rc\" -eq 0 ]; then\n      case \"$out\" in\n        T[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' \"$out\"; return 0 ;;\n        *) warn \"unexpected answer from transfer CLI: $out\"; return 1 ;;\n      esac\n    fi\n    try=$((try + 1))\n    if [ \"$try\" -gt \"$SEND_RETRIES\" ]; then\n      warn \"send $name to $partner failed ($out, exit $rc)\"\n      return 1\n    fi\n    log \"retrying $name ($out)\"\n  done\n}\n\n# xfer_ls PARTNER — name<TAB>bytes<TAB>ticket for files in the partner's box.\nxfer_ls() { _xferq ls --to \"$1\"; }\n\n# xfer_pull PARTNER NAME — file contents on stdout.\nxfer_pull() { _xferq pull --to \"$1\" --name \"$2\"; }\n#!/usr/bin/env bash\n# Runs every tests/test_*.sh and reports which files failed.\ncd \"$(dirname \"$0\")\" || exit 2\nfailed=()\nfor t in test_*.sh; do\n  echo \"== $t\"\n  bash \"$t\"\n  rc=$?\n  [ \"$rc\" -eq 0 ] || failed+=(\"$t (exit $rc)\")\ndone\necho\nif [ ${#failed[@]} -eq 0 ]; then\n  echo \"all test files passed\"\n  exit 0\nfi\nprintf 'failed: %s\\n' \"${failed[@]}\"\nexit 1\nlib.sh\nrun.sh\ntest_chunk.sh\ntest_csvfile.sh\ntest_dates.sh\ntest_partial_receipts.sh\ntest_partner_delivery.sh\nCHANGELOG.md:14:- receipts: 분할 일자는 파트 1..n이 수신함에 다 있을 때만 건수·금액을 낸다. 빠진 파트가 있으면 `-`.\nCHANGELOG.md:19:- receipts 서브커맨드 추가 — 파트너 수신함을 직접 읽어 일자별 건수·순액을 낸다.\nbin/payout:6:#   payout receipts PARTNER FROM TO  what the partner can download, per day\nbin/payout:44:  receipts) [ $# -eq 3 ] || { usage; exit 64; }\nbin/payout:45:            receipts_report \"$1\" \"$(check_date \"$2\")\" \"$(check_date \"$3\")\" ;;\ndocs/runbook-oncall.md:6:3. `bin/payout receipts <파트너> <어제> <어제>`로 활성 파트너마다 한 줄씩 확인한다.\ndocs/runbook-oncall.md:9:- \"정산 파일이 안 왔다\": receipts 줄이 `-`이면 수신함을 직접 본다(`vendor/bin/xferq ls --to <파트너>`). 2번 절차로 재전송.\ndocs/runbook-oncall.md:10:- \"지급이 안 됐다 / 지급 보류\": receipts에서 그 날의 건수·금액이 찍혀 있으면 \"파트너 측 적재 가능 상태\"로 회신하고, 건수·금액을 그대로 알려 준다.\nREADME.md:11:bin/payout receipts P001 20261001 20261007 # 파트너가 실제로 내려받을 수 있는 일자별 건수·금액\nELF\u0002\u0001\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000>\u0000\u0001\u0000\u0000\u0000P\u0015\u0000\u0000\u0000\u0000\u0000\u0000@\u0000\u0000\u0000\u0000\u0000\u0000\u0000HA\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000@\u00008\u0000\r\u0000@\u0000\u001d\u0000\u001c\u0000\u0006\u0000\u0000\u0000\u0004\u0000\u0000\u0000@\u0000\u0000\u00