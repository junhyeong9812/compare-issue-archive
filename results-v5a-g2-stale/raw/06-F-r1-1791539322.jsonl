{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Ds1hpVJPsBCjgB5gwAdtt","type":"tool_result","content":"package service;\n\nimport domain.RefundLine;\nimport domain.RunResult;\nimport infra.PgsimClient;\nimport infra.RefundFileWriter;\nimport store.RefundRepository;\n\nimport java.nio.file.Path;\nimport java.time.LocalDate;\nimport java.time.format.DateTimeFormatter;\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * Nightly refund run: every pending refund line goes to the PG in batches of\n * at most maxLines. Batch id = run id + chunk number; the PG settles and is\n * reconciled per batch id.\n */\npublic class RefundBatchJob {\n    private final RefundRepository refunds;\n    private final PgsimClient pg;\n    private final String mid;\n    private final String prefix;\n    private final int maxLines;\n    private final Path workDir;\n\n    public RefundBatchJob(RefundRepository refunds, PgsimClient pg, String mid, String prefix, int maxLines,\n                          Path workDir) {\n        this.refunds = refunds;\n        this.pg = pg;\n        this.mid = mid;\n        this.prefix = prefix;\n        this.maxLines = maxLines;\n        this.workDir = workDir;\n    }\n\n    public RunResult run(LocalDate day) {\n        String runId = String.format(\"%s%s-%02d\", prefix, day.format(DateTimeFormatter.BASIC_ISO_DATE),\n                refunds.nextRunSeq());\n        List<RefundLine> pending = uniquePending();\n        List<String> batchIds = new ArrayList<>();\n        int completed = 0;\n        for (int start = 0, chunk = 1; start < pending.size(); start += maxLines, chunk++) {\n            List<RefundLine> part = pending.subList(start, Math.min(pending.size(), start + maxLines));\n            String batchId = runId + \"-\" + chunk;\n            Path file = RefundFileWriter.write(workDir, batchId, part);\n            int accepted = pg.refund(mid, batchId, file);\n            if (accepted != part.size()) {\n                throw new IllegalStateException(\"PG accepted \" + accepted + \" of \" + part.size() + \" in \" + batchId);\n            }\n            for (RefundLine l : part) l.submitted(batchId);\n            batchIds.add(batchId);\n            completed += RefundResultMatcher.apply(part, pg.status(batchId));\n        }\n        int awaiting = (int) pending.stream().filter(l -> l.status() == RefundLine.Status.SUBMITTED).count();\n        return new RunResult(runId, List.copyOf(batchIds), pending.size(), completed, awaiting);\n    }\n\n    /** A line queued twice by a CS double-click must be refunded once. */\n    private List<RefundLine> uniquePending() {\n        Map<String, RefundLine> byKey = new LinkedHashMap<>();\n        for (RefundLine l : refunds.pending()) {\n            byKey.putIfAbsent(l.orderNo() + \"#\" + l.lineNo(), l);\n        }\n        return new ArrayList<>(byKey.values());\n    }\n}\npackage infra;\n\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.concurrent.TimeUnit;\n\n/** Thin wrapper around the PG vendor CLI (vendor/bin/pgsim). One process per call. */\npublic class PgsimClient {\n    /** What the PG reports for one payment. */\n    public record Txn(String tid, long amount, long refunded, long balance) {}\n\n    /** One row of a PG batch status: refund number, TID, amount, merchant field. */\n    public record RefundRow(String refundNo, String tid, long amount, String aux) {}\n\n    private final Path bin;\n    private final Path home;\n    private final long timeoutSeconds;\n\n    public PgsimClient(Path bin, Path home, long timeoutSeconds) {\n        this.bin = bin;\n        this.home = home;\n        this.timeoutSeconds = timeoutSeconds;\n    }\n\n    /** Charges the customer; returns the PG transaction id. */\n    public String pay(String mid, long amount, String orderNo) {\n        return run(List.of(\"pay\", \"--mid\", mid, \"--amt\", Long.toString(amount), \"--oid\", orderNo)).strip();\n    }\n\n    /** Submits one refund batch file; returns the accepted count reported by the PG. */\n    public int refund(String mid, String batchId, Path file) {\n        String out = run(List.of(\"refund\", \"--mid\", mid, \"--batch\", batchId, file.toString())).strip();\n        String[] t = out.split(\"\\\\s+\");\n        if (t.length != 2 || !t[0].equals(\"accepted\")) {\n            throw new PgException(\"unexpected refund reply: \" + out);\n        }\n        return Integer.parseInt(t[1]);\n    }\n\n    public List<RefundRow> status(String batchId) {\n        List<RefundRow> rows = new ArrayList<>();\n        for (String line : run(List.of(\"status\", \"--batch\", batchId)).split(\"\\n\")) {\n            if (line.isBlank()) continue;\n            String[] f = line.split(\"\\t\");\n            if (f.length != 4) throw new PgException(\"unexpected status line: \" + line);\n            rows.add(new RefundRow(f[0], f[1], Long.parseLong(f[2]), f[3].equals(\"-\") ? \"\" : f[3]));\n        }\n        return rows;\n    }\n\n    public Txn txn(String tid) {\n        Map<String, String> kv = new HashMap<>();\n        for (String line : run(List.of(\"txn\", tid)).split(\"\\n\")) {\n            int sp = line.indexOf(' ');\n            if (sp > 0) kv.put(line.substring(0, sp), line.substring(sp + 1).strip());\n        }\n        return new Txn(kv.get(\"tid\"), Long.parseLong(kv.get(\"amt\")), Long.parseLong(kv.get(\"refunded\")),\n                Long.parseLong(kv.get(\"bal\")));\n    }\n\n    private String run(List<String> args) {\n        List<String> cmd = new ArrayList<>();\n        cmd.add(bin.toString());\n        cmd.addAll(args);\n        try {\n            Files.createDirectories(home);\n            ProcessBuilder pb = new ProcessBuilde