{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018SjeAHmp9FLq3qL4zrpuwU","type":"tool_result","content":"\"\"\"Text helpers shared by the claim form and the ledger bridge.\"\"\"\nimport unicodedata\n\n_SPACES = {\"\\t\", \"\\n\", \"\\r\", \"\\x0b\", \"\\x0c\", \" \", \"　\"}\n\n\ndef normalize(text):\n    \"\"\"NFC-normalize, turn odd whitespace into plain spaces, collapse runs.\"\"\"\n    if text is None:\n        return \"\"\n    text = unicodedata.normalize(\"NFC\", str(text))\n    out = []\n    for ch in text:\n        if ch in _SPACES:\n            ch = \" \"\n        elif unicodedata.category(ch) == \"Cc\":\n            continue\n        if ch == \" \" and out and out[-1] == \" \":\n            continue\n        out.append(ch)\n    return \"\".join(out).strip()\n\n\ndef clip_chars(text, limit):\n    \"\"\"Cut text to at most `limit` characters (never splits a character).\"\"\"\n    if limit <= 0:\n        return \"\"\n    if len(text) <= limit:\n        return text\n    return text[:limit].rstrip()\n\n\ndef display_width(text):\n    \"\"\"Terminal/report column width: East Asian wide characters count as 2.\"\"\"\n    width = 0\n    for ch in text:\n        width += 2 if unicodedata.east_asian_width(ch) in (\"W\", \"F\") else 1\n    return width\n\n\ndef pad_display(text, width):\n    \"\"\"Pad (or cut) text so that it occupies exactly `width` report columns.\"\"\"\n    out, used = [], 0\n    for ch in text:\n        w = display_width(ch)\n        if used + w > width:\n            break\n        out.append(ch)\n        used += w\n    return \"\".join(out) + \" \" * (width - used)\n\"\"\"Turns an approved expense claim into a ledger entry.\"\"\"\nfrom hbexpense.models import LedgerEntry\nfrom hbexpense.util.text import clip_chars, normalize\n\n\ndef compose_memo(claim):\n    \"\"\"Memo shown to the finance team: claim id, claimant, what it was for.\"\"\"\n    parts = [claim.claim_id, claim.claimant, claim.description]\n    return normalize(\" \".join(p for p in parts if p))\n\n\ndef build_entry(claim, settings):\n    account = settings.accounts.get(claim.category)\n    if account is None:\n        raise ValueError(f\"no ledger account for category {claim.category}\")\n    memo = clip_chars(compose_memo(claim), settings.ledger_memo_chars)\n    return LedgerEntry(\n        account=account,\n        amount=claim.amount,\n        date=claim.spent_on,\n        ref=claim.claim_id,\n        memo=memo,\n    )\n\"\"\"Thin wrapper around the vendor ledger CLI (vendor/bin/ledgerctl).\"\"\"\nimport os\nimport subprocess\n\nfrom hbexpense.models import LedgerError, LedgerRow\n\n\nclass LedgerClient:\n    def __init__(self, settings):\n        self.binary = settings.ledger_bin\n        self.home = settings.ledger_home or os.environ.get(\"LEDGERCTL_HOME\", \"\")\n        self.timeout = settings.ledger_timeout\n\n    def _run(self, *args):\n        env = dict(os.environ)\n        if self.home:\n            env[\"LEDGERCTL_HOME\"] = self.home\n        proc = subprocess.run(\n            [self.binary, *args],\n            capture_output=True,\n            text=True,\n            encoding=\"utf-8\",\n            env=env,\n            timeout=self.timeout,\n        )\n        if proc.returncode != 0:\n            code = (proc.stderr.strip().splitlines() or [\"E??\"])[-1]\n            raise LedgerError(code, args[0])\n        return proc.stdout\n\n    def post(self, entry):\n        out = self._run(\n            \"post\",\n            \"--acct\", entry.account,\n            \"--amt\", str(entry.amount),\n            \"--date\", entry.date,\n            \"--ref\", entry.ref,\n            \"--memo\", entry.memo,\n        )\n        receipt = out.strip()\n        if not receipt.startswith(\"R\"):\n            raise LedgerError(\"E??\", \"post\")\n        return receipt\n\n    def list_rows(self, date_from, date_to):\n        out = self._run(\"list\", \"--from\", date_from, \"--to\", date_to)\n        rows = []\n        for line in out.splitlines():\n            if not line or line.startswith(\"#\"):\n                continue\n            parts = line.split(\"\\t\", 5)\n            if len(parts) != 6:\n                continue\n            receipt, date, account, amount, ref, memo = parts\n            rows.append(LedgerRow(receipt, date, account, int(amount), ref, memo))\n        return rows\n\n    def show(self, receipt):\n        out = self._run(\"show\", receipt)\n        info = {}\n        for line in out.splitlines():\n            key, _, value = line.partition(\" \")\n            info[key] = value\n        return info\n\"\"\"Month-end settlement: posts approved claims to the vendor ledger.\"\"\"\nfrom hbexpense.ledger.entries import build_entry\nfrom hbexpense.models import APPROVED, POSTED\n\n\nclass SettlementService:\n    def __init__(self, repo, ledger, settings, on_posted=None):\n        self.repo = repo\n        self.ledger = ledger\n        self.settings = settings\n        self.on_posted = on_posted\n\n    def run(self, month):\n        posted, failed = [], []\n        claims = sorted(\n            (c for c in self.repo.in_month(month) if c.status == APPROVED),\n            key=lambda c: (c.spent_on, c.claim_id),\n        )\n        for claim in claims:\n            entry = build_entry(claim, self.settings)\n            try:\n                receipt = self.ledger.post(entry)\n            except Exception as exc:  # keep going; failures are reported\n                failed.append({\"id\": claim.claim_id, \"error\": str(exc)})\n                continue\n            claim.receipt = receipt\n            claim.status = POSTED\n            claim.history.append(POSTED)\n            posted.append({\"id\": claim.claim_id, \"receipt\": receipt})\n        if posted and self.on_posted:\n            self.on_posted(month)\n        return {\"month\": month, \"posted\": posted, \"failed\": failed}","is_error":false}]},"parent_tool_use_id":null,"session_id":"3bca7c00-9ec2-4191-b36c-4757