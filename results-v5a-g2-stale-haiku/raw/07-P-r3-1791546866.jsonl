{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KobYcvQ29zFmqzAVYHjAgH","type":"tool_result","content":"import { validateFailure } from \"../domain/autopay\";\nimport { Reminder } from \"../domain/reminder\";\nimport { PushqClient, PushqError } from \"../push/pushqClient\";\nimport { AutopayRepository } from \"../repository/autopayRepository\";\nimport { ReminderRepository } from \"../repository/reminderRepository\";\nimport { addMinutes, compare, LocalDate, LocalDateTime } from \"../time/localTime\";\nimport { ReminderPlanner } from \"./reminderPlanner\";\n\nexport interface PlanResult {\n  date: LocalDate;\n  planned: number;\n  scheduled: number;\n  alreadyScheduled: number;\n  skippedOptOut: number;\n}\n\n/** 알림 예약·취소와 벤더 시계 진행 */\nexport class ReminderService {\n  private clock: LocalDateTime | undefined;\n\n  constructor(\n    private readonly planner: ReminderPlanner,\n    private readonly autopays: AutopayRepository,\n    private readonly reminders: ReminderRepository,\n    private readonly push: PushqClient,\n    private readonly retryDelayMinutes: number,\n  ) {}\n\n  now(): LocalDateTime | undefined {\n    return this.clock;\n  }\n\n  /** 하루치 출금 예정 알림을 예약한다. 다시 불러도 이미 예약한 알림은 건너뛴다. */\n  planDay(date: LocalDate): PlanResult {\n    const plan = this.planner.billDue(date);\n    let scheduled = 0;\n    let already = 0;\n    for (const r of plan.reminders) {\n      if (this.reminders.has(r.key)) {\n        already++;\n        continue;\n      }\n      this.schedule(r);\n      scheduled++;\n    }\n    return { date, planned: plan.reminders.length, scheduled, alreadyScheduled: already, skippedOptOut: plan.skippedOptOut };\n  }\n\n  /** 출금 실패를 기록하고 재출금 안내를 예약한다. */\n  recordFailure(autopayId: string, body: unknown): { retryAt: LocalDateTime; notice?: { key: string; sendAt: LocalDateTime } } {\n    const a = this.autopays.find(autopayId);\n    if (!a) throw new Error(`autopay ${autopayId} not found`);\n    const f = validateFailure(autopayId, body);\n    this.autopays.addFailure(f);\n    const retryAt = addMinutes(f.failedAt, this.retryDelayMinutes);\n    const r = this.planner.retryNotice(a, retryAt);\n    if (!r || this.reminders.has(r.key)) return { retryAt };\n    this.schedule(r);\n    return { retryAt, notice: { key: r.key, sendAt: r.sendAt } };\n  }\n\n  /** 계약 해지 — 아직 나가지 않은 알림 예약을 취소한다. */\n  cancelAutopay(autopayId: string): { cancelled: number } {\n    this.autopays.deactivate(autopayId);\n    let cancelled = 0;\n    for (const r of this.reminders.byAutopay(autopayId)) {\n      if (!r.ticket || (this.clock && compare(r.sendAt, this.clock) <= 0)) continue;\n      try {\n        this.push.cancel(r.ticket);\n        cancelled++;\n      } catch (e) {\n        // 이미 나간 티켓은 벤더가 E31 을 준다 — 취소할 것이 없으므로 넘어간다.\n        if (!(e instanceof PushqError && e.code === \"E31\")) throw e;\n      }\n      this.reminders.remove(r.key);\n    }\n    return { cancelled };\n  }\n\n  /** 벤더 시계를 until 까지 진행한다(운영에서는 벤더가 스스로 흐른다). */\n  advance(until: LocalDateTime): { delivered: number } {\n    const delivered = this.push.advance(until);\n    this.clock = until;\n    return { delivered };\n  }\n\n  private schedule(r: Reminder): void {\n    const ticket = this.push.schedule(r.device, r.sendAt, r.key, r.message);\n    this.reminders.save({ ...r, ticket });\n  }\n}\n----\nimport { KIND_LABEL } from \"../domain/reminder\";\nimport { maskDevice } from \"../push/deviceToken\";\nimport { DeliveredPush, PushqClient } from \"../push/pushqClient\";\nimport { ReminderRepository } from \"../repository/reminderRepository\";\nimport { compare, LocalDate, LocalDateTime } from \"../time/localTime\";\n\nexport type LineStatus = \"발송\" | \"미발송\" | \"예약\";\n\nexport interface ReportLine {\n  key: string;\n  memberId: string;\n  kind: string;\n  dueAt: LocalDateTime;\n  sendAt: LocalDateTime;\n  ticket: string;\n  device: string;\n  status: LineStatus;\n  deliveredAt?: LocalDateTime;\n}\n\nexport interface ReminderReport {\n  date: LocalDate;\n  asOf: LocalDateTime | null;\n  planned: number;\n  delivered: number;\n  missing: number;\n  pending: number;\n  lines: ReportLine[];\n  text: string;\n}\n\n/** 출금일 기준 알림 발송 현황 — 운영 화면용 */\nexport class ReminderReportBuilder {\n  constructor(private readonly reminders: ReminderRepository, private readonly push: PushqClient) {}\n\n  build(date: LocalDate, asOf: LocalDateTime | undefined): ReminderReport {\n    const byTag = new Map<string, DeliveredPush>();\n    for (const d of this.push.delivered()) if (!byTag.has(d.tag)) byTag.set(d.tag, d);\n\n    const lines: ReportLine[] = this.reminders.byPlanDate(date).map((r) => {\n      const hit = byTag.get(r.key);\n      let status: LineStatus;\n      if (hit) status = \"발송\";\n      else if (asOf && compare(r.sendAt, asOf) <= 0) status = \"미발송\";\n      else status = \"예약\";\n      return {\n        key: r.key,\n        memberId: r.memberId,\n        kind: KIND_LABEL[r.kind],\n        dueAt: r.dueAt,\n        sendAt: r.sendAt,\n        ticket: r.ticket ?? \"-\",\n        device: maskDevice(r.device),\n        status,\n        deliveredAt: hit?.at,\n      };\n    });\n    const count = (s: LineStatus) => lines.filter((l) => l.status === s).length;\n    const planned = lines.length;\n    const delivered = count(\"발송\");\n    const missing = count(\"미발송\");\n    const pending = count(\"예약\");\n    return {\n      date,\n      asOf: asOf ?? null,\n      planned,\n      delivered,\n      missing,\n      pending,\n      lines,\n      text: `${date} 알림 — 예약 ${planned} / 발송 ${delivered} / 미발송 ${missing} / 대기 ${pending}`,\n    };\n  }\n}\n----\nimport { LocalDate, LocalDateTime } from \"../time/localTime\";\n\nexport type ReminderKind = \"BILL_DUE\" | \"RETRY\";\n\nexport const KIND_LABEL: Record<ReminderKind, string> = {\n  BILL_DUE: \"출금 예정\",\n  RETRY: \"재출금 안내\",\n};\n\nconst KIND_CODE: Record<ReminderKind, string> = {\n  BILL_DUE: \"due\",\n  RETRY: \"retry\",\n};\n\nexport interface Reminder {\n  /** 푸시 태그로도 쓰