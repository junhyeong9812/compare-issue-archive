{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CrBoDeDmrg7hNnDqhEQmsL","type":"tool_result","content":"== lib/audit.sh\n# audit.sh — rollout history: one line per finished rollout.\n# release|mark|hosts|changes\n\nhistory_file() { printf '%s/history.log' \"$OUT_DIR\"; }\n\nhistory_add() {\n  ensure_dir \"$OUT_DIR\"\n  printf '%s|%s|%s|%s\\n' \"$1\" \"$2\" \"$3\" \"$4\" >> \"$(history_file)\"\n}\n\nhistory_show() {\n  local f\n  f=$(history_file)\n  [ -f \"$f\" ] || return 0\n  awk -F'|' '{ printf \"%-14s %-9s %3s hosts %3s changes\\n\", $1, $2, $3, $4 }' \"$f\"\n}\n\n== lib/cache.sh\n# cache.sh — per-step memo of config lookups.\n# Rendering asks for the same global/pool keys once per host; the memo keeps\n# that to one CLI call per key. It lives in a fresh directory for every step\n# process and is removed when the step exits.\n\ncache_init() {\n  CACHE_DIR=$(mktemp -d \"${TMPDIR:-/tmp}/rollout-cache.XXXXXX\") || return 1\n  trap 'rm -rf \"$CACHE_DIR\"' EXIT\n}\n\n# cache_get KEY — prints the memoized answer; status 0 hit, 1 miss.\ncache_get() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 1\n  local f=\"$CACHE_DIR/$(key_file \"$1\")\"\n  [ -f \"$f\" ] || return 1\n  # a memoized \"no such key\" is an empty marker file\n  [ -s \"$f\" ] || return 2\n  cat \"$f\"\n}\n\n# cache_put KEY VALUE ; cache_put_missing KEY\ncache_put() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  printf '%s' \"$2\" > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\ncache_put_missing() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  : > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\n\n== lib/cfg.sh\n# cfg.sh — wrapper around the configuration service vendor CLI.\n\n_cfgsvc() { \"$CFGSVC\" \"$@\"; }\n\n# cfg_set KEY VALUE — records VALUE and prints the change number.\ncfg_set() {\n  local out rc\n  out=$(_cfgsvc set \"$1\" \"$2\" 2>&1); rc=$?\n  [ \"$rc\" -eq 0 ] || { warn \"set $1 failed ($out, exit $rc)\"; return 1; }\n  case \"$out\" in\n    C[0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' \"$out\" ;;\n    *) warn \"unexpected answer from config service: $out\"; return 1 ;;\n  esac\n}\n\n# cfg_get KEY — prints the value. Status 1 when the key does not exist,\n# anything else from the CLI is fatal.\ncfg_get() {\n  local out rc\n  out=$(cache_get \"$1\"); rc=$?\n  [ \"$rc\" -eq 0 ] && { printf '%s' \"$out\"; return 0; }\n  [ \"$rc\" -eq 2 ] && return 1\n  out=$(_cfgsvc get \"$1\" 2>&1); rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    cache_put \"$1\" \"$out\"\n    printf '%s' \"$out\"\n    return 0\n  fi\n  if [ \"$rc\" -eq 3 ] && [ \"$out\" = \"E31\" ]; then\n    cache_put_missing \"$1\"\n    return 1\n  fi\n  die \"config service lookup of $1 failed ($out, exit $rc)\"\n}\n\n# cfg_mark — the service's current mark (recorded with every rollout).\ncfg_mark() { _cfgsvc mark; }\n\n# cfg_keys PREFIX — key<TAB>change<TAB>st\ncfg_keys() { _cfgsvc keys \"$1\"; }\n\n== lib/common.sh\n# common.sh — logging, configuration loading and small guards shared by\n# the wrapper and every step script.\n\nlog()  { printf '[%s] %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\nwarn() { printf '[%s] warn: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\ndie()  { printf '[%s] error: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; exit \"${2:-1}\"; }\n\nload_conf() {\n  local f=\"$ROLLOUT_HOME/conf/rollout.conf\"\n  [ -r \"$f\" ] || die \"missing config $f\"\n  # shellcheck disable=SC1090\n  . \"$f\"\n}\n\nrequire_file() {\n  [ -f \"$1\" ] || die \"${2:-file} not found: $1\"\n  [ -r \"$1\" ] || die \"${2:-file} not readable: $1\"\n}\n\nensure_dir() {\n  mkdir -p \"$1\" 2>/dev/null || die \"cannot create directory $1\"\n  [ -w \"$1\" ] || die \"directory not writable: $1\"\n}\n\n# Per-release working area: $WORK_DIR/<release id>\nrun_dir() { printf '%s/%s' \"$WORK_DIR\" \"$1\"; }\n\nhost_out() { printf '%s/hosts/%s/app.conf' \"$OUT_DIR\" \"$1\"; }\n\n== lib/inventory.sh\n# inventory.sh — host list and pools.\n\n# active_hosts — host<TAB>pool for every host that gets a config.\nactive_hosts() {\n  require_file \"$HOSTS_FILE\" \"host list\"\n  awk -F'|' '!/^#/ && NF >= 4 && $4 != \"D\" { print $1 \"\\t\" $2 }' \"$HOSTS_FILE\"\n}\n\nhost_pool() {\n  awk -F'|' -v h=\"$1\" '!/^#/ && $1 == h { print $2; exit }' \"$HOSTS_FILE\"\n}\n\nknown_host() { [ -n \"$(host_pool \"$1\")\" ]; }\n\nknown_pool() {\n  awk -F'|' -v p=\"$1\" '!/^#/ && $2 == p { f = 1 } END { exit !f }' \"$HOSTS_FILE\"\n}\n\n== lib/release.sh\n# release.sh — release files: \"@release <id>\" plus \"<key> = <value>\" lines.\n\nrelease_file() { printf '%s/%s.rel' \"$RELEASE_DIR\" \"$1\"; }\n\n# release_id FILE\nrelease_id() { awk '$1 == \"@release\" { print $2; exit }' \"$1\"; }\n\n# release_changes FILE — key<TAB>value, in file order.\nrelease_changes() {\n  local line key val\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    case \"$line\" in ''|'#'*|'@'*) continue ;; esac\n    key=$(trim \"${line%%=*}\")\n    val=$(trim \"${line#*=}\")\n    printf '%s\\t%s\\n' \"$key\" \"$val\"\n  done < \"$1\"\n}\n\n# template_settings — setting names used by the template.\ntemplate_settings() {\n  grep -o '{{[a-z_]*}}' \"$TEMPLATE\" | tr -d '{}' | sort -u\n}\n\n# release_check FILE — every key must be <scope>.<...>.<setting> with a known\n# setting, pool and host.\nrelease_check() {\n  local key val setting scope mid bad=0 settings\n  settings=\" $(template_settings | tr '\\n' ' ') \"\n  while IFS=$'\\t' read -r key val; do\n    scope=${key%%.*}\n    setting=${key##*.}\n    mid=${key#*.}; mid=${mid%.*}\n    case \" $settings \" in *\" $setting \"*) ;; *) warn \"unknown setting in $key\"; bad=1; continue ;; esac\n    case \"$scope\" in\n      global) [ \"$mid\" = \"$setting\" ] || { warn \"bad global key $key\"; bad=1; } ;;\n      pool)   known_pool \"$mid\" || { warn \"unknown pool in $key\"; bad=1; } ;;\n      host)   known_host \"$mid\" || { warn \"unknown host in $key\"; bad=1; } ;;\n      *)      warn \"unknown scope in $key\"; bad=1 ;;\n    esac\n    [ -n \"$val\" ] || { warn \"empty value for $key\"; bad=1; }\n  done < <(release_changes \"$1\")\n  return \"$bad\"\n}\n\n== lib/render.sh\n# render.sh — app.conf for one host from the template.\n\n# render_host HOST POOL RELEASE — writes the file to stdout.\nrender_host() {\n  local host=$1 pool=$2 release=$3 s val script=\"\"\n  for s in $(template_settings); do\n    val=$(resolve \"$host\" \"$pool\" \"$s\") || { warn \"no value for $s on $host\"; return 1; }\n    case \"$val\" in *$'\\n'*) warn \"multi-line value for $s on $host\"; return 1 ;; esac\n    script=\"${script}s|{{$s}}|$(sed_repl_escape \"$val\")|g;\"\n  done\n  printf '# generated by rollout for %s (pool %s, release %s) — do not edit on the host\\n' \\\n    \"$host\" \"$pool\" \"$release\"\n  sed -e \"$script\" \"$TEMPLATE\"\n}\n\n# rendered_value FILE SETTING-LINE-KEY — value of \"key = value\" in a rendered file\nrendered_value() {\n  awk -v k=\"$2\" '{ i = index($0, \" = \") } i && substr($0, 1, i - 1) == k { print substr($0, i + 3); exit }' \"$1\"\n}\n\n== lib/resolve.sh\n# resolve.sh — effective value of a setting for a host.\n# Most specific scope wins: host.<host>.<s>, then pool.<pool>.<s>, then global.<s>.\n\n# scope_key SCOPE HOST POOL SETTING\nscope_key() {\n  case \"$1\" in\n    host)   printf 'host.%s.%s' \"$2\" \"$4\" ;;\n    pool)   printf 'pool.%s.%s' \"$3\" \"$4\" ;;\n    global) printf 'global.%s' \"$4\" ;;\n  esac\n}\n\n# resolve HOST POOL SETTING — prints the value; status 1 if no scope has it.\nresolve() {\n  local host=$1 pool=$2 setting=$3 scope\n  for scope in $SCOPES; do\n    cfg_get \"$(scope_key \"$scope\" \"$host\" \"$pool\" \"$setting\")\" && return 0\n  done\n  return 1\n}\n\n== lib/text.sh\n# text.sh — small string helpers.\n\n# trim STRING — strip leading/trailing blanks\ntrim() {\n  local s=$1\n  s=${s#\"${s%%[![:space:]]*}\"}\n  s=${s%\"${s##*[![:space:]]}\"}\n  printf '%s' \"$s\"\n}\n\n# sed_repl_escape STRING — make STRING safe as the replacement part of\n# s|pattern|replacement| (escapes backslash, '&' and the '|' delimiter).\nsed_repl_escape() {\n  printf '%s' \"$1\" | sed -e 's/[\\\\&|]/\\\\&/g'\n}\n\n# key_file KEY — a file-name-safe form of a config key\nkey_file() { printf '%s' \"$1\" | tr -c 'a-zA-Z0-9._-' '_'; }\n\n== steps/10-check.sh\n#!/usr/bin/env bash\n# Step 10 — validate the release file and stage it in the run directory.\nROLLOUT_STEP=check\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\nfile=$(release_file \"$rel\")\nrequire_file \"$file\" \"release\"\n[ \"$(release_id \"$file\")\" = \"$rel\" ] || die \"release header does not match $rel\"\nrelease_check \"$file\" || die \"release $rel has invalid lines\" 3\n\ndir=$(run_dir \"$rel\")\nrm -rf \"$dir\"\nensure_dir \"$dir\"\nrelease_changes \"$file\" > \"$dir/changes.tsv\"\nactive_hosts > \"$dir/hosts.tsv\"\nlog \"$rel: $(wc -l < \"$dir/changes.tsv\" | tr -d ' ') changes, $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n\n== steps/20-apply.sh\n#!/usr/bin/env bash\n# Step 20 — write the release's changes to the configuration service.\nROLLOUT_STEP=apply\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/changes.tsv\" \"staged changes\"\n\n: > \"$dir/applied.tsv\"\nwhile IFS=$'\\t' read -r key val; do\n  [ -n \"$key\" ] || continue\n  chg=$(cfg_set \"$key\" \"$val\") || die \"could not apply $key\"\n  printf '%s\\t%s\\n' \"$key\" \"$chg\" >> \"$dir/applied.tsv\"\n  log \"$key -> $chg\"\ndone < \"$dir/changes.tsv\"\nlog \"applied $(wc -l < \"$dir/applied.tsv\" | tr -d ' ') changes\"\n\n== steps/30-render.sh\n#!/usr/bin/env bash\n# Step 30 — render app.conf for every active host from the configuration service.\nROLLOUT_STEP=render\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/hosts.tsv\" \"host list\"\ncache_init || die \"cannot create lookup cache\"\n\nn=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  out=$(host_out \"$host\")\n  ensure_dir \"$(dirname \"$out\")\"\n  render_host \"$host\" \"$pool\" \"$rel\" > \"$out.tmp\" || { rm -f \"$out.tmp\"; die \"render failed for $host\"; }\n  mv -f \"$out.tmp\" \"$out\" || die \"cannot write $out\"\n  n=$((n + 1))\ndone < \"$dir/hosts.tsv\"\nlog \"rendered $n hosts\"\n\n== steps/40-verify.sh\n#!/usr/bin/env bash\n# Step 40 — re-read every rendered file and compare it with the service.\nROLLOUT_STEP=verify\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\ncache_init || die \"cannot create lookup cache\"\n\nbad=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  file=$(host_out \"$host\")\n  require_file \"$file\" \"rendered config\"\n  for s in $(template_settings); do\n    line_key=$(grep -o \"^[a-z_]* = {{$s}}\" \"$TEMPLATE\" | cut -d' ' -f1)\n    want=$(resolve \"$host\" \"$pool\" \"$s\")\n    got=$(rendered_value \"$file\" \"$line_key\")\n    if [ \"$want\" != \"$got\" ]; then\n      warn \"$host: $line_key is [$got], service has [$want]\"\n      bad=1\n    fi\n  done\ndone < \"$dir/hosts.tsv\"\n[ \"$bad\" -eq 0 ] || die \"rendered files do not match the configuration service\" 4\nlog \"verified $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n\n== steps/50-record.sh\n#!/usr/bin/env bash\n# Step 50 — note the rollout in the history together with the service mark.\nROLLOUT_STEP=record\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nmark=$(cfg_mark) || die \"could not read the service mark\"\nhistory_add \"$rel\" \"$mark\" \"$(wc -l < \"$dir/hosts.tsv\" | tr -d ' ')\" \"$(wc -l < \"$dir/applied.tsv\" | tr -d ' ')\"\nlog \"recorded $rel at $mark\"\n\n== steps/_env.sh\n# Sourced by every step script. Expects ROLLOUT_HOME (set by bin/rollout).\n: \"${ROLLOUT_HOME:?run steps through bin/rollout}\"\nfor _lib in common text cache cfg inventory release resolve render audit; do\n  # shellcheck disable=SC1090\n  . \"$ROLLOUT_HOME/lib/$_lib.sh\"\ndone\nunset _lib\nload_conf\n\n== conf/app.conf.tpl\n[database]\nurl = {{db_url}}\npool_size = {{db_pool_size}}\n\n[http]\ntimeout_ms = {{timeout_ms}}\nworker_threads = {{worker_threads}}\n\n[app]\nlog_level = {{log_level}}\nfeature_fastpay = {{feature_fastpay}}\n\n== conf/hosts.conf\n# host|pool|zone|status   (status D = drained: no config is rendered for it)\napi-01|api|a|A\napi-02|api|b|A\napi-03|api|a|A\nbat-01|batch|a|A\nbat-02|batch|b|A\nweb-01|web|a|A\nweb-02|web|b|A\nweb-03|web|a|D\n\n== conf/rollout.conf\n# rollout.conf — defaults for the app config rollout tool.\n# Every value can be overridden from the environment (ROLLOUT_*); the deploy\n# pipeline and the tests use that to point the tool at other directories.\n\nHOSTS_FILE=${ROLLOUT_HOSTS_FILE:-$ROLLOUT_HOME/conf/hosts.conf}\nTEMPLATE=${ROLLOUT_TEMPLATE:-$ROLLOUT_HOME/conf/app.conf.tpl}\nRELEASE_DIR=${ROLLOUT_RELEASE_DIR:-$ROLLOUT_HOME/releases}\nWORK_DIR=${ROLLOUT_WORK_DIR:-/var/tmp/rollout}\n# Rendered files land in $OUT_DIR/hosts/<host>/app.conf; the host agents\n# pick them up from there.\nOUT_DIR=${ROLLOUT_OUT_DIR:-/srv/rollout}\n\n# Configuration service CLI (vendor). Its state directory comes from CFGSVC_HOME.\nCFGSVC=${ROLLOUT_CFGSVC:-$ROLLOUT_HOME/vendor/bin/cfgsvc}\n\n# Key scopes, most specific first: host.<host>.<s>, pool.<pool>.<s>, global.<s>\nSCOPES=\"host pool global\"\n\n== releases/r2026.10.01.rel\n# r2026.10.01 — baseline after the September DB migration\n@release r2026.10.01\nglobal.db_url          = jdbc:postgresql://pay-db.hbp.internal:5432/pay?ssl=true&app=hbpay\nglobal.db_pool_size    = 16\nglobal.timeout_ms      = 5000\nglobal.worker_threads  = 4\nglobal.log_level       = info\nglobal.feature_fastpay = off\npool.api.db_pool_size  = 20\npool.api.timeout_ms    = 3000\npool.batch.worker_threads = 8\npool.batch.timeout_ms  = 60000\nhost.web-01.log_level  = warn\n\n== releases/r2026.10.08.rel\n# r2026.10.08 — api pool DB tuning (OPS-2291), batch fast-pay pilot, bat-02 debug logging\n@release r2026.10.08\npool.api.db_pool_size     = 40\npool.api.timeout_ms       = 2500\npool.batch.feature_fastpay = on\nhost.bat-02.log_level     = debug","is_error":false}]},"parent_tool_use_id":null,"session_id":"f7b92296-08a3-4cff-9cde-c8771f782925","uuid":"c4c03c19-92fc-44d0-91fe-491a1a4134ba","timestamp":"2026-10-09T10:35:49.031Z","tool_use_result":{"stdout":"== lib/audit.sh\n# audit.sh — rollout history: one line per finished rollout.\n# release|mark|hosts|changes\n\nhistory_file() { printf '%s/history.log' \"$OUT_DIR\"; }\n\nhistory_add() {\n  ensure_dir \"$OUT_DIR\"\n  printf '%s|%s|%s|%s\\n' \"$1\" \"$2\" \"$3\" \"$4\" >> \"$(history_file)\"\n}\n\nhistory_show() {\n  local f\n  f=$(history_file)\n  [ -f \"$f\" ] || return 0\n  awk -F'|' '{ printf \"%-14s %-9s %3s hosts %3s changes\\n\", $1, $2, $3, $4 }' \"$f\"\n}\n\n== lib/cache.sh\n# cache.sh — per-step memo of config lookups.\n# Rendering asks for the same global/pool keys once per host; the memo keeps\n# that to one CLI call per key. It lives in a fresh directory for every step\n# process and is removed when the step exits.\n\ncache_init() {\n  CACHE_DIR=$(mktemp -d \"${TMPDIR:-/tmp}/rollout-cache.XXXXXX\") || return 1\n  trap 'rm -rf \"$CACHE_DIR\"' EXIT\n}\n\n# cache_get KEY — prints the memoized answer; status 0 hit, 1 miss.\ncache_get() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 1\n  local f=\"$CACHE_DIR/$(key_file \"$1\")\"\n  [ -f \"$f\" ] || return 1\n  # a memoized \"no such key\" is an empty marker file\n  [ -s \"$f\" ] || return 2\n  cat \"$f\"\n}\n\n# cache_put KEY VALUE ; cache_put_missing KEY\ncache_put() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  printf '%s' \"$2\" > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\ncache_put_missing() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  : > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\n\n== lib/cfg.sh\n# cfg.sh — wrapper around the configuration service vendor CLI.\n\n_cfgsvc() { \"$CFGSVC\" \"$@\"; }\n\n# cfg_set KEY VALUE — records VALUE and prints the change number.\ncfg_set() {\n  local out rc\n  out=$(_cfgsvc set \"$1\" \"$2\" 2>&1); rc=$?\n  [ \"$rc\" -eq 0 ] || { warn \"set $1 failed ($out, exit $rc)\"; return 1; }\n  case \"$out\" in\n    C[0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' \"$out\" ;;\n    *) warn \"unexpected answer from config service: $out\"; return 1 ;;\n  esac\n}\n\n# cfg_get KEY — prints the value. Status 1 when the key does not exist,\n# anything else from the CLI is fatal.\ncfg_get() {\n  local out rc\n  out=$(cache_get \"$1\"); rc=$?\n  [ \"$rc\" -eq 0 ] && { printf '%s' \"$out\"; return 0; }\n  [ \"$rc\" -eq 2 ] && return 1\n  out=$(_cfgsvc get \"$1\" 2>&1); rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    cache_put \"$1\" \"$out\"\n    printf '%s' \"$out\"\n    return 0\n  fi\n  if [ \"$rc\" -eq 3 ] && [ \"$out\" = \"E31\" ]; then\n    cache_put_missing \"$1\"\n    return 1\n  fi\n  die \"config service lookup of $1 failed ($out, exit $rc)\"\n}\n\n# cfg_mark — the service's current mark (recorded with every rollout).\ncfg_mark() { _cfgsvc mark; }\n\n# cfg_keys PREFIX — key<TAB>change<TAB>st\ncfg_keys() { _cfgsvc keys \"$1\"; }\n\n== lib/common.sh\n# common.sh — logging, configuration loading and small guards shared by\n# the wrapper and every step script.\n\nlog()  { printf '[%s] %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\nwarn() { printf '[%s] warn: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\ndie()  { printf '[%s] error: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; exit \"${2:-1}\"; }\n\nload_conf() {\n  local f=\"$ROLLOUT_HOME/conf/rollout.conf\"\n  [ -r \"$f\" ] || die \"missing config $f\"\n  # shellcheck disable=SC1090\n  . \"$f\"\n}\n\nrequire_file() {\n  [ -f \"$1\" ] || die \"${2:-file} not found: $1\"\n  [ -r \"$1\" ] || die \"${2:-file} not readable: $1\"\n}\n\nensure_dir() {\n  mkdir -p \"$1\" 2>/dev/null || die \"cannot create directory $1\"\n  [ -w \"$1\" ] || die \"directory not writable: $1\"\n}\n\n# Per-release working area: $WORK_DIR/<release id>\nrun_dir() { printf '%s/%s' \"$WORK_DIR\" \"$1\"; }\n\nhost_out() { printf '%s/hosts/%s/app.conf' \"$OUT_DIR\" \"$1\"; }\n\n== lib/inventory.sh\n# inventory.sh — host list and pools.\n\n# active_hosts — host<TAB>pool for every host that gets a config.\nactive_hosts() {\n  require_file \"$HOSTS_FILE\" \"host list\"\n  awk -F'|' '!/^#/ && NF >= 4 && $4 != \"D\" { print $1 \"\\t\" $2 }' \"$HOSTS_FILE\"\n}\n\nhost_pool() {\n  awk -F'|' -v h=\"$1\" '!/^#/ && $1 == h { print $2; exit }' \"$HOSTS_FILE\"\n}\n\nknown_host() { [ -n \"$(host_pool \"$1\")\" ]; }\n\nknown_pool() {\n  awk -F'|' -v p=\"$1\" '!/^#/ && $2 == p { f = 1 } END { exit !f }' \"$HOSTS_FILE\"\n}\n\n== lib/release.sh\n# release.sh — release files: \"@release <id>\" plus \"<key> = <value>\" lines.\n\nrelease_file() { printf '%s/%s.rel' \"$RELEASE_DIR\" \"$1\"; }\n\n# release_id FILE\nrelease_id() { awk '$1 == \"@release\" { print $2; exit }' \"$1\"; }\n\n# release_changes FILE — key<TAB>value, in file order.\nrelease_changes() {\n  local line key val\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    case \"$line\" in ''|'#'*|'@'*) continue ;; esac\n    key=$(trim \"${line%%=*}\")\n    val=$(trim \"${line#*=}\")\n    printf '%s\\t%s\\n' \"$key\" \"$val\"\n  done < \"$1\"\n}\n\n# template_settings — setting names used by the template.\ntemplate_settings() {\n  grep -o '{{[a-z_]*}}' \"$TEMPLATE\" | tr -d '{}' | sort -u\n}\n\n# release_check FILE — every key must be <scope>.<...>.<setting> with a known\n# setting, pool and host.\nrelease_check() {\n  local key val setting scope mid bad=0 settings\n  settings=\" $(template_settings | tr '\\n' ' ') \"\n  while IFS=$'\\t' read -r key val; do\n    scope=${key%%.*}\n    setting=${key##*.}\n    mid=${key#*.}; mid=${mid%.*}\n    case \" $settings \" in *\" $setting \"*) ;; *) warn \"unknown setting in $key\"; bad=1; continue ;; esac\n    case \"$scope\" in\n      global) [ \"$mid\" = \"$setting\" ] || { warn \"bad global key $key\"; bad=1; } ;;\n      pool)   known_pool \"$mid\" || { warn \"unknown pool in $key\"; bad=1; } ;;\n      host)   known_host \"$mid\" || { warn \"unknown host in $key\"; bad=1; } ;;\n      *)      warn \"unknown scope in $key\"; bad=1 ;;\n    esac\n    [ -n \"$val\" ] || { warn \"empty value for $key\"; bad=1; }\n  done < <(release_changes \"$1\")\n  return \"$bad\"\n}\n\n== lib/render.sh\n# render.sh — app.conf for one host from the template.\n\n# render_host HOST POOL RELEASE — writes the file to stdout.\nrender_host() {\n  local host=$1 pool=$2 release=$3 s val script=\"\"\n  for s in $(template_settings); do\n    val=$(resolve \"$host\" \"$pool\" \"$s\") || { warn \"no value for $s on $host\"; return 1; }\n    case \"$val\" in *$'\\n'*) warn \"multi-line value for $s on $host\"; return 1 ;; esac\n    script=\"${script}s|{{$s}}|$(sed_repl_escape \"$val\")|g;\"\n  done\n  printf '# generated by rollout for %s (pool %s, release %s) — do not edit on the host\\n' \\\n    \"$host\" \"$pool\" \"$release\"\n  sed -e \"$script\" \"$TEMPLATE\"\n}\n\n# rendered_value FILE SETTING-LINE-KEY — value of \"key = value\" in a rendered file\nrendered_value() {\n  awk -v k=\"$2\" '{ i = index($0, \" = \") } i && substr($0, 1, i - 1) == k { print substr($0, i + 3); exit }' \"$1\"\n}\n\n== lib/resolve.sh\n# resolve.sh — effective value of a setting for a host.\n# Most specific scope wins: host.<host>.<s>, then pool.<pool>.<s>, then global.<s>.\n\n# scope_key SCOPE HOST POOL SETTING\nscope_key() {\n  case \"$1\" in\n    host)   printf 'host.%s.%s' \"$2\" \"$4\" ;;\n    pool)   printf 'pool.%s.%s' \"$3\" \"$4\" ;;\n    global) printf 'global.%s' \"$4\" ;;\n  esac\n}\n\n# resolve HOST POOL SETTING — prints the value; status 1 if no scope has it.\nresolve() {\n  local host=$1 pool=$2 setting=$3 scope\n  for scope in $SCOPES; do\n    cfg_get \"$(scope_key \"$scope\" \"$host\" \"$pool\" \"$setting\")\" && return 0\n  done\n  return 1\n}\n\n== lib/text.sh\n# text.sh — small string helpers.\n\n# trim STRING — strip leading/trailing blanks\ntrim() {\n  local s=$1\n  s=${s#\"${s%%[![:space:]]*}\"}\n  s=${s%\"${s##*[![:space:]]}\"}\n  printf '%s' \"$s\"\n}\n\n# sed_repl_escape STRING — make STRING safe as the replacement part of\n# s|pattern|replacement| (escapes backslash, '&' and the '|' delimiter).\nsed_repl_escape() {\n  printf '%s' \"$1\" | sed -e 's/[\\\\&|]/\\\\&/g'\n}\n\n# key_file KEY — a file-name-safe form of a config key\nkey_file() { printf '%s' \"$1\" | tr -c 'a-zA-Z0-9._-' '_'; }\n\n== steps/10-check.sh\n#!/usr/bin/env bash\n# Step 10 — validate the release file and stage it in the run directory.\nROLLOUT_STEP=check\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\nfile=$(release_file \"$rel\")\nrequire_file \"$file\" \"release\"\n[ \"$(release_id \"$file\")\" = \"$rel\" ] || die \"release header does not match $rel\"\nrelease_check \"$file\" || die \"release $rel has invalid lines\" 3\n\ndir=$(run_dir \"$rel\")\nrm -rf \"$dir\"\nensure_dir \"$dir\"\nrelease_changes \"$file\" > \"$dir/changes.tsv\"\nactive_hosts > \"$dir/hosts.tsv\"\nlog \"$rel: $(wc -l < \"$dir/changes.tsv\" | tr -d ' ') changes, $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n\n== steps/20-apply.sh\n#!/usr/bin/env bash\n# Step 20 — write the release's changes to the configuration service.\nROLLOUT_STEP=apply\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/changes.tsv\" \"staged changes\"\n\n: > \"$dir/applied.tsv\"\nwhile IFS=$'\\t' read -r key val; do\n  [ -n \"$key\" ] || continue\n  chg=$(cfg_set \"$key\" \"$val\") || die \"could not apply $key\"\n  printf '%s\\t%s\\n' \"$key\" \"$chg\" >> \"$dir/applied.tsv\"\n  log \"$key -> $chg\"\ndone < \"$dir/changes.tsv\"\nlog \"applied $(wc -l < \"$dir/applied.tsv\" | tr -d ' ') changes\"\n\n== steps/30-render.sh\n#!/usr/bin/env bash\n# Step 30 — render app.conf for every active host from the configuration service.\nROLLOUT_STEP=render\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/hosts.tsv\" \"host list\"\ncache_init || die \"cannot create lookup cache\"\n\nn=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  out=$(host_out \"$host\")\n  ensure_dir \"$(dirname \"$out\")\"\n  render_host \"$host\" \"$pool\" \"$rel\" > \"$out.tmp\" || { rm -f \"$out.tmp\"; die \"render failed for $host\"; }\n  mv -f \"$out.tmp\" \"$out\" || die \"cannot write $out\"\n  n=$((n + 1))\ndone < \"$dir/hosts.tsv\"\nlog \"rendered $n hosts\"\n\n== steps/40-verify.sh\n#!/usr/bin/env bash\n# Step 40 — re-read every rendered file and compare it with the service.\nROLLOUT_STEP=verify\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\ncache_init || die \"cannot create lookup cache\"\n\nbad=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  file=$(host_out \"$host\")\n  require_file \"$file\" \"rendered config\"\n  for s in $(template_settings); do\n    line_key=$(grep -o \"^[a-z_]* = {{$s}}\" \"$TEMPLATE\" | cut -d' ' -f1)\n    want=$(resolve \"$host\" \"$pool\" \"$s\")\n    got=$(rendered_value \"$file\" \"$line_key\")\n    if [ \"$want\" != \"$got\" ]; then\n      warn \"$host: $line_key is [$got], service has [$want]\"\n      bad=1\n    fi\n  done\ndone < \"$dir/hosts.tsv\"\n[ \"$bad\" -eq 0 ] || die \"rendered files do not match the configuration service\" 4\nlog \"verified $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n\n== steps/50-record.sh\n#!/usr/bin/env bash\n# Step 50 — note the rollout in the history together with the service mark.\nROLLOUT_STEP=record\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nmark=$(cfg_mark) || die \"could not read the service mark\"\nhistory_add \"$rel\" \"$mark\" \"$(wc -l < \"$dir/hosts.tsv\" | tr -d ' ')\" \"$(wc -l < \"$dir/applied.tsv\" | tr -d ' ')\"\nlog \"recorded $rel at $mark\"\n\n== steps/_env.sh\n# Sourced by every step script. Expects ROLLOUT_HOME (set by bin/rollout).\n: \"${ROLLOUT_HOME:?run steps through bin/rollout}\"\nfor _lib in common text cache cfg inventory release resolve render audit; do\n  # shellcheck disable=SC1090\n  . \"$ROLLOUT_HOME/lib/$_lib.sh\"\ndone\nunset _lib\nload_conf\n\n== conf/app.conf.tpl\n[database]\nurl = {{db_url}}\npool_size = {{db_pool_size}}\n\n[http]\ntimeout_ms = {{timeout_ms}}\nworker_threads = {{worker_threads}}\n\n[app]\nlog_level = {{log_level}}\nfeature_fastpay = {{feature_fastpay}}\n\n== conf/hosts.conf\n# host|pool|zone|status   (status D = drained: no config is rendered for it)\napi-01|api|a|A\napi-02|api|b|A\napi-03|api|a|A\nbat-01|batch|a|A\nbat-02|batch|b|A\nweb-01|web|a|A\nweb-02|web|b|A\nweb-03|web|a|D\n\n== conf/rollout.conf\n# rollout.conf — defaults for the app config rollout tool.\n# Every value can be overridden from the environment (ROLLOUT_*); the deploy\n# pipeline and the tests use that to point the tool at other directories.\n\nHOSTS_FILE=${ROLLOUT_HOSTS_FILE:-$ROLLOUT_HOME/conf/hosts.conf}\nTEMPLATE=${ROLLOUT_TEMPLATE:-$ROLLOUT_HOME/conf/app.conf.tpl}\nRELEASE_DIR=${ROLLOUT_RELEASE_DIR:-$ROLLOUT_HOME/releases}\nWORK_DIR=${ROLLOUT_WORK_DIR:-/var/tmp/rollout}\n# Rendered files land in $OUT_DIR/hosts/<host>/app.conf; the host agents\n# pick them up from there.\nOUT_DIR=${ROLLOUT_OUT_DIR:-/srv/rollout}\n\n# Configuration service CLI (vendor). Its state directory comes from CFGSVC_HOME.\nCFGSVC=${ROLLOUT_CFGSVC:-$ROLLOUT_HOME/vendor/bin/cfgsvc}\n\n# Key scopes, most specific first: host.<host>.<s>, pool.<pool>.<s>, global.<s>\nSCOPES=\"host pool global\"\n\n== releases/r2026.10.01.rel\n# r2026.10.01 — baseline after the September DB migration\n@release r2026.10.01\nglobal.db_url          = jdbc:postgresql://pay-db.hbp.internal:5432/pay?ssl=true&app=hbpay\nglobal.db_pool_size    = 16\nglobal.timeout_ms      = 5000\nglobal.worker_threads  = 4\nglobal.log_level       = info\nglobal.feature_fastpay = off\npool.api.db_pool_size  = 20\npool.api.timeout_ms    = 3000\npool.batch.worker_threads = 8\npool.batch.timeout_ms  = 60000\nhost.web-01.log_level  = warn\n\n== releases/r2026.10.08.rel\n# r2026.10.08 — api pool DB tuning (OPS-2291), batch fast-pay pilot, bat-02 debug logging\n@release r2026.10.08\npool.api.db_pool_size     = 40\npool.api.timeout_ms       = 2500\npool.batch.feature_fastpay = on\nhost.bat-02.log_level     = debug","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CrBoDeDmrg7hNnDqhEQmsL","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
