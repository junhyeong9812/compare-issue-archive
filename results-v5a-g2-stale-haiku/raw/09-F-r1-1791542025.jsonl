\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000=@\u0000\u0000\u0000\u0000\u0000\u0000\n\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000====\n# common.sh — logging, configuration loading and small guards shared by\n# the wrapper and every step script.\n\nlog()  { printf '[%s] %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\nwarn() { printf '[%s] warn: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\ndie()  { printf '[%s] error: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; exit \"${2:-1}\"; }\n\nload_conf() {\n  local f=\"$ROLLOUT_HOME/conf/rollout.conf\"\n  [ -r \"$f\" ] || die \"missing config $f\"\n  # shellcheck disable=SC1090\n  . \"$f\"\n}\n\nrequire_file() {\n  [ -f \"$1\" ] || die \"${2:-file} not found: $1\"\n  [ -r \"$1\" ] || die \"${2:-file} not readable: $1\"\n}\n\nensure_dir() {\n  mkdir -p \"$1\" 2>/dev/null || die \"cannot create directory $1\"\n  [ -w \"$1\" ] || die \"directory not writable: $1\"\n}\n\n# Per-release working area: $WORK_DIR/<release id>\nrun_dir() { printf '%s/%s' \"$WORK_DIR\" \"$1\"; }\n\nhost_out() { printf '%s/hosts/%s/app.conf' \"$OUT_DIR\" \"$1\"; }\n# release.sh — release files: \"@release <id>\" plus \"<key> = <value>\" lines.\n\nrelease_file() { printf '%s/%s.rel' \"$RELEASE_DIR\" \"$1\"; }\n\n# release_id FILE\nrelease_id() { awk '$1 == \"@release\" { print $2; exit }' \"$1\"; }\n\n# release_changes FILE — key<TAB>value, in file order.\nrelease_changes() {\n  local line key val\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    case \"$line\" in ''|'#'*|'@'*) continue ;; esac\n    key=$(trim \"${line%%=*}\")\n    val=$(trim \"${line#*=}\")\n    printf '%s\\t%s\\n' \"$key\" \"$val\"\n  done < \"$1\"\n}\n\n# template_settings — setting names used by the template.\ntemplate_settings() {\n  grep -o '{{[a-z_]*}}' \"$TEMPLATE\" | tr -d '{}' | sort -u\n}\n\n# release_check FILE — every key must be <scope>.<...>.<setting> with a known\n# setting, pool and host.\nrelease_check() {\n  local key val setting scope mid bad=0 settings\n  settings=\" $(template_settings | tr '\\n' ' ') \"\n  while IFS=$'\\t' read -r key val; do\n    scope=${key%%.*}\n    setting=${key##*.}\n    mid=${key#*.}; mid=${mid%.*}\n    case \" $settings \" in *\" $setting \"*) ;; *) warn \"unknown setting in $key\"; bad=1; continue ;; esac\n    case \"$scope\" in\n      global) [ \"$mid\" = \"$setting\" ] || { warn \"bad global key $key\"; bad=1; } ;;\n      pool)   known_pool \"$mid\" || { warn \"unknown pool in $key\"; bad=1; } ;;\n      host)   known_host \"$mid\" || { warn \"unknown host in $key\"; bad=1; } ;;\n      *)      warn \"unknown scope in $key\"; bad=1 ;;\n    esac\n    [ -n \"$val\" ] || { warn \"empty value for $key\"; bad=1; }\n  done < <(release_changes \"$1\")\n  return \"$bad\"\n}\n# resolve.sh — effective value of a setting for a host.\n# Most specific scope wins: host.<host>.<s>, then pool.<pool>.<s>, then global.<s>.\n\n# scope_key SCOPE HOST POOL SETTING\nscope_key() {\n  case \"$1\" in\n    host)   printf 'host.%s.%s' \"$2\" \"$4\" ;;\n    pool)   printf 'pool.%s.%s' \"$3\" \"$4\" ;;\n    global) printf 'global.%s' \"$4\" ;;\n  esac\n}\n\n# resolve HOST POOL SETTING — prints the value; status 1 if no scope has it.\nresolve() {\n  local host=$1 pool=$2 setting=$3 scope\n  for scope in $SCOPES; do\n    cfg_get \"$(scope_key \"$scope\" \"$host\" \"$pool\" \"$setting\")\" && return 0\n  done\n  return 1\n}\n# render.sh — app.conf for one host from the template.\n\n# render_host HOST POOL RELEASE — writes the file to stdout.\nrender_host() {\n  local host=$1 pool=$2 release=$3 s val script=\"\"\n  for s in $(template_settings); do\n    val=$(resolve \"$host\" \"$pool\" \"$s\") || { warn \"no value for $s on $host\"; return 1; }\n    case \"$val\" in *$'\\n'*) warn \"multi-line value for $s on $host\"; return 1 ;; esac\n    script=\"${script}s|{{$s}}|$(sed_repl_escape \"$val\")|g;\"\n  done\n  printf '# generated by rollout for %s (pool %s, release %s) — do not edit on the host\\n' \\\n    \"$host\" \"$pool\" \"$release\"\n  sed -e \"$script\" \"$TEMPLATE\"\n}\n\n# rendered_value FILE SETTING-LINE-KEY — value of \"key = value\" in a rendered file\nrendered_value() {\n  awk -v k=\"$2\" '{ i = index($0, \" = \") } i && substr($0, 1, i - 1) == k { print substr($0, i + 3); exit }' \"$1\"\n}\n# cache.sh — per-step memo of config lookups.\n# Rendering asks for the same global/pool keys once per host; the memo keeps\n# that to one CLI call per key. It lives in a fresh directory for every step\n# process and is removed when the step exits.\n\ncache_init() {\n  CACHE_DIR=$(mktemp -d \"${TMPDIR:-/tmp}/rollout-cache.XXXXXX\") || return 1\n  trap 'rm -rf \"$CACHE_DIR\"' EXIT\n}\n\n# cache_get KEY — prints the memoized answer; status 0 hit, 1 miss.\ncache_get() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 1\n  local f=\"$CACHE_DIR/$(key_file \"$1\")\"\n  [ -f \"$f\" ] || return 1\n  # a memoized \"no such key\" is an empty marker file\n  [ -s \"$f\" ] || return 2\n  cat \"$f\"\n}\n\n# cache_put KEY VALUE ; cache_put_missing KEY\ncache_put() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  printf '%s' \"$2\" > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\ncache_put_missing() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  : > \"$CACHE_DIR/$(key_file \"$1\")\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014uavkGMUEF8biZxBzaMoa9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
