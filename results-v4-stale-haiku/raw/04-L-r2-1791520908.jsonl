ed to the transfer CLI that day\n#   payout receipts PARTNER FROM TO  what the partner can download, per day\n#   payout partners                  active partner codes\n#\n# DATE is YYYYMMDD. Configuration: conf/payout.conf (PAYOUT_* overrides).\nset -u\nexport LC_ALL=C.UTF-8\nPAYOUT_HOME=$(cd \"$(dirname \"$0\")/..\" && pwd)\nexport PAYOUT_HOME\n. \"$PAYOUT_HOME/steps/_env.sh\"\n\nusage() { sed -n '3,9p' \"$0\" | sed 's/^# \\{0,1\\}//'; }\n\ncmd_run() {\n  local date=$1 step rc\n  for step in \"$PAYOUT_HOME\"/steps/[0-9][0-9]-*.sh; do\n    bash \"$step\" \"$date\"\n    rc=$?\n    if [ \"$rc\" -ne 0 ]; then\n      warn \"step $(basename \"$step\") failed (exit $rc)\"\n      return \"$rc\"\n    fi\n  done\n  log \"run $date complete\"\n}\n\ncmd_manifest() {\n  local date=$1 p name ticket rows\n  printf '# %s\\n' \"$(date_dash \"$date\")\"\n  manifest_show \"$date\" | while IFS='|' read -r _ p name ticket rows; do\n    printf '%-5s %-40s %s %4s\\n' \"$p\" \"$name\" \"$ticket\" \"$rows\"\n  done\n}\n\n[ $# -ge 1 ] || { usage; exit 64; }\ncmd=$1; shift\ncase \"$cmd\" in\n  run)      [ $# -eq 1 ] || { usage; exit 64; }; cmd_run \"$(check_date \"$1\")\" ;;\n  manifest) [ $# -eq 1 ] || { usage; exit 64; }; cmd_manifest \"$(check_date \"$1\")\" ;;\n  receipts) [ $# -eq 3 ] || { usage; exit 64; }\n            receipts_report \"$1\" \"$(check_date \"$2\")\" \"$(check_date \"$3\")\" ;;\n  partners) active_partners ;;\n  -h|--help|help) usage ;;\n  *) usage; exit 64 ;;\nesac","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018YUodio6CBVTKQViiTXxTG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
