+    /**
+     * CS "즉시 환불": sends the given lines right away in a run of their own (same run/batch numbering).
+     * Lines whose payment was made on {@code day} are not sent; they stay queued for a later nightly run,
+     * exactly as the nightly run itself treats them.
+     */
+    public RunResult runNow(List<RefundLine> lines, LocalDate day) {
+        List<RefundLine> ready = new ArrayList<>();
+        for (RefundLine l : lines) {
+            if (l.status() != RefundLine.Status.REQUESTED) continue;
+            if (l.paidOn() != null && !l.paidOn().isBefore(day)) continue;
+            ready.add(l);
+        }
+        if (ready.isEmpty()) return new RunResult(null, List.of(), 0, 0, 0);
+        return send(nextRunId(day), ready);
+    }
