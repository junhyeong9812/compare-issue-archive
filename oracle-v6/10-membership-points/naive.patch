+
+    /** Customer-care compensation: credits points once per ticket; returns the vendor entry number. */
+    public String compensate(String memberNo, long points, String ticketNo) {
+        Member m = members.find(memberNo).orElseThrow(() -> new IllegalArgumentException("unknown member " + memberNo));
+        if (points <= 0) throw new IllegalArgumentException("points must be positive: " + points);
+        if (ledger.contains(ticketNo)) throw new IllegalStateException("ticket already compensated: " + ticketNo);
+        String entryNo = pts.earn(m.memberNo(), points, refPrefix + "-" + ticketNo);
+        ledger.record(new EarnEntry(ticketNo, m.memberNo(), points, LocalDate.now(), entryNo));
+        return entryNo;
+    }
