 from hbexpense.api.http import Response, month_param, str_param
+from hbexpense.models import POSTED
+from hbexpense.util.dates import month_of
 from hbexpense.util.money import format_krw
 from hbexpense.util.text import pad_display
 
 
+def _with_ledger_status(app, claims):
+    """Claim dicts plus ledger_status, read from the ledger's period listing."""
+    posted = [c for c in claims if c.status == POSTED and c.receipt]
+    listed = app.services["reports"].listed_receipts(month_of(c.spent_on) for c in posted)
+    out = []
+    for claim in claims:
+        item = claim.to_dict()
+        if claim.status == POSTED and claim.receipt:
+            item["ledger_status"] = "booked" if claim.receipt in listed else "not_booked"
+        else:
+            item["ledger_status"] = None
+        out.append(item)
+    return out
+
