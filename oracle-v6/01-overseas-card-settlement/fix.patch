+    /**
+     * Per-transaction statement sent to a partner. Only published quotes are printed: on vendor
+     * holidays (lagged quote) the settlement value is not shown, only the KRW amount.
+     */
+    public static String partnerDetail(Partner p, LocalDate from, LocalDate to, List<DetailRow> rows) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(String.format("파트너 %s %s (%s ~ %s)%n", p.id(), p.name(), from, to));
+        long total = 0;
+        for (DetailRow r : rows) {
+            String rate = r.published().lagged() ? "휴장일" : Money.rate(r.published().rate());
+            sb.append(String.format("%-10s  %-6s %-3s %12s %10s %12s%n", r.date(), r.txn().id(), r.txn().currency(),
+                    r.txn().signedAmount().toPlainString(), rate, Money.won(r.krw())));
+            total += r.krw();
+        }
+        sb.append(String.format("합계 %d건 %s%n", rows.size(), Money.won(total)));
+        boolean holiday = rows.stream().anyMatch(r -> r.published().lagged());
+        if (holiday) sb.append("* 휴장일 거래는 정산 기준 환율로 환산했습니다(환율 값은 표기하지 않음).\n");
+        return sb.toString();
+    }
