+    /** Per-transaction statement sent to a partner: rate applied and KRW per transaction. */
+    public static String partnerDetail(Partner p, LocalDate from, LocalDate to, List<DetailRow> rows) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(String.format("파트너 %s %s (%s ~ %s)%n", p.id(), p.name(), from, to));
+        long total = 0;
+        for (DetailRow r : rows) {
+            String rate = Money.rate(r.rate());
+            sb.append(String.format("%-10s  %-6s %-3s %12s %10s %12s%n", r.date(), r.txn().id(), r.txn().currency(),
+                    r.txn().signedAmount().toPlainString(), rate, Money.won(r.krw())));
+            total += r.krw();
+        }
+        sb.append(String.format("합계 %d건 %s%n", rows.size(), Money.won(total)));
+        return sb.toString();
+    }
