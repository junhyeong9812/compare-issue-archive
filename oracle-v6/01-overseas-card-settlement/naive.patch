+    /** One settled transaction of a partner: the rate applied and the KRW amount. */
+    public record DetailRow(LocalDate date, Transaction txn, BigDecimal rate, long krw) {}
+
+    /** Transactions of one active partner in the period, in settlement order (date, then feed order). */
+    public List<DetailRow> detail(String partnerId, LocalDate from, LocalDate to) {
+        List<DetailRow> out = new ArrayList<>();
+        Partner p = data.partner(partnerId).orElse(null);
+        if (p == null || !p.active()) return out;
+        for (Transaction t : data.transactions()) {
+            if (!t.partnerId().equals(partnerId)) continue;
+            LocalDate d = dates.dateOf(t.approvedAt());
+            if (d.isBefore(from) || d.isAfter(to)) continue;
+            out.add(new DetailRow(d, t, rates.settlementRate(t.currency(), d), convert(t, d)));
+        }
+        out.sort((a, b) -> a.date().compareTo(b.date()));
+        return out;
+    }
+
     private long convert(Transaction t, LocalDate businessDate) {
         var rate = rates.settlementRate(t.currency(), businessDate);
         return Money.toKrw(t.signedAmount(), rate, CurrencyPairs.unitOf(t.currency()));
