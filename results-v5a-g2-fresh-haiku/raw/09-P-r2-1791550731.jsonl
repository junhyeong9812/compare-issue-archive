{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A4bGMou112FmAAmA2yQgkC","type":"tool_result","content":"=== bin/rollout\n#!/usr/bin/env bash\n# rollout — app configuration rollout for the payment hosts.\n#\n#   rollout apply RELEASE     check → apply → render → verify → record\n#   rollout show HOST         the rendered app.conf of HOST\n#   rollout hosts             active hosts and their pools\n#   rollout history           finished rollouts\n#\n# RELEASE is a file name under releases/ without .rel (e.g. r2026.10.08).\n# Configuration: conf/rollout.conf (ROLLOUT_* overrides).\nset -u\nexport LC_ALL=C.UTF-8\nROLLOUT_HOME=$(cd \"$(dirname \"$0\")/..\" && pwd)\nexport ROLLOUT_HOME\n. \"$ROLLOUT_HOME/steps/_env.sh\"\n\nusage() { sed -n '3,10p' \"$0\" | sed 's/^# \\{0,1\\}//'; }\n\ncmd_apply() {\n  local rel=$1 step rc\n  for step in \"$ROLLOUT_HOME\"/steps/[0-9][0-9]-*.sh; do\n    bash \"$step\" \"$rel\"\n    rc=$?\n    if [ \"$rc\" -ne 0 ]; then\n      warn \"step $(basename \"$step\") failed (exit $rc)\"\n      return \"$rc\"\n    fi\n  done\n  log \"rollout $rel complete\"\n}\n\ncmd_show() {\n  local f\n  f=$(host_out \"$1\")\n  require_file \"$f\" \"rendered config for $1\"\n  cat \"$f\"\n}\n\n[ $# -ge 1 ] || { usage; exit 64; }\ncmd=$1; shift\ncase \"$cmd\" in\n  apply)   [ $# -eq 1 ] || { usage; exit 64; }; cmd_apply \"$1\" ;;\n  show)    [ $# -eq 1 ] || { usage; exit 64; }; cmd_show \"$1\" ;;\n  hosts)   active_hosts ;;\n  history) history_show ;;\n  -h|--help|help) usage ;;\n  *) usage; exit 64 ;;\nesac\n=== lib/cfg.sh\n# cfg.sh — wrapper around the configuration service vendor CLI.\n\n_cfgsvc() { \"$CFGSVC\" \"$@\"; }\n\n# cfg_set KEY VALUE — records VALUE and prints the change number.\ncfg_set() {\n  local out rc\n  out=$(_cfgsvc set \"$1\" \"$2\" 2>&1); rc=$?\n  [ \"$rc\" -eq 0 ] || { warn \"set $1 failed ($out, exit $rc)\"; return 1; }\n  case \"$out\" in\n    C[0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' \"$out\" ;;\n    *) warn \"unexpected answer from config service: $out\"; return 1 ;;\n  esac\n}\n\n# cfg_get KEY — prints the value. Status 1 when the key does not exist,\n# anything else from the CLI is fatal.\ncfg_get() {\n  local out rc\n  out=$(cache_get \"$1\"); rc=$?\n  [ \"$rc\" -eq 0 ] && { printf '%s' \"$out\"; return 0; }\n  [ \"$rc\" -eq 2 ] && return 1\n  out=$(_cfgsvc get \"$1\" 2>&1); rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    cache_put \"$1\" \"$out\"\n    printf '%s' \"$out\"\n    return 0\n  fi\n  if [ \"$rc\" -eq 3 ] && [ \"$out\" = \"E31\" ]; then\n    cache_put_missing \"$1\"\n    return 1\n  fi\n  die \"config service lookup of $1 failed ($out, exit $rc)\"\n}\n\n# cfg_mark — the service's current mark (recorded with every rollout).\ncfg_mark() { _cfgsvc mark; }\n\n# cfg_keys PREFIX — key<TAB>change<TAB>st\ncfg_keys() { _cfgsvc keys \"$1\"; }\n=== lib/render.sh\n# render.sh — app.conf for one host from the template.\n\n# render_host HOST POOL RELEASE — writes the file to stdout.\nrender_host() {\n  local host=$1 pool=$2 release=$3 s val script=\"\"\n  for s in $(template_settings); do\n    val=$(resolve \"$host\" \"$pool\" \"$s\") || { warn \"no value for $s on $host\"; return 1; }\n    case \"$val\" in *$'\\n'*) warn \"multi-line value for $s on $host\"; return 1 ;; esac\n    script=\"${script}s|{{$s}}|$(sed_repl_escape \"$val\")|g;\"\n  done\n  printf '# generated by rollout for %s (pool %s, release %s) — do not edit on the host\\n' \\\n    \"$host\" \"$pool\" \"$release\"\n  sed -e \"$script\" \"$TEMPLATE\"\n}\n\n# rendered_value FILE SETTING-LINE-KEY — value of \"key = value\" in a rendered file\nrendered_value() {\n  awk -v k=\"$2\" '{ i = index($0, \" = \") } i && substr($0, 1, i - 1) == k { print substr($0, i + 3); exit }' \"$1\"\n}\n=== lib/cache.sh\n# cache.sh — per-step memo of config lookups.\n# Rendering asks for the same global/pool keys once per host; the memo keeps\n# that to one CLI call per key. It lives in a fresh directory for every step\n# process and is removed when the step exits.\n\ncache_init() {\n  CACHE_DIR=$(mktemp -d \"${TMPDIR:-/tmp}/rollout-cache.XXXXXX\") || return 1\n  trap 'rm -rf \"$CACHE_DIR\"' EXIT\n}\n\n# cache_get KEY — prints the memoized answer; status 0 hit, 1 miss.\ncache_get() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 1\n  local f=\"$CACHE_DIR/$(key_file \"$1\")\"\n  [ -f \"$f\" ] || return 1\n  # a memoized \"no such key\" is an empty marker file\n  [ -s \"$f\" ] || return 2\n  cat \"$f\"\n}\n\n# cache_put KEY VALUE ; cache_put_missing KEY\ncache_put() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  printf '%s' \"$2\" > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\ncache_put_missing() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  : > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\n=== lib/common.sh\n# common.sh — logging, configuration loading and small guards shared by\n# the wrapper and every step script.\n\nlog()  { printf '[%s] %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\nwarn() { printf '[%s] warn: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\ndie()  { printf '[%s] error: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; exit \"${2:-1}\"; }\n\nload_conf() {\n  local f=\"$ROLLOUT_HOME/conf/rollout.conf\"\n  [ -r \"$f\" ] || die \"missing config $f\"\n  # shellcheck disable=SC1090\n  . \"$f\"\n}\n\nrequire_file() {\n  [ -f \"$1\" ] || die \"${2:-file} not found: $1\"\n  [ -r \"$1\" ] || die \"${2:-file} not readable: $1\"\n}\n\nensure_dir() {\n  mkdir -p \"$1\" 2>/dev/null || die \"cannot create directory $1\"\n  [ -w \"$1\" ] || die \"directory not writable: $1\"\n}\n\n# Per-release working area: $WORK_DIR/<release id>\nrun_dir() { printf '%s/%s' \"$WORK_DIR\" \"$1\"; }\n\nhost_out() { printf '%s/hosts/%s/app.conf' \"$OUT_DIR\" \"$1\"; }\n=== lib/release.sh\n# release.sh — release files: \"@release <id>\" plus \"<key> = <value>\" lines.\n\nrelease_file() { printf '%s/%s.rel' \"$RELEASE_DIR\" \"$1\"; }\n\n# release_id FILE\nrelease_id() { awk '$1 == \"@release\" { print $2; exit }' \"$1\"; }\n\n# release_changes FILE — key<TAB>value, in file order.\nrelease_changes() {\n  local line key val\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    case \"$line\" in ''|'#'*|'@'*) continue ;; esac\n    key=$(trim \"${line%%=*}\")\n    val=$(trim \"${line#*=}\")\n    printf '%s\\t%s\\n' \"$key\" \"$val\"\n  done < \"$1\"\n}\n\n# template_settings — setting names used by the template.\ntemplate_settings() {\n  grep -o '{{[a-z_]*}}' \"$TEMPLATE\" | tr -d '{}' | sort -u\n}\n\n# release_check FILE — every key must be <scope>.<...>.<setting> with a known\n# setting, pool and host.\nrelease_check() {\n  local key val setting scope mid bad=0 settings\n  settings=\" $(template_settings | tr '\\n' ' ') \"\n  while IFS=$'\\t' read -r key val; do\n    scope=${key%%.*}\n    setting=${key##*.}\n    mid=${key#*.}; mid=${mid%.*}\n    case \" $settings \" in *\" $setting \"*) ;; *) warn \"unknown setting in $key\"; bad=1; continue ;; esac\n    case \"$scope\" in\n      global) [ \"$mid\" = \"$setting\" ] || { warn \"bad global key $key\"; bad=1; } ;;\n      pool)   known_pool \"$mid\" || { warn \"unknown pool in $key\"; bad=1; } ;;\n      host)   known_host \"$mid\" || { warn \"unknown host in $key\"; bad=1; } ;;\n      *)      warn \"unknown scope in $key\"; bad=1 ;;\n    esac\n    [ -n \"$val\" ] || { warn \"empty value for $key\"; bad=1; }\n  done < <(release_changes \"$1\")\n  return \"$bad\"\n}\n=== steps/10-check.sh\n#!/usr/bin/env bash\n# Step 10 — validate the release file and stage it in the run directory.\nROLLOUT_STEP=check\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\nfile=$(release_file \"$rel\")\nrequire_file \"$file\" \"release\"\n[ \"$(release_id \"$file\")\" = \"$rel\" ] || die \"release header does not match $rel\"\nrelease_check \"$file\" || die \"release $rel has invalid lines\" 3\n\ndir=$(run_dir \"$rel\")\nrm -rf \"$dir\"\nensure_dir \"$dir\"\nrelease_changes \"$file\" > \"$dir/changes.tsv\"\nactive_hosts > \"$dir/hosts.tsv\"\nlog \"$rel: $(wc -l < \"$dir/changes.tsv\" | tr -d ' ') changes, $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n=== steps/20-apply.sh\n#!/usr/bin/env bash\n# Step 20 — write the release's changes to the configuration service.\nROLLOUT_STEP=apply\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/changes.tsv\" \"staged changes\"\n\n: > \"$dir/applied.tsv\"\nwhile IFS=$'\\t' read -r key val; do\n  [ -n \"$key\" ] || continue\n  chg=$(cfg_set \"$key\" \"$val\") || die \"could not apply $key\"\n  printf '%s\\t%s\\n' \"$key\" \"$chg\" >> \"$dir/applied.tsv\"\n  log \"$key -> $chg\"\ndone < \"$dir/changes.tsv\"\nlog \"applied $(wc -l < \"$dir/applied.tsv\" | tr -d ' ') changes\"\n=== steps/30-render.sh\n#!/usr/bin/env bash\n# Step 30 — render app.conf for every active host from the configuration service.\nROLLOUT_STEP=render\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/hosts.tsv\" \"host list\"\ncache_init || die \"cannot create lookup cache\"\n\nn=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  out=$(host_out \"$host\")\n  ensure_dir \"$(dirname \"$out\")\"\n  render_host \"$host\" \"$pool\" \"$rel\" > \"$out.tmp\" || { rm -f \"$out.tmp\"; die \"render failed for $host\"; }\n  mv -f \"$out.tmp\" \"$out\" || die \"cannot write $out\"\n  n=$((n + 1))\ndone < \"$dir/hosts.tsv\"\nlog \"rendered $n hosts\"\n=== steps/40-verify.sh\n#!/usr/bin/env bash\n# Step 40 — re-read every rendered file and compare it with the service.\nROLLOUT_STEP=verify\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\ncache_init || die \"cannot create lookup cache\"\n\nbad=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  file=$(host_out \"$host\")\n  require_file \"$file\" \"rendered config\"\n  for s in $(template_settings); do\n    line_key=$(grep -o \"^[a-z_]* = {{$s}}\" \"$TEMPLATE\" | cut -d' ' -f1)\n    want=$(resolve \"$host\" \"$pool\" \"$s\")\n    got=$(rendered_value \"$file\" \"$line_key\")\n    if [ \"$want\" != \"$got\" ]; then\n      warn \"$host: $line_key is [$got], service has [$want]\"\n      bad=1\n    fi\n  done\ndone < \"$dir/hosts.tsv\"\n[ \"$bad\" -eq 0 ] || die \"rendered files do not match the configuration service\" 4\nlog \"verified $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n=== steps/50-record.sh\n#!/usr/bin/env bash\n# Step 50 — note the rollout in the history together with the service mark.\nROLLOUT_STEP=record\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nmark=$(cfg_mark) || die \"could not read the service mark\"\nhistory_add \"$rel\" \"$mark\" \"$(wc -l < \"$dir/hosts.tsv\" | tr -d ' ')\" \"$(wc -l < \"$dir/applied.tsv\" | tr -d ' ')\"\nlog \"recorded $rel at $mark\"\n=== steps/_env.sh\n# Sourced by every step script. Expects ROLLOUT_HOME (set by bin/rollout).\n: \"${ROLLOUT_HOME:?run steps through bin/rollout}\"\nfor _lib in common text cache cfg inventory release resolve render audit; do\n  # shellcheck disable=SC1090\n  . \"$ROLLOUT_HOME/lib/$_lib.sh\"\ndone\nunset _lib\nload_conf\n=== releases/r2026.10.08.rel\n# r2026.10.08 — api pool DB tuning (OPS-2291), batch fast-pay pilot, bat-02 debug logging\n@release r2026.10.08\npool.api.db_pool_size     = 40\npool.api.timeout_ms       = 2500\npool.batch.feature_fastpay = on\nhost.bat-02.log_level     = debug\n=== conf/rollout.conf\n# rollout.conf — defaults for the app config rollout tool.\n# Every value can be overridden from the environment (ROLLOUT_*); the deploy\n# pipeline and the tests use that to point the tool at other directories.\n\nHOSTS_FILE=${ROLLOUT_HOSTS_FILE:-$ROLLOUT_HOME/conf/hosts.conf}\nTEMPLATE=${ROLLOUT_TEMPLATE:-$ROLLOUT_HOME/conf/app.conf.tpl}\nRELEASE_DIR=${ROLLOUT_RELEASE_DIR:-$ROLLOUT_HOME/releases}\nWORK_DIR=${ROLLOUT_WORK_DIR:-/var/tmp/rollout}\n# Rendered files land in $OUT_DIR/hosts/<host>/app.conf; the host agents\n# pick them up from there.\nOUT_DIR=${ROLLOUT_OUT_DIR:-/srv/rollout}\n\n# Configuration service CLI (vendor). Its state directory comes from CFGSVC_HOME.\nCFGSVC=${ROLLOUT_CFGSVC:-$ROLLOUT_HOME/vendor/bin/cfgsvc}\n\n# Key scopes, most specific first: host.<host>.<s>, pool.<pool>.<s>, global.<s>\nSCOPES=\"host pool global\"\n=== conf/hosts.conf\n# host|pool|zone|status   (status D = drained: no config is rendered for it)\napi-01|api|a|A\napi-02|api|b|A\napi-03|api|a|A\nbat-01|batch|a|A\nbat-02|batch|b|A\nweb-01|web|a|A\nweb-02|web|b|A\nweb-03|web|a|D\n=== conf/app.conf.tpl\n[database]\nurl = {{db_url}}\npool_size = {{db_pool_size}}\n\n[http]\ntimeout_ms = {{timeout_ms}}\nworker_threads = {{worker_threads}}\n\n[app]\nlog_level = {{log_level}}\nfeature_fastpay = {{feature_fastpay}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"7b5c0c0b-62a3-480e-8aff-67929d399f02","uuid":"a4c535cc-6295-4293-98c8-e247f33b221f","timestamp":"2026-10-09T12:58:59.913Z","tool_use_result":{"stdout":"=== bin/rollout\n#!/usr/bin/env bash\n# rollout — app configuration rollout for the payment hosts.\n#\n#   rollout apply RELEASE     check → apply → render → verify → record\n#   rollout show HOST         the rendered app.conf of HOST\n#   rollout hosts             active hosts and their pools\n#   rollout history           finished rollouts\n#\n# RELEASE is a file name under releases/ without .rel (e.g. r2026.10.08).\n# Configuration: conf/rollout.conf (ROLLOUT_* overrides).\nset -u\nexport LC_ALL=C.UTF-8\nROLLOUT_HOME=$(cd \"$(dirname \"$0\")/..\" && pwd)\nexport ROLLOUT_HOME\n. \"$ROLLOUT_HOME/steps/_env.sh\"\n\nusage() { sed -n '3,10p' \"$0\" | sed 's/^# \\{0,1\\}//'; }\n\ncmd_apply() {\n  local rel=$1 step rc\n  for step in \"$ROLLOUT_HOME\"/steps/[0-9][0-9]-*.sh; do\n    bash \"$step\" \"$rel\"\n    rc=$?\n    if [ \"$rc\" -ne 0 ]; then\n      warn \"step $(basename \"$step\") failed (exit $rc)\"\n      return \"$rc\"\n    fi\n  done\n  log \"rollout $rel complete\"\n}\n\ncmd_show() {\n  local f\n  f=$(host_out \"$1\")\n  require_file \"$f\" \"rendered config for $1\"\n  cat \"$f\"\n}\n\n[ $# -ge 1 ] || { usage; exit 64; }\ncmd=$1; shift\ncase \"$cmd\" in\n  apply)   [ $# -eq 1 ] || { usage; exit 64; }; cmd_apply \"$1\" ;;\n  show)    [ $# -eq 1 ] || { usage; exit 64; }; cmd_show \"$1\" ;;\n  hosts)   active_hosts ;;\n  history) history_show ;;\n  -h|--help|help) usage ;;\n  *) usage; exit 64 ;;\nesac\n=== lib/cfg.sh\n# cfg.sh — wrapper around the configuration service vendor CLI.\n\n_cfgsvc() { \"$CFGSVC\" \"$@\"; }\n\n# cfg_set KEY VALUE — records VALUE and prints the change number.\ncfg_set() {\n  local out rc\n  out=$(_cfgsvc set \"$1\" \"$2\" 2>&1); rc=$?\n  [ \"$rc\" -eq 0 ] || { warn \"set $1 failed ($out, exit $rc)\"; return 1; }\n  case \"$out\" in\n    C[0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' \"$out\" ;;\n    *) warn \"unexpected answer from config service: $out\"; return 1 ;;\n  esac\n}\n\n# cfg_get KEY — prints the value. Status 1 when the key does not exist,\n# anything else from the CLI is fatal.\ncfg_get() {\n  local out rc\n  out=$(cache_get \"$1\"); rc=$?\n  [ \"$rc\" -eq 0 ] && { printf '%s' \"$out\"; return 0; }\n  [ \"$rc\" -eq 2 ] && return 1\n  out=$(_cfgsvc get \"$1\" 2>&1); rc=$?\n  if [ \"$rc\" -eq 0 ]; then\n    cache_put \"$1\" \"$out\"\n    printf '%s' \"$out\"\n    return 0\n  fi\n  if [ \"$rc\" -eq 3 ] && [ \"$out\" = \"E31\" ]; then\n    cache_put_missing \"$1\"\n    return 1\n  fi\n  die \"config service lookup of $1 failed ($out, exit $rc)\"\n}\n\n# cfg_mark — the service's current mark (recorded with every rollout).\ncfg_mark() { _cfgsvc mark; }\n\n# cfg_keys PREFIX — key<TAB>change<TAB>st\ncfg_keys() { _cfgsvc keys \"$1\"; }\n=== lib/render.sh\n# render.sh — app.conf for one host from the template.\n\n# render_host HOST POOL RELEASE — writes the file to stdout.\nrender_host() {\n  local host=$1 pool=$2 release=$3 s val script=\"\"\n  for s in $(template_settings); do\n    val=$(resolve \"$host\" \"$pool\" \"$s\") || { warn \"no value for $s on $host\"; return 1; }\n    case \"$val\" in *$'\\n'*) warn \"multi-line value for $s on $host\"; return 1 ;; esac\n    script=\"${script}s|{{$s}}|$(sed_repl_escape \"$val\")|g;\"\n  done\n  printf '# generated by rollout for %s (pool %s, release %s) — do not edit on the host\\n' \\\n    \"$host\" \"$pool\" \"$release\"\n  sed -e \"$script\" \"$TEMPLATE\"\n}\n\n# rendered_value FILE SETTING-LINE-KEY — value of \"key = value\" in a rendered file\nrendered_value() {\n  awk -v k=\"$2\" '{ i = index($0, \" = \") } i && substr($0, 1, i - 1) == k { print substr($0, i + 3); exit }' \"$1\"\n}\n=== lib/cache.sh\n# cache.sh — per-step memo of config lookups.\n# Rendering asks for the same global/pool keys once per host; the memo keeps\n# that to one CLI call per key. It lives in a fresh directory for every step\n# process and is removed when the step exits.\n\ncache_init() {\n  CACHE_DIR=$(mktemp -d \"${TMPDIR:-/tmp}/rollout-cache.XXXXXX\") || return 1\n  trap 'rm -rf \"$CACHE_DIR\"' EXIT\n}\n\n# cache_get KEY — prints the memoized answer; status 0 hit, 1 miss.\ncache_get() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 1\n  local f=\"$CACHE_DIR/$(key_file \"$1\")\"\n  [ -f \"$f\" ] || return 1\n  # a memoized \"no such key\" is an empty marker file\n  [ -s \"$f\" ] || return 2\n  cat \"$f\"\n}\n\n# cache_put KEY VALUE ; cache_put_missing KEY\ncache_put() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  printf '%s' \"$2\" > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\ncache_put_missing() {\n  [ -n \"${CACHE_DIR:-}\" ] || return 0\n  : > \"$CACHE_DIR/$(key_file \"$1\")\"\n}\n=== lib/common.sh\n# common.sh — logging, configuration loading and small guards shared by\n# the wrapper and every step script.\n\nlog()  { printf '[%s] %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\nwarn() { printf '[%s] warn: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; }\ndie()  { printf '[%s] error: %s\\n' \"${ROLLOUT_STEP:-rollout}\" \"$*\" >&2; exit \"${2:-1}\"; }\n\nload_conf() {\n  local f=\"$ROLLOUT_HOME/conf/rollout.conf\"\n  [ -r \"$f\" ] || die \"missing config $f\"\n  # shellcheck disable=SC1090\n  . \"$f\"\n}\n\nrequire_file() {\n  [ -f \"$1\" ] || die \"${2:-file} not found: $1\"\n  [ -r \"$1\" ] || die \"${2:-file} not readable: $1\"\n}\n\nensure_dir() {\n  mkdir -p \"$1\" 2>/dev/null || die \"cannot create directory $1\"\n  [ -w \"$1\" ] || die \"directory not writable: $1\"\n}\n\n# Per-release working area: $WORK_DIR/<release id>\nrun_dir() { printf '%s/%s' \"$WORK_DIR\" \"$1\"; }\n\nhost_out() { printf '%s/hosts/%s/app.conf' \"$OUT_DIR\" \"$1\"; }\n=== lib/release.sh\n# release.sh — release files: \"@release <id>\" plus \"<key> = <value>\" lines.\n\nrelease_file() { printf '%s/%s.rel' \"$RELEASE_DIR\" \"$1\"; }\n\n# release_id FILE\nrelease_id() { awk '$1 == \"@release\" { print $2; exit }' \"$1\"; }\n\n# release_changes FILE — key<TAB>value, in file order.\nrelease_changes() {\n  local line key val\n  while IFS= read -r line || [ -n \"$line\" ]; do\n    case \"$line\" in ''|'#'*|'@'*) continue ;; esac\n    key=$(trim \"${line%%=*}\")\n    val=$(trim \"${line#*=}\")\n    printf '%s\\t%s\\n' \"$key\" \"$val\"\n  done < \"$1\"\n}\n\n# template_settings — setting names used by the template.\ntemplate_settings() {\n  grep -o '{{[a-z_]*}}' \"$TEMPLATE\" | tr -d '{}' | sort -u\n}\n\n# release_check FILE — every key must be <scope>.<...>.<setting> with a known\n# setting, pool and host.\nrelease_check() {\n  local key val setting scope mid bad=0 settings\n  settings=\" $(template_settings | tr '\\n' ' ') \"\n  while IFS=$'\\t' read -r key val; do\n    scope=${key%%.*}\n    setting=${key##*.}\n    mid=${key#*.}; mid=${mid%.*}\n    case \" $settings \" in *\" $setting \"*) ;; *) warn \"unknown setting in $key\"; bad=1; continue ;; esac\n    case \"$scope\" in\n      global) [ \"$mid\" = \"$setting\" ] || { warn \"bad global key $key\"; bad=1; } ;;\n      pool)   known_pool \"$mid\" || { warn \"unknown pool in $key\"; bad=1; } ;;\n      host)   known_host \"$mid\" || { warn \"unknown host in $key\"; bad=1; } ;;\n      *)      warn \"unknown scope in $key\"; bad=1 ;;\n    esac\n    [ -n \"$val\" ] || { warn \"empty value for $key\"; bad=1; }\n  done < <(release_changes \"$1\")\n  return \"$bad\"\n}\n=== steps/10-check.sh\n#!/usr/bin/env bash\n# Step 10 — validate the release file and stage it in the run directory.\nROLLOUT_STEP=check\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\nfile=$(release_file \"$rel\")\nrequire_file \"$file\" \"release\"\n[ \"$(release_id \"$file\")\" = \"$rel\" ] || die \"release header does not match $rel\"\nrelease_check \"$file\" || die \"release $rel has invalid lines\" 3\n\ndir=$(run_dir \"$rel\")\nrm -rf \"$dir\"\nensure_dir \"$dir\"\nrelease_changes \"$file\" > \"$dir/changes.tsv\"\nactive_hosts > \"$dir/hosts.tsv\"\nlog \"$rel: $(wc -l < \"$dir/changes.tsv\" | tr -d ' ') changes, $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n=== steps/20-apply.sh\n#!/usr/bin/env bash\n# Step 20 — write the release's changes to the configuration service.\nROLLOUT_STEP=apply\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/changes.tsv\" \"staged changes\"\n\n: > \"$dir/applied.tsv\"\nwhile IFS=$'\\t' read -r key val; do\n  [ -n \"$key\" ] || continue\n  chg=$(cfg_set \"$key\" \"$val\") || die \"could not apply $key\"\n  printf '%s\\t%s\\n' \"$key\" \"$chg\" >> \"$dir/applied.tsv\"\n  log \"$key -> $chg\"\ndone < \"$dir/changes.tsv\"\nlog \"applied $(wc -l < \"$dir/applied.tsv\" | tr -d ' ') changes\"\n=== steps/30-render.sh\n#!/usr/bin/env bash\n# Step 30 — render app.conf for every active host from the configuration service.\nROLLOUT_STEP=render\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nrequire_file \"$dir/hosts.tsv\" \"host list\"\ncache_init || die \"cannot create lookup cache\"\n\nn=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  out=$(host_out \"$host\")\n  ensure_dir \"$(dirname \"$out\")\"\n  render_host \"$host\" \"$pool\" \"$rel\" > \"$out.tmp\" || { rm -f \"$out.tmp\"; die \"render failed for $host\"; }\n  mv -f \"$out.tmp\" \"$out\" || die \"cannot write $out\"\n  n=$((n + 1))\ndone < \"$dir/hosts.tsv\"\nlog \"rendered $n hosts\"\n=== steps/40-verify.sh\n#!/usr/bin/env bash\n# Step 40 — re-read every rendered file and compare it with the service.\nROLLOUT_STEP=verify\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\ncache_init || die \"cannot create lookup cache\"\n\nbad=0\nwhile IFS=$'\\t' read -r host pool; do\n  [ -n \"$host\" ] || continue\n  file=$(host_out \"$host\")\n  require_file \"$file\" \"rendered config\"\n  for s in $(template_settings); do\n    line_key=$(grep -o \"^[a-z_]* = {{$s}}\" \"$TEMPLATE\" | cut -d' ' -f1)\n    want=$(resolve \"$host\" \"$pool\" \"$s\")\n    got=$(rendered_value \"$file\" \"$line_key\")\n    if [ \"$want\" != \"$got\" ]; then\n      warn \"$host: $line_key is [$got], service has [$want]\"\n      bad=1\n    fi\n  done\ndone < \"$dir/hosts.tsv\"\n[ \"$bad\" -eq 0 ] || die \"rendered files do not match the configuration service\" 4\nlog \"verified $(wc -l < \"$dir/hosts.tsv\" | tr -d ' ') hosts\"\n=== steps/50-record.sh\n#!/usr/bin/env bash\n# Step 50 — note the rollout in the history together with the service mark.\nROLLOUT_STEP=record\n. \"$(dirname \"$0\")/_env.sh\"\n\nrel=${1:?release id}\ndir=$(run_dir \"$rel\")\nmark=$(cfg_mark) || die \"could not read the service mark\"\nhistory_add \"$rel\" \"$mark\" \"$(wc -l < \"$dir/hosts.tsv\" | tr -d ' ')\" \"$(wc -l < \"$dir/applied.tsv\" | tr -d ' ')\"\nlog \"recorded $rel at $mark\"\n=== steps/_env.sh\n# Sourced by every step script. Expects ROLLOUT_HOME (set by bin/rollout).\n: \"${ROLLOUT_HOME:?run steps through bin/rollout}\"\nfor _lib in common text cache cfg inventory release resolve render audit; do\n  # shellcheck disable=SC1090\n  . \"$ROLLOUT_HOME/lib/$_li