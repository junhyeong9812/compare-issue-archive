0\u0000\u0000\u0000\u0000\u0010@\u0000\u0000\u0000\u0000\u0000\u0000-\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000=@\u0000\u0000\u0000\u0000\u0000\u0000\n\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000===\n#!/usr/bin/env bash\n# Runs every tests/test_*.sh and reports which files failed.\ncd \"$(dirname \"$0\")\" || exit 2\nfailed=()\nfor t in test_*.sh; do\n  echo \"== $t\"\n  bash \"$t\"\n  rc=$?\n  [ \"$rc\" -eq 0 ] || failed+=(\"$t (exit $rc)\")\ndone\necho\nif [ ${#failed[@]} -eq 0 ]; then\n  echo \"all test files passed\"\n  exit 0\nfi\nprintf 'failed: %s\\n' \"${failed[@]}\"\nexit 1\n# Test helpers. Each test file sources this, calls t_setup, then asserts.\nT_HOME=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\nT_FAIL=0\nT_PASS=0\n\nt_setup() {\n  T_WORK=$(mktemp -d)\n  trap 't_cleanup' EXIT\n  export ROLLOUT_WORK_DIR=\"$T_WORK/work\"\n  export ROLLOUT_OUT_DIR=\"$T_WORK/out\"\n  export ROLLOUT_HOSTS_FILE=\"$T_HOME/conf/hosts.conf\"\n  export ROLLOUT_RELEASE_DIR=\"$T_HOME/releases\"\n  export CFGSVC_HOME=\"$T_WORK/cfgsvc\"\n  mkdir -p \"$CFGSVC_HOME\"\n}\n\nt_cleanup() { [ -n \"${T_WORK:-}\" ] && rm -rf \"$T_WORK\"; }\n\n# Loads the libraries into the test shell (for unit tests).\nt_source_libs() {\n  export LC_ALL=C.UTF-8\n  export ROLLOUT_HOME=\"$T_HOME\"\n  . \"$T_HOME/steps/_env.sh\"\n}\n\nrollout() { \"$T_HOME/bin/rollout\" \"$@\"; }\n\nok()   { T_PASS=$((T_PASS + 1)); printf 'ok   - %s\\n' \"$1\"; }\nfail() { T_FAIL=$((T_FAIL + 1)); printf 'FAIL - %s\\n' \"$1\"; [ -n \"${2:-}\" ] && printf '       %s\\n' \"$2\"; return 0; }\n\nassert_eq() {\n  if [ \"$2\" = \"$3\" ]; then ok \"$1\"; else fail \"$1\" \"expected [$3] got [$2]\"; fi\n}\n\nassert_contains() {\n  if printf '%s' \"$2\" | grep -qF -- \"$3\"; then ok \"$1\"; else fail \"$1\" \"missing [$3]\"; fi\n}\n\nassert_rc() {\n  if [ \"$2\" -eq \"$3\" ]; then ok \"$1\"; else fail \"$1\" \"expected exit $3 got $2\"; fi\n}\n\nt_done() {\n  printf '# %s: %d passed, %d failed\\n' \"$(basename \"$0\")\" \"$T_PASS\" \"$T_FAIL\"\n  [ \"$T_FAIL\" -eq 0 ]\n}\n===\n# rollout — 결제 서버 앱 설정 배포\n\n릴리스 파일(`releases/<id>.rel`)의 설정 변경을 사내 설정 서비스에 기록하고, 서비스에 있는 값으로\n서버별 `app.conf`를 만들어 배포 디렉터리에 둔다(각 서버의 에이전트가 가져간다).\n설정 서비스는 벤더 CLI `vendor/bin/cfgsvc`(벤더가 바이너리로 제공)로 다룬다. 사용법은 `vendor/bin/cfgsvc --help`.\n\n## 실행\n\n```\nbin/rollout apply r2026.10.08   # check → apply → render → verify → record\nbin/rollout show api-02         # 서버에 배포된 app.conf\nbin/rollout hosts               # 활성 서버와 풀\nbin/rollout history             # 끝난 배포 이력(릴리스, 서비스 마크, 서버 수, 변경 수)\n```\n\n배포 파이프라인은 릴리스 승인 후 `bin/rollout apply <id>`를 돌리고, exit 0이 아니면 배포를 멈춘다.\n`CFGSVC_HOME`(설정 서비스 상태 디렉터리)은 파이프라인 환경에서 지정한다.\n\n## 구성\n\n| 경로 | 내용 |\n|------|------|\n| `bin/rollout` | 진입점. 서브커맨드 분기, 단계 순차 실행 |\n| `steps/NN-*.sh` | 단계 스크립트(번호 순). 각자 `_env.sh`로 lib·설정을 읽는다 |\n| `lib/` | 공용 함수 (설정 서비스 래퍼, 조회 캐시, 범위 해석, 템플릿 렌더, 릴리스 파일, 이력 등) |\n| `conf/rollout.conf` | 디렉터리·도구 경로. `ROLLOUT_*` 환경변수로 덮어쓴다 |\n| `conf/hosts.conf` | 서버 목록(상태 D는 빠진 서버 — 설정을 만들지 않음) |\n| `conf/app.conf.tpl` | 서버 설정 템플릿(`{{setting}}`) |\n| `releases/` | 릴리스 파일 |\n| `tests/` | `bash tests/run.sh` — 단위 테스트 + 릴리스 두 개 E2E |\n\n## 설정 키\n\n- 키는 `global.<setting>`, `pool.<풀>.<setting>`, `host.<서버>.<setting>` 세 범위다. 서버마다 가장 좁은 범위의 값이 이긴다(host → pool → global).\n- 릴리스 파일은 `@release <id>` 한 줄과 `<키> = <값>` 줄들로 이뤄진다. 바뀌는 키만 적는다.\n- 운영자가 장애 대응으로 서비스에 직접 넣은 값도 다음 배포 때 그대로 서버 설정에 반영된다(서비스가 기준이다).","is_error":false}]},"parent_tool_use_id":null,"session_id":"7b5c0c0b-62a3-480e-8aff-67929d399f02","uuid":"a1e6a53b-7687-4def-9405-71af23e845a0","timestamp":"2