00\u00000\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0000\u0000\u0000\b\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000 @\u0000\u0000\u0000\u0000\u0000\u0000\u00100\u0000\u0000\u0000\u0000\u0000\u0000@\u0004\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000 \u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0001\u0000\u0000\u0001\u0000\u0000\u00000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u00100\u0000\u0000\u0000\u0000\u0000\u0000-\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000=0\u0000\u0000\u0000\u0000\u0000\u0000\n\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000----\nusage: ptsctl <command> [options]\n\ncommands:\n  earn  --mbr MBR --pt N --ref REF\n        prints the entry number\n  bal   MBR\n  hist  MBR\n        entry, ref, points (tab separated)\n\n  MBR   member number; @MBR is also accepted\n  REF   [A-Za-z0-9-], 1..32 chars, once per ledger\n\n  --version   prints the version\n\nenvironment:\n  PTSCTL_HOME   ledger directory (required)\nptsctl 4.2.0\n----\npackage infra;\n\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.TimeUnit;\n\n/** Thin wrapper around the points vendor CLI (vendor/bin/ptsctl). One process per call. */\npublic class PtsctlClient {\n    /** One line of the vendor history: entry number, our reference, points. */\n    public record HistoryRow(String entryNo, String ref, long points) {}\n\n    private final Path bin;\n    private final Path home;\n    private final long timeoutSeconds;\n\n    public PtsctlClient(Path bin, Path home, long timeoutSeconds) {\n        this.bin = bin;\n        this.home = home;\n        this.timeoutSeconds = timeoutSeconds;\n    }\n\n    /** Credits points to a member; returns the vendor entry number. */\n    public String earn(String memberNo, long points, String ref) {\n        return run(List.of(\"earn\", \"--mbr\", memberNo, \"--pt\", Long.toString(points), \"--ref\", ref)).strip();\n    }\n\n    public long balance(String memberNo) {\n        String out = run(List.of(\"bal\", memberNo)).strip();\n        String[] t = out.split(\"\\\\s+\");\n        if (t.length != 2) throw new PtsException(\"unexpected bal reply: \" + out);\n        return Long.parseLong(t[1]);\n    }\n\n    public List<HistoryRow> history(String memberNo) {\n        List<HistoryRow> rows = new ArrayList<>();\n        for (String line : run(List.of(\"hist\", memberNo)).split(\"\\n\")) {\n            if (line.isBlank()) continue;\n            String[] f = line.split(\"\\t\");\n            if (f.length != 3) throw new PtsException(\"unexpected hist line: \" + line);\n            rows.add(new HistoryRow(f[0], f[1], Long.parseLong(f[2])));\n        }\n        return rows;\n    }\n\n    private String run(List<String> args) {\n        List<String> cmd = new ArrayList<>();\n        cmd.add(bin.toString());\n        cmd.addAll(args);\n        try {\n            Files.createDirectories(home);\n            ProcessBuilder pb = new ProcessBuilder(cmd);\n            pb.environment().put(\"PTSCTL_HOME\", home.toAbsolutePath().toString());\n            Process p = pb.start();\n            byte[] out;\n            byte[] err;\n            try (InputStream o = p.getInputStream(); InputStream e = p.getErrorStream()) {\n                out = o.readAllBytes();\n                err = e.readAllBytes();\n            }\n            if (!p.waitFor(timeoutSeconds, TimeUnit.SECONDS)) {\n                p.destroyForcibly();\n                throw new PtsException(\"timeout: \" + String.join(\" \", cmd));\n            }\n            if (p.exitValue() != 0) {\n                throw new PtsException(\"ptsctl failed [\" + new String(err, StandardCharsets.UTF_8).strip() + \"]: \"\n                        + String.join(\" \", cmd));\n            }\n            return new String(out, StandardCharsets.UTF_8);\n        } catch (IOException e) {\n            throw new PtsException(\"exec failed: \" + e.getMessage());\n        } catch (InterruptedException e) {\n            Thread.currentThread().interrupt();\n            throw new PtsException(\"interrupted\");\n        }\n    }\n\n    public static class PtsException extends RuntimeException {\n        public PtsException(String msg) {\n            super(msg);\n        }\n    }\n}\npackage service;\n\nimport domain.EarnEntry;\nimport domain.Member;\nimport domain.Payment;\nimport domain.RunResult;\nimport infra.PtsctlClient;\nimport store.EarnLedger;\n\nimport java.time.LocalDate;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Optional;\n\n/**\n * Daily earn run: every approved payment of a known member earns grade-rate\n * points at the points vendor once. The vendor reference is prefix + payment id,\n * so a re-run never earns twice.\n */\npublic class EarnBatchJob {\n    private final MemberDirectory members;\n    private final EarnPolicy policy;\n    private final EarnLedger ledger;\n    private final PtsctlClient pts;\n    private final String refPrefix;\n\n    public EarnBatchJob(MemberDirectory members, EarnPolicy policy, EarnLedger ledger, PtsctlClient pts,\n                        String refPrefix) {\n        this.members = members;\n        this.policy = policy;\n        this.ledger = ledger;\n        this.pts = pts;\n        this.refPrefix = refPrefix;\n    }\n\n    public RunResult run(LocalDate day, List<Payment> payments) {\n        int earned = 0;\n        int skipped = 0;\n        long total = 0;\n        List<String> unknown = new ArrayList<>();\n        for (Payment p : PaymentDeduper.unique(payments)) {\n            if (!p.approved() || ledger.contains(p.payId())) {\n                skipped++;\n                continue;\n            }\n            Optional<Member> m = members.find(p.memberNo());\n            if (m.isEmpty()) {\n                unknown.add(p.memberNo());\n                continue;\n            }\n            long pts = policy.points(p.amount(), m.get().grade());\n            if (pts == 0) {\n                skipped++;\n                continue;\n            }\n            String entryNo = this.pts.earn(m.get().memberNo(), pts, refPrefix + \"-\" + p.payId());\n            ledger.record(new EarnEntry(p.payId(), m.get().memberNo(), pts, day, entryNo));\n            earned++;\n            total += pts;\n        }\n        return new RunResult(earned, total, List.copyOf(unknown), skipped);\n    }\n}\npackage service;\n\nimport domain.Member;\n\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\n\n/** Member lookup. Keys are the member number exactly as issued (text, not a number). */\npublic class MemberDirectory {\n    private final Map<String, Member> members = new LinkedHashMap<>();\n\n    public MemberDirectory(List<Member> list) {\n        for (Member m : list) {\n            String key = key(m.memberNo());\n            if (members.putIfAbsent(key, m) != null) {\n                throw new IllegalStateException(\"member number issued twice: \" + m.memberNo());\n            }\n        }\n    }\n\n    public Optional<Member> find(String memberNo) {\n        return Optional.ofNullable(members.get(key(memberNo)));\n    }\n\n    public List<Member> all() {\n        return List.copyOf(members.values());\n    }\n\n    /** Corporate codes are case-insensitive on the acquirer side (\"c7781\" == \"C7781\"). */\n    static String key(String memberNo) {\n        return memberNo.strip().toUpperCase();\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Dx5ggBwDNArZY6a4wm8MZy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
